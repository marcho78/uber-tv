{
  "id": "premium",
  "name": "Premium",
  "description": "Quiet, like a high-end streaming remote: dark glass and a round d-pad.",
  "colors": { "bg": "#24262e", "bgTo": "#0a0a0d", "card": "#11ffffff", "cardEdge": "#1affffff", "key": "#12ffffff", "keyText": "#c9ccd6", "keyEdge": "#1affffff",
              "accent": "#e6cfa0", "accentText": "#1a1408", "text": "#f3f4f7", "textDim": "#8c91a1", "alert": "#ff6b5e" },
  "header": "none",
  "face": "icon",
  "pad": "off",
  "layout": {
    "portrait": [
      { "row": ["power", "mute", "window", "options"], "height": 7.4 },
      { "row": ["now"], "height": 25 },
      { "row": [{ "control": "dpad", "variant": "ring" }], "height": 34, "grow": true },
      { "row": [{ "control": "pad", "scale": 0.94 }], "height": 30, "pad": "on" },
      { "row": ["back", "guide", "home"], "height": 6.9 },
      { "row": ["rewind", "playpause", "forward", "live"], "height": 6.9 },
      { "row": [{ "control": "rocker", "variant": "split", "weight": 2.1 }, "padToggle"], "height": 6.9 }
    ],
    "landscape": { "left": ["now", "power", "mute", "window", "options", "dpad"] }
  },
  "now": { "show": ["channel", "title", "times", "progress", "dvr"], "side": "logo" },
  "elements": {
    "page": { "fill": { "from": "bg", "to": "bgTo", "direction": "down" } },
    "settingsButton": { "text": { "color": "textDim" } },
    "card": { "fill": "card", "border": { "width": 0.27, "color": "cardEdge" }, "radius": 8.2, "padding": 5.5, "shadow": { "color": "#bf000000", "blur": 10, "x": 0, "y": 5 } },
    "nowLogo": { "fill": "cardEdge", "border": "none", "radius": 6, "size": 23, "text": { "color": "text", "size": 5, "weight": "bold" } },
    "nowChannel": { "text": { "color": "textDim", "size": 3, "weight": "semibold", "letterSpacing": 0.2, "case": "upper" } },
    "nowTitle": { "text": { "color": "text", "size": 6.3, "weight": "semibold", "letterSpacing": -0.02 } },
    "nowTimes": { "text": { "color": "textDim", "size": 3.6 } },
    "nowDvr": { "text": { "color": "alert", "size": 3.3, "weight": "medium" } },
    "bar": { "fill": "accent", "track": "#1fffffff", "knob": "#ffffff", "height": 0.8, "radius": 0.5 },
    "barLabel": { "text": { "color": "textDim", "size": 3.3, "weight": "medium" } },
    "key": { "fill": "key", "border": { "width": 0.27, "color": "keyEdge" }, "shape": "pill", "shadow": { "color": "#b3000000", "blur": 6.5, "x": 0, "y": 2.7 },
             "text": { "color": "keyText", "size": 3.4, "weight": "medium", "letterSpacing": 0.12 }, "icon": 5.8 },
    "key:pressed": { "fill": "#24ffffff" },
    "key:on": { "fill": "#33e6cfa0", "text": { "color": "accent" } },
    "power": { "fill": "key", "shape": "circle", "text": { "color": "alert" } },
    "mute": { "shape": "circle" },
    "window": { "shape": "circle" },
    "options": { "shape": "circle" },
    "live": { "text": { "color": "accent", "size": 3.3, "weight": "semibold", "letterSpacing": 0.16 } },
    "dpad": { "fill": "#0effffff", "border": { "width": 0.27, "color": "keyEdge" }, "shadow": { "color": "#d9000000", "blur": 16, "x": 0, "y": 9 } },
    "arrow": { "text": { "color": "#6f7484" }, "icon": 5 },
    "ok": { "fill": "#17ffffff", "border": { "width": 0.27, "color": "#24ffffff" }, "text": { "color": "text", "size": 4.4, "weight": "medium", "letterSpacing": 0.12 },
            "shadow": { "color": "#cc000000", "blur": 6.5, "x": 0, "y": 2.7 } },
    "rocker": { "fill": "key", "border": { "width": 0.27, "color": "keyEdge" }, "shape": "pill", "text": { "color": "keyText", "size": 3.4, "weight": "medium", "letterSpacing": 0.12 } },
    "digit": { "shape": "circle", "text": { "color": "text", "size": 7.5, "weight": "light" } },
    "go": { "fill": "accent", "shape": "circle", "text": { "color": "accentText", "size": 4.4, "weight": "semibold" } },
    "erase": { "fill": "none", "border": "none", "shadow": "none", "shape": "circle", "text": { "color": "textDim" } },
    "typed": { "fill": "#f21a1b21", "border": { "width": 0.27, "color": "cardEdge" }, "radius": 8.2, "text": { "color": "accent", "size": 8, "weight": "light", "letterSpacing": 0.3 } },
    "sheet": { "fill": "#f2141519", "border": { "width": 0.27, "color": "keyEdge", "sides": ["top"] }, "radius": [7, 7, 0, 0], "padding": 4.4 }
  }
}
