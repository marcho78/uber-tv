{
  "id": "techie",
  "name": "Techie",
  "description": "A HUD: monospace type, neon lines on cut corners, a status strip and a key grid.",
  "colors": { "bg": "#08171a", "bgTo": "#020506", "card": "#071413", "cardEdge": "#1f5f58", "key": "#071413", "keyText": "#dcfff6", "keyEdge": "#1f5f58",
              "accent": "#46f7d4", "accentText": "#021412", "text": "#dcfff6", "textDim": "#6fae9f", "alert": "#ff3d7f" },
  "fonts": { "body": "dm-mono", "display": "orbitron", "mono": "dm-mono" },
  "header": "none",
  "face": "label",
  "pad": "off",
  "layout": {
    "portrait": [
      { "row": ["status"], "height": 4.6 },
      { "row": ["now"], "height": 24 },
      { "row": ["power", "mute", "window", "options"], "height": 7.4 },
      { "row": [{ "control": "dpad", "variant": "cross", "arrows": "chevron" }], "height": 27, "grow": true },
      { "row": [{ "control": "pad" }], "height": 28, "pad": "on" },
      { "row": ["rewind", "playpause", "forward", "live"], "height": 7.4 },
      { "row": ["back", "guide", "chup", "chdown"], "height": 7.4 },
      { "row": ["home", "padToggle", "gap", "gap"], "height": 7.4 }
    ],
    "landscape": { "left": ["status", "now", "power", "mute", "window", "options", "dpad"] }
  },
  "now": { "show": ["channel", "title", "times", "progress"], "side": "none" },
  "elements": {
    "page": { "fill": { "from": "bg", "to": "bgTo", "direction": "down" } },
    "settingsButton": { "text": { "color": "accent" } },
    "statusItem": { "shape": "chamfer", "radius": 1.9, "fill": "card", "border": { "width": 0.27, "color": "cardEdge" }, "padding": 0.8,
                    "text": { "color": "accent", "font": "mono", "size": 3.1, "weight": "medium", "letterSpacing": 0.1, "case": "upper" } },
    "statusItem:alert": { "border": { "width": 0.27, "color": "alert" }, "text": { "color": "alert" } },
    "card": { "shape": "chamfer", "radius": 4.4, "fill": "card", "border": { "width": 0.27, "color": "accent" }, "padding": 4.6, "shadow": { "color": "#3846f7d4", "blur": 4, "x": 0, "y": 0 } },
    "nowChannel": { "text": { "color": "textDim", "font": "mono", "size": 3.1, "weight": "medium", "letterSpacing": 0.12, "case": "upper" } },
    "nowTitle": { "text": { "color": "#f0fffb", "font": "display", "size": 5.6, "weight": "bold", "letterSpacing": 0.05, "case": "upper" } },
    "nowTimes": { "text": { "color": "#2cc0a3", "font": "mono", "size": 3.4, "letterSpacing": 0.04 } },
    "bar": { "fill": { "from": "#4046f7d4", "to": "accent", "direction": "right" }, "track": "#12332f", "knob": "#ffffff", "height": 1.1, "radius": 0,
             "shadow": { "color": "#ccffffff", "blur": 2, "x": 0, "y": 0 } },
    "barLabel": { "text": { "color": "accent", "font": "mono", "size": 2.9, "weight": "medium", "letterSpacing": 0.12, "case": "upper" } },
    "key": { "shape": "chamfer", "radius": 2.7, "fill": "key", "border": { "width": 0.27, "color": "keyEdge" },
             "text": { "color": "text", "font": "mono", "size": 3.6, "weight": "medium", "letterSpacing": 0.12 }, "icon": 5.2 },
    "key:pressed": { "border": { "width": 0.27, "color": "accent" }, "text": { "color": "accent" } },
    "key:on": { "border": { "width": 0.27, "color": "accent" }, "text": { "color": "accent" } },
    "power": { "fill": "key", "border": { "width": 0.27, "color": "alert" }, "text": { "color": "alert" } },
    "ok": { "shape": "chamfer", "fill": "accent", "border": { "width": 0.27, "color": "accent" }, "text": { "color": "accentText", "weight": "medium" },
            "shadow": { "color": "#8c46f7d4", "blur": 3.3, "x": 0, "y": 0 } },
    "live": { "border": { "width": 0.27, "color": "accent" }, "text": { "color": "accent" } },
    "arrow": { "icon": 6 },
    "digit": { "text": { "size": 5.5 } },
    "go": { "fill": "accent", "border": { "width": 0.27, "color": "accent" }, "text": { "color": "accentText" } },
    "typed": { "shape": "chamfer", "radius": 3, "fill": "card", "border": { "width": 0.27, "color": "accent" }, "text": { "color": "accent", "font": "display", "size": 8, "letterSpacing": 0.3 } },
    "band": { "border": { "width": 0.27, "color": "cardEdge", "sides": ["bottom"] }, "padding": 1.6, "text": { "color": "accent", "font": "mono", "size": 3, "letterSpacing": 0.14, "case": "upper" } },
    "listNumber": { "text": { "color": "accent", "font": "mono", "size": 3.6 } },
    "listName": { "text": { "color": "text", "font": "mono", "size": 3.4 } },
    "listTitle": { "text": { "color": "textDim", "font": "mono", "size": 3 } },
    "sheet": { "fill": "bgTo", "border": { "width": 0.27, "color": "accent", "sides": ["top"] }, "radius": 0, "padding": 4.4 }
  }
}
