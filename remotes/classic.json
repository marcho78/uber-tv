{
  "id": "classic",
  "name": "Classic",
  "description": "Today's remote: d-pad, number pad and channel buttons, with play controls added.",
  "fonts": { "body": "dm-mono", "display": "dm-mono", "mono": "dm-mono" },
  "header": "title",
  "face": "label",
  "pad": "on",
  "layout": {
    "portrait": [
      { "row": ["now"], "height": 11 },
      { "row": ["tabs"], "height": 4.5 },
      { "row": ["power", "mute", { "control": "options", "weight": 0.7 }], "height": 7 },
      { "row": [{ "control": "dpad", "variant": "cross", "arrows": "triangle" }], "height": 21 },
      { "row": ["back", "guide", "window", "padToggle"], "height": 6 },
      { "row": ["rewind", "playpause", "forward", "live"], "height": 6 },
      { "row": [{ "control": "pad", "weight": 3 }, { "control": "rocker", "variant": "vertical", "weight": 1.15 }], "height": 32, "pad": "on", "grow": true },
      { "row": [{ "control": "rocker", "variant": "row" }], "height": 9, "pad": "off" },
      { "row": ["gap"], "height": 4, "pad": "off", "grow": true }
    ],
    "landscape": { "left": ["now", "tabs", "power", "mute", "options", "dpad"] }
  },
  "now": { "show": ["channel", "mode", "title", "times", "dvr"], "side": "logo", "align": "left", "prefix": true },
  "elements": {
    "header": { "text": { "color": "accent", "font": "display", "size": 3.8, "weight": "bold", "case": "upper", "letterSpacing": 0.12 } },
    "card": { "fill": "#40000000", "border": { "width": 0.27, "color": "cardEdge" }, "radius": 1.6, "padding": 2.6 },
    "nowLogo": { "fill": "bgTo", "border": { "width": 0.27, "color": "cardEdge" }, "radius": 0, "size": 11, "text": { "color": "accent", "size": 3.2, "weight": "bold" } },
    "nowChannel": { "text": { "color": "accent", "size": 3.6, "weight": "bold" } },
    "nowMode": { "text": { "color": "accent", "size": 3, "weight": "normal", "case": "upper" } },
    "nowTitle": { "text": { "color": "text", "size": 3.9, "weight": "bold" } },
    "nowTimes": { "text": { "color": "textDim", "size": 3 } },
    "nowDvr": { "text": { "color": "alert", "size": 3, "weight": "bold" } },
    "tabs": { "border": { "width": 0.27, "color": "cardEdge" }, "radius": 1.6 },
    "tab": { "text": { "color": "textDim", "size": 3.3, "weight": "bold", "case": "upper", "letterSpacing": 0.1 } },
    "tab:on": { "fill": "accent", "text": { "color": "keyText" } },
    "key": { "fill": "key", "border": { "width": 0.27, "color": "#ffffff" }, "radius": 2.2, "shadow": { "color": "keyEdge", "blur": 0, "x": 0, "y": 0.8 },
             "text": { "color": "keyText", "font": "body", "size": 4.1, "weight": "bold" }, "icon": 6.4 },
    "key:pressed": { "shadow": { "color": "keyEdge", "blur": 0, "x": 0, "y": 0.27 }, "opacity": 0.85 },
    "key:on": { "fill": "accent", "border": { "width": 0.27, "color": "#fff3b8" } },
    "power": { "fill": "alert", "border": { "width": 0.27, "color": "#ff9a9a" }, "shadow": { "color": "#8a1f1f", "blur": 0, "x": 0, "y": 0.8 }, "text": { "color": "#ffffff" } },
    "ok": { "fill": "accent", "shape": "pill", "border": { "width": 0.27, "color": "#fff3b8" }, "text": { "size": 4.6 } },
    "go": { "fill": "accent", "border": { "width": 0.27, "color": "#fff3b8" }, "text": { "size": 4.9 } },
    "arrow": { "text": { "size": 5.4 } },
    "back": { "text": { "size": 3.3 } },
    "guide": { "text": { "size": 3.3 } },
    "padToggle": { "text": { "size": 3.3 } },
    "live": { "text": { "size": 3.3 } },
    "digit": { "text": { "size": 4.9 } },
    "chup": { "text": { "size": 4.4 } },
    "chdown": { "text": { "size": 4.4 } },
    "rockerLabel": { "text": { "color": "textDim", "size": 2.7, "weight": "normal", "case": "upper" } },
    "bar": { "fill": "accent", "track": "cardEdge", "knob": "text", "height": 0.8, "radius": 0.4 },
    "typed": { "fill": "#f0030a2b", "border": { "width": 0.27, "color": "cardEdge" }, "radius": 1.6, "text": { "color": "accent", "font": "body", "size": 7, "weight": "bold", "letterSpacing": 0.3 } },
    "sheet": { "fill": "bg", "border": { "width": 0.27, "color": "accent", "sides": ["top"] }, "radius": [4, 4, 0, 0], "padding": 4.4 }
  }
}
