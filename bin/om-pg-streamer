#!/usr/bin/python3
"""Serves YouTube videos to the guide's player as HLS playlists Qt can play.

GET /play/<video id>.m3u8 returns a master playlist with one video variant
(the best H.264 up to 1080p) and the original audio track, pointing at
YouTube's own media playlists. ?h=720, 480 or 360 asks for a smaller one (a
Multiview tile): the best H.264 up to that height, or the smallest there is.
YouTube's full master is cached per video and trimmed for each request, so
one quality never stands in for another. YouTube's full master lists every variant,
dubbed audio and a subtitle track FFmpeg rejects, which leaves it without a
duration and so unseekable; this one is seekable, so the guide can join a
video partway through. It is served over HTTP because FFmpeg won't follow a
local playlist file out to https.

GET /logo/<channel id>.jpg?src=<avatar url> returns the channel's logo from
a disk cache, downloading it first if it isn't there or is a month old.
Downloads are throttled (two at a time, spaced out), only from YouTube's
image servers, and a failed one isn't tried again for six hours.

GET /picon?src=<logo url> does the same for an IPTV channel's logo, from
wherever its playlist says (http or https only, images only, 512 KB at most,
redirects only to http or https).

Listens on 127.0.0.1 only, on a free port. Every path starts with a secret
made at startup, so web pages and other programs can't use it; the first
line it prints is "<port> <secret>".

It is also the guide's media player on the session bus (MPRIS), so media
keys and the bar's media widget work: the guide writes what's on to its
stdin as {"mpris": {...}} lines, and it prints {"mpris": "<command>"} lines
when something asks to play, pause, change channel or stop, and, for a
video on demand, {"mpris": "seek", "by": <µs>} and {"mpris": "setPosition",
"to": <µs>}. It only holds
the bus name while the TV is on, so media keys go to other players when it
isn't.
"""

import hashlib
import hmac
import http.server
import json
import os
import pathlib
import re
import secrets
import sys
import threading
import time
import urllib.parse
import urllib.request

import yt_dlp

sys.dont_write_bytecode = True   # the plugin's folder is watched: a .pyc written in lib/ would reload the guide

try:
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
except Exception:  # no python-gobject: no media keys, everything else works
    Gio = None

MAX_HEIGHT = 1080
HEIGHTS = (1080, 720, 480, 360)   # what ?h= may ask for
KEEP_FOR = 3600  # YouTube's playlist URLs last about six hours

SECRET = secrets.token_urlsafe(18)

LOGOS = pathlib.Path(os.environ.get("XDG_CACHE_HOME") or pathlib.Path.home() / ".cache") / "om-pg" / "logos"
LOGO_HOSTS = {"yt3.googleusercontent.com", "yt3.ggpht.com"}
LOGO_MAX_AGE = 30 * 86400
FRESH_MAX_AGE = 900  # a live stream's picture (fresh): it changes with what's on
LOGO_MAX_BYTES = 512 * 1024
logo_slots = threading.BoundedSemaphore(2)
logo_pace = threading.Lock()
last_logo = [0.0]
logo_failed = {}

cache = {}
lock = threading.Lock()


def attrs(line):
    return dict(re.findall(r'([A-Z0-9-]+)=("[^"]*"|[^,]*)', line.split(":", 1)[1]))


def trim(master, max_height=MAX_HEIGHT):
    lines = master.splitlines()
    variants = []
    for i, line in enumerate(lines):
        if line.startswith("#EXT-X-STREAM-INF") and i + 1 < len(lines):
            a = attrs(line)
            height = int(a.get("RESOLUTION", "0x0").split("x")[1])
            variants.append((height, "avc1" in a.get("CODECS", ""), line, lines[i + 1]))
    if not variants:
        raise LookupError("no video variants")
    smallest = min(v[0] for v in variants)
    fitting = [v for v in variants if v[0] <= max_height] or [v for v in variants if v[0] == smallest]
    height, _, inf, uri = max(fitting, key=lambda v: (v[1], v[0]))

    group = attrs(inf).get("AUDIO", "").strip('"')
    audio = [l for l in lines if l.startswith("#EXT-X-MEDIA") and "TYPE=AUDIO" in l
             and f'GROUP-ID="{group}"' in l]
    original = next((l for l in audio if "original" in l), None) \
        or next((l for l in audio if "DEFAULT=YES" in l), None) \
        or (audio[0] if audio else None)

    inf = re.sub(r',SUBTITLES="[^"]*"', "", inf)
    if not original:
        inf = re.sub(r',AUDIO="[^"]*"', "", inf)
    out = ["#EXTM3U", "#EXT-X-INDEPENDENT-SEGMENTS"]
    if original:
        out.append(original)
    out += [inf, uri, ""]
    return "\n".join(out)


def playlist(video_id, height=MAX_HEIGHT):
    """The trimmed master for a video at a height (from HEIGHTS)"""
    with lock:
        hit = cache.get(video_id)
    if hit and hit[0] > time.time():
        return trim(hit[1], height)
    with yt_dlp.YoutubeDL({"quiet": True, "no_warnings": True, "noprogress": True}) as ydl:
        info = ydl.extract_info("https://www.youtube.com/watch?v=" + video_id, download=False)
    manifest = next((f["manifest_url"] for f in info.get("formats", [])
                     if f.get("protocol", "").startswith("m3u8") and f.get("manifest_url")), None)
    if not manifest:
        raise LookupError("no HLS stream for " + video_id)
    with urllib.request.urlopen(manifest, timeout=20) as response:
        master = response.read(4 * 1024 * 1024).decode()
    text = trim(master, height)   # a master that can't be trimmed isn't kept
    with lock:
        cache[video_id] = (time.time() + KEEP_FOR, master)
    return text


class WebOnlyRedirects(urllib.request.HTTPRedirectHandler):
    """Follows redirects to http and https only (not ftp or anything else)."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(newurl).scheme not in ("http", "https"):
            raise LookupError("redirect away from the web")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


fetcher = urllib.request.build_opener(WebOnlyRedirects)


def logo(channel_id, src, any_host=False, max_age=LOGO_MAX_AGE):
    path = LOGOS / f"{channel_id}.jpg"
    try:
        if time.time() - path.stat().st_mtime < max_age:
            return path.read_bytes()
    except FileNotFoundError:
        pass
    url = urllib.parse.urlsplit(src)
    if any_host:
        if url.scheme not in ("http", "https") or not url.hostname:
            raise LookupError("not a web image")
    elif url.scheme != "https" or url.hostname not in LOGO_HOSTS:
        raise LookupError("not a YouTube image")
    if logo_failed.get(channel_id, 0) > time.time():
        if path.exists():
            return path.read_bytes()
        raise LookupError("failed recently")
    try:
        with logo_slots:
            with logo_pace:
                wait = last_logo[0] + 0.3 - time.time()
                if wait > 0:
                    time.sleep(wait)
                last_logo[0] = time.time()
            request = urllib.request.Request(src, headers={"User-Agent": "Mozilla/5.0"})
            with fetcher.open(request, timeout=15) as response:
                if not response.headers.get("Content-Type", "").startswith("image/"):
                    raise LookupError("not an image")
                data = response.read(LOGO_MAX_BYTES + 1)
        if len(data) > LOGO_MAX_BYTES:
            raise LookupError("too big")
    except Exception:
        logo_failed[channel_id] = time.time() + 6 * 3600
        if path.exists():
            return path.read_bytes()   # a month-old logo beats none
        raise
    LOGOS.mkdir(parents=True, exist_ok=True)
    partial = path.with_suffix(".part")
    partial.write_bytes(data)
    os.replace(partial, path)
    return data


def image_type(data):
    if data.startswith(b"\x89PNG"):
        return "image/png"
    if data.startswith(b"\xff\xd8"):
        return "image/jpeg"
    if data.startswith(b"GIF8"):
        return "image/gif"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "image/webp"
    if b"<svg" in data[:1024]:
        return "image/svg+xml"
    return "application/octet-stream"


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        url = urllib.parse.urlsplit(self.path)
        match = re.fullmatch(r"/([A-Za-z0-9_-]+)/picon", url.path)
        if match and hmac.compare_digest(match.group(1), SECRET):
            query = urllib.parse.parse_qs(url.query)
            src = query.get("src", [""])[0]
            fresh = "fresh" in query   # kept a quarter of an hour, not a month (the same file, replaced)
            try:
                data = logo("picon-" + hashlib.sha1(src.encode()).hexdigest()[:24], src, any_host=True,
                            max_age=FRESH_MAX_AGE if fresh else LOGO_MAX_AGE)
                self.send_body(data, image_type(data), "max-age=900" if fresh else "max-age=86400")
            except Exception:
                self.send_error(404)
            return
        match = re.fullmatch(r"/([A-Za-z0-9_-]+)/logo/(UC[A-Za-z0-9_-]{22})\.jpg", url.path)
        if match and hmac.compare_digest(match.group(1), SECRET):
            src = urllib.parse.parse_qs(url.query).get("src", [""])[0]
            try:
                self.send_body(logo(match.group(2), src), "image/jpeg", "max-age=86400")
            except Exception:
                self.send_error(404)
            return
        match = re.fullmatch(r"/([A-Za-z0-9_-]+)/play/([A-Za-z0-9_-]{11})\.m3u8", url.path)
        if not match or not hmac.compare_digest(match.group(1), SECRET):
            self.send_error(404)
            return
        asked = urllib.parse.parse_qs(url.query).get("h", [str(MAX_HEIGHT)])[0]
        if not asked.isdigit() or int(asked) not in HEIGHTS:
            self.send_error(400)
            return
        try:
            body = playlist(match.group(2), int(asked)).encode()
        except Exception as e:  # yt-dlp and network failures alike
            print(f"{match.group(2)}: {e}", file=sys.stderr, flush=True)
            self.send_error(502)
            return
        self.send_body(body, "application/vnd.apple.mpegurl")

    def send_body(self, body, kind, cache=""):
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        if cache:
            self.send_header("Cache-Control", cache)
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass  # the player changed channel, or the guide closed, before this arrived

    def log_message(self, *args):
        pass


output = threading.Lock()


def say(line):
    with output:
        print(line, flush=True)


MPRIS_NAME = "org.mpris.MediaPlayer2.programguide"
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_XML = """<node>
  <interface name="org.mpris.MediaPlayer2">
    <method name="Raise"/>
    <method name="Quit"/>
    <property name="CanQuit" type="b" access="read"/>
    <property name="CanRaise" type="b" access="read"/>
    <property name="HasTrackList" type="b" access="read"/>
    <property name="Identity" type="s" access="read"/>
    <property name="SupportedUriSchemes" type="as" access="read"/>
    <property name="SupportedMimeTypes" type="as" access="read"/>
  </interface>
  <interface name="org.mpris.MediaPlayer2.Player">
    <method name="Next"/>
    <method name="Previous"/>
    <method name="Pause"/>
    <method name="PlayPause"/>
    <method name="Stop"/>
    <method name="Play"/>
    <method name="Seek"><arg direction="in" type="x" name="Offset"/></method>
    <method name="SetPosition"><arg direction="in" type="o" name="TrackId"/><arg direction="in" type="x" name="Position"/></method>
    <method name="OpenUri"><arg direction="in" type="s" name="Uri"/></method>
    <signal name="Seeked"><arg type="x" name="Position"/></signal>
    <property name="PlaybackStatus" type="s" access="read"/>
    <property name="Rate" type="d" access="readwrite"/>
    <property name="Metadata" type="a{sv}" access="read"/>
    <property name="Volume" type="d" access="readwrite"/>
    <property name="Position" type="x" access="read"/>
    <property name="MinimumRate" type="d" access="read"/>
    <property name="MaximumRate" type="d" access="read"/>
    <property name="CanGoNext" type="b" access="read"/>
    <property name="CanGoPrevious" type="b" access="read"/>
    <property name="CanPlay" type="b" access="read"/>
    <property name="CanPause" type="b" access="read"/>
    <property name="CanSeek" type="b" access="read"/>
    <property name="CanControl" type="b" access="read"/>
  </interface>
</node>"""
PLAYER = "org.mpris.MediaPlayer2.Player"
COMMANDS = {"Next": "next", "Previous": "previous", "Pause": "pause", "PlayPause": "playpause",
            "Stop": "stop", "Play": "play", "Raise": "raise"}


class Mpris:
    """The guide as a media player. Runs its own GLib loop on a thread; all
    bus work happens there."""

    def __init__(self):
        self.state = {"active": False, "status": "Stopped"}
        self.position = (0, time.monotonic())   # microseconds, and when
        self.owner = 0
        self.conn = None
        self.loop = GLib.MainLoop()
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        # register_object_with_closures2 is the newer name for the same thing.
        register = getattr(self.conn, "register_object_with_closures2", None) or self.conn.register_object
        for interface in Gio.DBusNodeInfo.new_for_xml(MPRIS_XML).interfaces:
            register(MPRIS_PATH, interface, self.call, self.get, self.set)
        self.loop.run()

    def call(self, conn, sender, path, interface, method, params, invocation):
        if method in COMMANDS:
            say(json.dumps({"mpris": COMMANDS[method]}))
        elif method == "Seek" and self.state.get("canSeek"):   # on demand only: live TV can't
            say(json.dumps({"mpris": "seek", "by": int(params.unpack()[0])}))
        elif method == "SetPosition" and self.state.get("canSeek"):
            say(json.dumps({"mpris": "setPosition", "to": int(params.unpack()[1])}))
        invocation.return_value(None)   # Quit, OpenUri: nothing to do

    def set(self, conn, sender, path, interface, prop, value):
        return True   # Rate and Volume stay as they are

    def get(self, conn, sender, path, interface, prop):
        s = self.state
        fixed = {
            "CanQuit": GLib.Variant("b", False), "CanRaise": GLib.Variant("b", True),
            "HasTrackList": GLib.Variant("b", False), "Identity": GLib.Variant("s", "Uber TV"),
            "SupportedUriSchemes": GLib.Variant("as", []), "SupportedMimeTypes": GLib.Variant("as", []),
            "Rate": GLib.Variant("d", 1.0), "Volume": GLib.Variant("d", 1.0),
            "MinimumRate": GLib.Variant("d", 1.0), "MaximumRate": GLib.Variant("d", 1.0),
            "CanControl": GLib.Variant("b", True),
        }
        if prop in fixed:
            return fixed[prop]
        if prop == "PlaybackStatus":
            return GLib.Variant("s", s.get("status", "Stopped"))
        if prop == "Metadata":
            return self.metadata()
        if prop == "Position":
            us, when = self.position
            if s.get("status") == "Playing":
                us += int((time.monotonic() - when) * 1e6)
            return GLib.Variant("x", us)
        if prop in ("CanGoNext", "CanGoPrevious", "CanPlay", "CanPause"):
            return GLib.Variant("b", bool(s.get("active")))
        if prop == "CanSeek":
            return GLib.Variant("b", bool(s.get("active") and s.get("canSeek")))
        return None

    def metadata(self):
        s = self.state
        video = s.get("id", "")
        meta = {"mpris:trackid": GLib.Variant("o", "/org/programguide/track/" + re.sub(r"\W", "_", video or "none"))}
        if s.get("title"):
            meta["xesam:title"] = GLib.Variant("s", s["title"])
        if s.get("artist"):
            meta["xesam:artist"] = GLib.Variant("as", [s["artist"]])
        if s.get("album"):
            meta["xesam:album"] = GLib.Variant("s", s["album"])
        if s.get("length"):
            meta["mpris:length"] = GLib.Variant("x", int(s["length"]))
        art = self.art(s.get("channelId", ""), video)
        if art:
            meta["mpris:artUrl"] = GLib.Variant("s", art)
        return GLib.Variant("a{sv}", meta)

    @staticmethod
    def art(channel_id, video):
        # The channel's logo if it's cached, or the video's thumbnail.
        if re.fullmatch(r"UC[A-Za-z0-9_-]{22}", channel_id or ""):
            logo = LOGOS / f"{channel_id}.jpg"
            if logo.exists():
                return logo.as_uri()
        if re.fullmatch(r"[A-Za-z0-9_-]{11}", video or ""):
            return f"https://i.ytimg.com/vi/{video}/hqdefault.jpg"
        return ""

    def update(self, state):
        GLib.idle_add(self.apply, state)

    def apply(self, state):
        before = self.state
        self.state = state
        self.position = (int(state.get("position", 0)), time.monotonic())
        if state.get("active") and not self.owner:
            self.owner = Gio.bus_own_name_on_connection(self.conn, MPRIS_NAME, Gio.BusNameOwnerFlags.NONE, None, None)
        elif not state.get("active") and self.owner:
            Gio.bus_unown_name(self.owner)
            self.owner = 0
        changed = {}
        if before.get("status") != state.get("status"):
            changed["PlaybackStatus"] = self.get(None, None, None, PLAYER, "PlaybackStatus")
        if any(before.get(k) != state.get(k) for k in ("id", "title", "artist", "album", "length", "channelId")):
            changed["Metadata"] = self.metadata()
        if bool(before.get("active")) != bool(state.get("active")) or bool(before.get("canSeek")) != bool(state.get("canSeek")):
            for prop in ("CanGoNext", "CanGoPrevious", "CanPlay", "CanPause", "CanSeek"):
                changed[prop] = self.get(None, None, None, PLAYER, prop)
        if changed and self.owner:
            self.conn.emit_signal(None, MPRIS_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                  GLib.Variant("(sa{sv}as)", (PLAYER, changed, [])))
        return False


def listen(mpris):
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if mpris and isinstance(message, dict) and isinstance(message.get("mpris"), dict):
            mpris.update(message["mpris"])


def main():
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    say(f"{server.server_address[1]} {SECRET}")
    threading.Thread(target=listen, args=(Mpris() if Gio else None,), daemon=True).start()
    server.serve_forever()


if __name__ == "__main__":
    main()
