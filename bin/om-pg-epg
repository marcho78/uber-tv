#!/usr/bin/python3
"""Fetches program listings (XMLTV) for the guide's IPTV channels.

    om-pg-epg <request.json>

The request: {"sources": [link or full path, ...], "channels": [{"url",
"tvgId", "name"}, ...], "from": seconds, "to": seconds, "out": path}.
Each source is downloaded (or read), unpacked (.gz, .xz) and read as it
comes, so a big file never sits in memory (each channel and show is let
go of once read). What a file may unpack to, what an .xz file may make its
decoder reserve, and the whole run's time are limited: a small download
can't unpack into hours of work or gigabytes of memory. Its channels are matched to
yours: by tvg-id first, then by name within the same country, preferring
the East (not Pacific or West) feed. The shows of matched channels between
"from" and "to" are written to "out" as JSON, readable by you alone:
{"fetched", "from", "to", "sources": [{"url", "ok", "error", "channels",
"matched", "shows"}], "shows": {channel url: [[start, end, title, description,
category, episode title, episode], ...]}} (the episode as "S2E5", or as
XMLTV gives it, for Record every episode).

Prints a JSON line as each source goes ({"source", "status"}), then
{"done": true, "matched": n}. Out of time, the shows you had stay (with any
read in time), the sources not read say so, and the next try is the usual
one, about twelve hours on.
"""

import datetime
import gzip
import io
import json
import lzma
import os
import re
import sys
import tempfile
import time
import urllib.request
import xml.etree.ElementTree as ET

MAX_DOWNLOAD = 400 * 1024 * 1024
MAX_UNPACKED = 4 * 1024 * 1024 * 1024   # what one file may unpack to
MAX_XZ_MEMORY = 128 * 1024 * 1024        # what an .xz file may make its decoder reserve
RUN_SECONDS = 15 * 60                    # the whole run: downloads, unpacking, reading
MAX_OLD = 64 * 1024 * 1024               # the listings kept from last time, read back
MAX_ENTRY = 1024 * 1024                  # one channel or show (or anything else at the top), unpacked
MAX_SHOWS = 400                     # per channel
FEED_WORDS = {"pacific", "west", "mountain", "central"}
GENERIC_FEEDS = {"", "sd", "hd", "fhd", "uhd", "4k", "east", "sd1", "hd1"}
NOISE = {"hd", "sd", "fhd", "uhd", "4k", "hdtv", "east", "channel", "tv", "the", "and"}


def say(obj):
    print(json.dumps(obj), flush=True)


class OutOfTime(OSError):
    """The run's time is up"""


deadline = float("inf")   # when the run's time is up (main sets it)


def in_time():
    if time.monotonic() > deadline:
        raise OutOfTime("took too long")


def words(text):
    text = str(text or "").lower()
    text = re.sub(r"\([^)]*\)|\[[^\]]*\]", " ", text)   # (720p), [Geo-blocked]
    text = text.replace("&", " and ").replace("+", " plus ")
    return re.findall(r"[^\W_]+", text)


def key(text):
    return "".join(w for w in words(text) if w not in NOISE and w not in FEED_WORDS)


def split_id(tvg_id):
    """"CNN.us@SD" -> ("cnn", "us"); "CNN.HD.us2" -> ("cnn", "us")"""
    base = str(tvg_id or "").split("@")[0]
    parts = base.split(".")
    country = ""
    if len(parts) > 1 and re.fullmatch(r"[a-zA-Z]{2}\d*", parts[-1]):
        country = re.sub(r"\d", "", parts[-1]).lower()
        parts = parts[:-1]
    return key(" ".join(re.sub(r"([a-z])([A-Z])", r"\1 \2", p) for p in parts)), country


def xmltv_time(text):
    """Seconds since 1970, or None: not a time, or no such time (month 13,
    hour 24), so one show's bad time skips that show, not the file"""
    m = re.match(r"\s*(\d{4})(\d\d)(\d\d)(\d\d)?(\d\d)?(\d\d)?\s*([+-]\d{4})?", text or "")
    if not m:
        return None
    y, mo, d, h, mi, s = (int(x) if x else 0 for x in m.groups()[:6])
    try:
        t = datetime.datetime(y, mo, d, h, mi, s, tzinfo=datetime.timezone.utc).timestamp()
    except (ValueError, OverflowError):
        return None
    zone = m.group(7)
    if zone:
        sign = 1 if zone[0] == "+" else -1
        t -= sign * (int(zone[1:3]) * 3600 + int(zone[3:5]) * 60)
    return int(t)


def episode_of(el):
    """A show's episode, as one short text a series recording can tell
    episodes apart by: what's shown on screen ("S02E05"), else XMLTV's
    zero-based "season.episode.part" as S3E6, else another system's id"""
    nums = {}
    for n in el.findall("episode-num"):
        text = (n.text or "").strip()
        if text:
            nums.setdefault((n.get("system") or "").strip().lower(), text)
    if "onscreen" in nums:
        return nums["onscreen"][:40]
    m = re.match(r"^\s*(\d*)\s*(?:/\s*\d+)?\s*\.\s*(\d*)\s*(?:/\s*\d+)?\s*\.", nums.get("xmltv_ns", "") + ".")
    if m and (m.group(1) or m.group(2)):
        return ((("S%d" % (int(m.group(1)) + 1)) if m.group(1) else "") + (("E%d" % (int(m.group(2)) + 1)) if m.group(2) else ""))[:40]
    for system in sorted(nums):
        if system != "xmltv_ns":
            return (system + ":" + nums[system])[:40] if system else nums[system][:40]
    return ""


def fetch(source, folder):
    """A local path as it is; a link downloaded to a file in folder"""
    if not re.match(r"https?://", source):
        path = os.path.expanduser(source)
        if not os.path.isfile(path):
            raise OSError("no such file")
        return path, False
    req = urllib.request.Request(source, headers={"User-Agent": "om-pg (Omarchy program guide)"})
    fd, path = tempfile.mkstemp(prefix="epg-", suffix=".download", dir=folder)
    try:
        with urllib.request.urlopen(req, timeout=60) as resp, os.fdopen(fd, "wb") as out:
            got = 0
            while True:
                in_time()
                chunk = resp.read1(1 << 20)   # what's come, not a full MB: a slow drip can't hold it past the deadline
                if not chunk:
                    break
                got += len(chunk)
                if got > MAX_DOWNLOAD:
                    raise OSError("bigger than 400 MB")
                out.write(chunk)
    except BaseException:
        os.unlink(path)
        raise
    return path, True


class XzReader(io.RawIOBase):
    """An .xz file unpacked as it's read, its decoder held to MAX_XZ_MEMORY:
    lzma.open has no limit, and a file of a few bytes can ask for 1.5 GB
    before any of it is unpacked. Streams one after another are read in
    turn, and what follows the last (padding, or anything that isn't another
    whole stream) isn't an error."""

    def __init__(self, path):
        self.f = open(path, "rb")
        self.dec = lzma.LZMADecompressor(lzma.FORMAT_XZ, memlimit=MAX_XZ_MEMORY)
        self.later = False   # past the first stream

    def readable(self):
        return True

    def readinto(self, b):
        while True:
            if self.dec.eof:
                raw = self.dec.unused_data.lstrip(b"\0")   # zero padding may come between streams
                while not raw:
                    more = self.f.read(1 << 16)
                    if not more:
                        return 0
                    raw = more.lstrip(b"\0")
                self.dec = lzma.LZMADecompressor(lzma.FORMAT_XZ, memlimit=MAX_XZ_MEMORY)
                self.later = True
                try:
                    data = self.dec.decompress(raw, len(b))
                except lzma.LZMAError as e:
                    if "memory" in str(e).lower():
                        raise
                    return 0
            elif self.dec.needs_input:
                raw = self.f.read(1 << 16)
                if not raw:
                    if self.later:
                        return 0
                    raise EOFError("the .xz file ends too soon")
                data = self.dec.decompress(raw, len(b))
            else:
                data = self.dec.decompress(b"", len(b))
            if data:
                b[:len(data)] = data
                return len(data)

    def close(self):
        self.f.close()
        super().close()


class Capped:
    """A file as it unpacks, stopped past MAX_UNPACKED bytes, past MAX_ENTRY
    bytes since the reader last finished an entry (since: it sets it back),
    or once the run's time is up. ElementTree keeps an entry whole until it
    ends, so without the entry limit one show of a million parts, or one
    title of a gigabyte, would sit in memory."""

    def __init__(self, raw):
        self.raw = raw
        self.got = 0
        self.since = 0

    def read(self, n=-1):
        in_time()
        chunk = self.raw.read(n if n is not None and 0 <= n <= 1 << 20 else 1 << 20)
        self.got += len(chunk)
        self.since += len(chunk)
        if self.since > MAX_ENTRY:
            raise OSError("not program listings: one entry is over %d KB" % (MAX_ENTRY // 1024))
        if self.got > MAX_UNPACKED:
            raise OSError("bigger than %s unpacked" % ("%d GB" % (MAX_UNPACKED >> 30) if MAX_UNPACKED >= 1 << 30 else "%d MB" % (MAX_UNPACKED >> 20)))
        return chunk

    def close(self):
        self.raw.close()

    def __enter__(self):
        return self

    def __exit__(self, *args):
        self.close()


def opened(path):
    with open(path, "rb") as f:
        magic = f.read(6)
    if magic[:2] == b"\x1f\x8b":
        return Capped(gzip.open(path, "rb"))
    if magic == b"\xfd7zXZ\x00":
        return Capped(io.BufferedReader(XzReader(path), 1 << 16))
    return Capped(open(path, "rb"))


def feed_words(*texts):
    found = set()
    for t in texts:
        found |= set(words(re.sub(r"([a-z])([A-Z])", r"\1 \2", str(t or "")).replace(".", " "))) & FEED_WORDS
    return found


class Matcher:
    """Your channels, findable by tvg-id and by name. A channel of one feed
    (a Pacific or West one, or one station of a network, like CBS.us@KCCI)
    only takes listings of that feed: the times of another would be wrong."""

    def __init__(self, channels):
        self.exact = {}      # "cnn.us@sd" and "cnn.us" -> [url]
        self.keys = {}       # ("cnn", "us") -> [url]
        self.feeds = {}      # url -> its feed words (pacific, west…)
        for c in channels:
            url, tvg, name = c.get("url"), str(c.get("tvgId") or ""), c.get("name")
            if not url:
                continue
            feed = tvg.split("@")[1].lower() if "@" in tvg else ""
            specific = feed not in GENERIC_FEEDS
            self.feeds[url] = feed_words(name, tvg.split("@")[0])
            if tvg:
                self.exact.setdefault(tvg.lower(), []).append(url)
                if not specific:
                    self.exact.setdefault(tvg.split("@")[0].lower(), []).append(url)
            base, country = split_id(tvg)
            for k in ({key(name)} if specific else {base, key(name)}):
                if k:
                    self.keys.setdefault((k, country), []).append(url)

    def candidates(self, xid, names):
        """[(score, url)] for a listings channel"""
        out = {}
        for url in self.exact.get(xid.lower(), []) + self.exact.get(xid.split("@")[0].lower(), []):
            out[url] = 3
        base, country = split_id(xid)
        for k in {base} | {key(n) for n in names}:
            if not k:
                continue
            for url in self.keys.get((k, country), []) + (self.keys.get((k, ""), []) if country else []):
                out[url] = max(out.get(url, 0), 2 if k == base else 1)
        theirs = feed_words(xid, *names)
        return [(s, u) for u, s in out.items() if s == 3 or self.feeds.get(u, set()) == theirs]


def read(path, matcher, start, end, taken):
    """The shows of your channels in one listings file: (channels, matched, {url: shows})"""
    best = {}            # url -> (score, listings id)
    seen = 0
    wanted = None        # listings id -> [url], once the channels are read
    shows = {}
    root = None
    depth = 0
    with opened(path) as f:
        for event, el in ET.iterparse(f, events=("start", "end")):
            if event == "start":
                depth += 1
                if root is None:
                    root = el
                continue
            depth -= 1
            if depth != 1:
                continue   # a part of an entry (a channel or show inside one is just a part), or the root itself
            if el.tag == "channel":
                seen += 1
                xid = el.get("id") or ""
                names = [n.text or "" for n in el.findall("display-name")]
                for score, url in matcher.candidates(xid, names):
                    if url not in taken and score > best.get(url, (0, ""))[0]:
                        best[url] = (score, xid)
                el.clear()
            elif el.tag == "programme":
                if wanted is None:
                    wanted = {}
                    for url, (_, xid) in best.items():
                        wanted.setdefault(xid, []).append(url)
                urls = wanted.get(el.get("channel") or "")
                if urls:
                    a, b = xmltv_time(el.get("start")), xmltv_time(el.get("stop"))
                    if a and b and b > start and a < end and b > a:
                        title = (el.findtext("title") or "").strip()[:200]
                        desc = (el.findtext("desc") or "").strip()[:500]
                        sub = (el.findtext("sub-title") or "").strip()[:120]
                        cat = (el.findtext("category") or "").strip()[:40]
                        ep = episode_of(el)
                        if sub and sub.lower() not in title.lower():
                            desc = (sub + ". " + desc).strip()[:500]
                        for url in urls:
                            lst = shows.setdefault(url, [])
                            if len(lst) < MAX_SHOWS:
                                # (the episode's own title and number too, for Record every episode)
                                lst.append([a, b, title or "Untitled", desc, cat, sub, ep])
                el.clear()
            root.clear()   # a cleared element still hangs off the root: let go of it, so memory stays flat
            f.since = 0
    return seen, len(shows), shows


def tidy(lst):
    """In order, none overlapping the next"""
    lst.sort(key=lambda s: s[0])
    out = []
    for s in lst:
        if out and s[0] < out[-1][1]:
            if s[0] <= out[-1][0]:
                continue
            out[-1][1] = s[0]
        out.append(s)
    return out


def previous(path):
    """The listings written last time: {} if there are none, None if they're
    there but can't be read back (too big, or broken)"""
    try:
        with open(path, "rb") as f:
            raw = f.read(MAX_OLD + 1)
    except FileNotFoundError:
        return {}
    except OSError:
        return None
    if len(raw) > MAX_OLD:
        return None
    try:
        old = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(old, dict):
        return None
    if not isinstance(old.get("shows"), dict):
        old["shows"] = {}
    return old


def main():
    global deadline
    deadline = time.monotonic() + RUN_SECONDS
    if len(sys.argv) != 2:
        sys.exit("usage: om-pg-epg <request.json>")
    with open(sys.argv[1]) as f:
        req = json.load(f)
    try:
        os.unlink(sys.argv[1])   # it lists your channels: read, it goes
    except OSError:
        pass
    out_path = req["out"]
    folder = os.path.dirname(out_path)
    os.makedirs(folder, exist_ok=True)
    start, end = int(req.get("from") or time.time() - 3 * 3600), int(req.get("to") or time.time() + 30 * 3600)
    matcher = Matcher(req.get("channels") or [])
    report, shows = [], {}
    late = False
    for source in (req.get("sources") or [])[:20]:
        entry = {"url": source, "ok": False, "error": "", "channels": 0, "matched": 0, "shows": 0}
        if late:
            entry["error"] = "not read: out of time"
            report.append(entry)
            continue
        try:
            say({"source": source, "status": "fetching"})
            path, temporary = fetch(source, folder)
            try:
                say({"source": source, "status": "reading"})
                seen, matched, got = read(path, matcher, start, end, set(shows))
            finally:
                if temporary:
                    os.unlink(path)
            for url, lst in got.items():
                shows[url] = tidy(lst)
            entry.update(ok=True, channels=seen, matched=matched, shows=sum(len(v) for v in got.values()))
            if not seen:
                entry.update(ok=False, error="not program listings (XMLTV)")
        except OutOfTime:
            late = True
            entry["error"] = "took too long"
        except ET.ParseError:
            entry["error"] = "not program listings (XMLTV)"
        except (OSError, ValueError, EOFError, lzma.LZMAError) as e:
            entry["error"] = str(getattr(e, "reason", None) or e)[:160]
        report.append(entry)
        say({"source": source, "status": "done" if entry["ok"] else "failed", "matched": entry["matched"], "error": entry["error"]})

    if late:
        # out of time: the shows from last time stay, with any read in time over them;
        # if they can't be read back, the file stays exactly as it is
        old = previous(out_path)
        if old is None:
            say({"done": True, "matched": 0})
            return
        shows = dict(old["shows"], **shows)
        if isinstance(old.get("from"), int) and isinstance(old.get("to"), int):
            start, end = min(start, old["from"]), max(end, old["to"])
    data = {"version": 1, "fetched": int(time.time()), "from": start, "to": end, "sources": report, "shows": shows}
    fd, tmp = tempfile.mkstemp(prefix="epg-", suffix=".json", dir=folder)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, separators=(",", ":"))
    os.chmod(tmp, 0o600)
    os.replace(tmp, out_path)
    say({"done": True, "matched": len(shows)})


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
