#!/usr/bin/python3
"""Installs the guide's apps, and checks them, before anything is trusted.

    om-pg-apps catalog <link or path> <signers file> <seen> <cache folder>
    om-pg-apps inspect <source JSON> <staging folder>
    om-pg-apps app-inspect <file.tvapp> <staging folder> <apps folder>
    om-pg-apps app-update-check <apps folder> <source> <id>
    om-pg-apps app-update-prepare <apps folder> <source> <id> <staging folder>
                                      (the exact review on stdin)
    om-pg-apps app-current <staged folder> <staging folder> <apps folder>
    om-pg-apps app-key <publisher folder>
    om-pg-apps app-file <app folder> <publisher folder> [update address]
    om-pg-apps app-revoke <publisher folder> <id> <version|*> <reason>
    om-pg-apps install <staged folder> <apps folder> <data folder> <tree> <source>
    om-pg-apps discard <staged folder> <staging folder>
    om-pg-apps remove <id> <source> <roots JSON>
    om-pg-apps verify <apps folder> <signers file> <plugin folder>
    om-pg-apps bundled <plugin folder>
    om-pg-apps migrate <apps folder> <journal> <legacy JSON>
    om-pg-apps check <app folder>
    om-pg-apps try <app folder> [options]      (bin/om-pg-apprun try: see there)
    om-pg-apps secret-set <secrets file> <name>   (the value on stdin)
    om-pg-apps secret-clear <secrets file> <name|signIn|*> [<name>...]
    om-pg-apps server <address>                   (a server address made canonical)
    om-pg-apps cert <server>                      (its certificate's SHA-256, to pin)
    om-pg-apps forget <signIn|server|data> <id> <source> <roots JSON>
    om-pg-apps activity <id> <source> <roots JSON>   (which sites it contacted)
    om-pg-apps pack <app folder> <out.tar.gz>

Each prints one JSON line: {"ok": true, ...}, or {"ok": false, "error": ...}
saying what was wrong, in words for the user (an install that failed with
nothing on disk changed, provably, adds "unchanged": true).

catalog: the catalog (catalog.json) and its signature (catalog.json.sig),
checked with ssh-keygen against the signers file that ships with the guide
(namespace and principal "uber-tv-catalog"). A catalog older than one
already seen ("updated" under <seen>) is refused, so an old one can't be
replayed, and so is one whose revocations can't be read. A version it
revokes isn't offered. Its apps' icons are downloaded and checked against
their SHA-256. What's kept goes in <cache folder>: apps-catalog.json for the
guide to show, and the catalog as it came, with its signature.

inspect: a package from the catalog ({"type": "catalog", "id", "cache",
"signers", "seen"}: the catalog's signature checked again, not taken from
what's kept), whose SHA-256 must match the catalog's, or (developer mode)
from a file ({"type": "file", "path"}: a .tar.gz, a folder, or a folder's
app.json). It's unpacked into a private folder in <staging folder>: plain
files and folders only (no links, devices, absolute paths or ..), 200 files,
400 files and folders, 4 folders deep and 20 MB at most (its whole tar 24
MB, in the gzip's first member; its pax and long-name headers small, a
global one with nothing but a comment in it, as git archive writes, no
sparse files), no programs, only the kinds of file its kind of app may
have. Then its app.json is checked.
Prints the manifest, each file's SHA-256, their tree (one SHA-256 for them
all) and the staged folder, for the guide to show you before anything is
installed.

app-inspect does that for a signed .tvapp picked on this computer, without
contacting anything. app-update-check fetches only its signed release note;
app-update-prepare fetches its package only after the guide passes back the
exact consent review. app-current and install bind that review to the newest
accepted signed note under the apps-folder lock. app-key, app-file and
app-revoke are the publisher tools described in docs/sources.md.

Every install has a source: "catalog:uber" (the Uber TV catalog: launchers
only), "bundled" (an app the plugin comes with, apps/first-party/<id>, part
of its reviewed commit), "file:<16 hex>" (one Developer-mode lineage), or
"app:<16 hex>" (a signed app file's key). Everything of an app is kept by
(source, id); on disk the source is <source dir>, the first 16 hex digits of
its SHA-256.

install: the staged app into <apps folder>/<source dir>/<id>/<version>,
read-only, if its files are still the <tree> you were shown; its other
versions go. One from the catalog or a signed app file keeps its package and
signed proof beside it (<version>.proof); a signed app's accepted note state
is swapped in with them. remove: an app and everything of it (its
files, storage, secrets, log, pictures and Activity, each under its root in
<roots JSON>). One install or removal changes the apps folder at a time
(another waits its turn). activity: an app's Activity (lib/appactivity.py),
the sites it contacted and the ones it was refused, as totals for the guide.

bundled: the plugin's own apps, checked, for Get apps (and whether apps
with code can run here). migrate: apps from before sources moved into the
(source, id) layout, each decision journaled first so an interrupted run
finishes the same way. check: an app folder checked as an install checks
it, plus a lint of its imports (--json is the only output). secret-set and
secret-clear: an app's secrets file (0600 in a 0700 folder), the value
read from stdin, never from the command line.

verify: every app in <apps folder> as it is: its files and its trail back to
the catalog, plugin, or signed app release it came from. A signed app's key,
release signature, package, monotonic note state and cumulative withdrawals
are checked too. Its app.json is read from disk and checked, so what the guide
shows and opens comes from the app, not from the guide's notes.

pack: an app folder into a package, checked the way an install checks it,
the same bytes every time (for the catalog).

private-read and private-write: the guide's own app-screens.json and
settings.json, read bounded and never through a link, and written as a
confirmed write (saved, unconfirmed or failed). theme-save, theme-tidy,
theme-sweep and theme-remove (a JSON request on stdin): a theme saved as one
confirmed transaction (its pictures checked and copied in under new names),
what only its old theme.json named taken away once the new one is on, a
crash's leftovers swept, and a theme removed. picture-import: a picture you
picked, checked and copied into the guide's own folder; picture-prune: the
copies no choice names any more. saver-pictures: the screen saver's pictures
(Omarchy's backgrounds, and your folder), each checked when listed;
saver-take: one of them, opened through its folder without following any link,
checked through that open file and copied from it into the guide's cache, the
only copy shown (so it's the file that was checked, whatever happens to the
name after); saver-folder: your screen saver folder, made when it's first
needed. lock-read, lock-check, lock-passcode, lock-save and lock-reset: the
channel lock, its passcode kept only as a slow salted
hash in ~/.config/om-pg/lock.json, given on stdin, never the command line.

A launcher is a website opened full screen in your browser's app window;
nothing in it is ever run. An app with code (api 2, 3 or 4, "kind": "app") runs
only in the helper's sandbox (bin/om-pg-apprun); nothing here runs it.
"""

import base64
import contextlib
import ctypes
import errno
import fcntl
import gzip
import hashlib
import hmac
import io
import json
import os
import re
import secrets
import shutil
import stat
import struct
import subprocess
import sys
import tarfile
import tempfile
import time
import unicodedata
import urllib.parse
import urllib.request
import zlib

sys.dont_write_bytecode = True   # the plugin's folder is watched: a .pyc written in lib/ would reload the guide

API = 4                              # the newest app API this guide speaks (1: launchers, 2 to 4: apps with code)
NAMESPACE = PRINCIPAL = "uber-tv-catalog"
MAX_PACKAGE = 20 * 1024 * 1024       # downloaded
MAX_UNPACKED = 20 * 1024 * 1024
MAX_FILES = 200
MAX_MEMBERS = 400                    # files and folders in a package
MAX_DEPTH = 4                        # folders deep
MAX_TAR = MAX_UNPACKED + 4 * 1024 * 1024   # a package's whole tar, unpacked: its files, and room to spare for headers and padding
MAX_EXTENDED = MAX_MEMBERS * 2048    # its extended headers (pax records, GNU long names) together, in tar blocks
MAX_LICENSE = 256 * 1024
MAX_MANIFEST = 64 * 1024
MAX_ICON = 512 * 1024
MAX_CATALOG = 2 * 1024 * 1024
MAX_SIGNATURE = 16 * 1024
MAX_CATALOG_APPS = 500
MAX_APP_FILE = 25 * 1024 * 1024
MAX_RELEASE = 512 * 1024
MAX_REVOKED = 1000

# \Z, not $: Python's $ also matches before a final newline
ID_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}(\.[a-z0-9][a-z0-9-]{0,30}){1,5}\Z")
VERSION_RE = re.compile(r"^(0|[1-9]\d{0,4})\.(0|[1-9]\d{0,4})\.(0|[1-9]\d{0,4})\Z")
DOMAIN_RE = re.compile(r"^(?=.{4,253}\Z)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}\Z")
URL_RE = re.compile(r"^[A-Za-z0-9\-._~:/?#\[\]@!&()*+,;=%]{9,500}\Z")   # no quotes, spaces, $ or backticks
COLOR_RE = re.compile(r"^#[0-9a-fA-F]{6}\Z")
SHA_RE = re.compile(r"^[0-9a-f]{64}\Z")
PART_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}\Z")   # no hidden files, no . or .. (__init__.py is fine)

IMAGES = {".png", ".jpg", ".jpeg", ".webp"}
TEXTS = {".md", ".txt"}
LICENSES = {"LICENSE", "COPYING"}    # beside app.json, plain text like the others
CODE = {".py", ".json"}
# What each kind of app may hold. Launchers: no code at all; apps: Python
# (run only inside the sandbox, never on this computer directly) and data.
KIND_FILES = {"launcher": IMAGES | TEXTS, "app": IMAGES | TEXTS | CODE}
# Permissions this guide knows; launchers may only ask for "web"
KNOWN_ASKS = {"web", "net", "play", "signIn", "storage"}
KIND_ASKS = {"launcher": {"web"}}

# Where an install came from: the catalog, the reviewed plugin, an unsigned
# Developer-mode file lineage, a signed app key, or the retired link-source
# layout (kept only so an old local install fails closed during migration).
SOURCE_RE = re.compile(r"^(catalog:uber|bundled|file:[0-9a-f]{16}|app:[0-9a-f]{16}|source:[0-9a-f]{16})\Z")
APP_KEYS = {"id", "name", "version", "api", "kind", "author", "description", "color", "icon", "main", "permissions", "settings", "home"}
APP_KEYS_3 = APP_KEYS | {"layout"}   # api 3 and later: the app's suggested look and its rows' defaults
LOOKS = ("classic", "posters", "cinematic", "wall", "compact")
SHAPES = ("poster", "wide", "square", "logo", "circle")
SIZES = ("small", "medium", "large")
LAYOUTS = ("row", "grid", "list", "hero")
HOME_SHAPES = ("poster", "wide")
ROW_ID_RE = re.compile(r"^[a-z][a-z0-9_-]{0,63}\Z")   # api 3's row ids (lib/appblocks.py)
APP_ASKS = {"net", "netWrite", "server", "play", "signIn", "storage"}
WRITE_METHODS = ("POST", "PUT", "PATCH", "DELETE")   # api 4's netWrite, beside GET and HEAD
SIGN_IN_WAYS = ("code", "password")                  # how an app signs in (a password: api 4)
SETTING_TYPES = {"text", "choice", "switch", "secret"}
KEY_RE = re.compile(r"^[a-z][A-Za-z0-9_]{0,31}\Z")


def source_dir(source):
    """A source as one path segment: never a free string on disk"""
    if not isinstance(source, str) or not SOURCE_RE.match(source):
        raise Bad("not an app's source")
    return hashlib.sha256(source.encode()).hexdigest()[:16]


class Bad(Exception):
    """Something wrong with an app, a package or a catalog, in words for the user"""


class Untrusted(Bad):
    """A catalog whose signature isn't by a key this guide trusts"""


class Unchanged(Bad):
    """An install that failed with nothing on disk changed, provably: it
    stopped before anything was moved, or its swap was undone and checked"""


class Retry(Unchanged):
    """An install whose new copy couldn't be made or didn't check out (a full
    disk, a file that didn't read back), nothing changed: the guide says to
    try again, and keeps these words for its log"""


def say(obj):
    print(json.dumps(obj, separators=(",", ":")), flush=True)


def failure(e):
    """A failure's one line: an install that provably changed nothing says
    so ("unchanged"), so the guide can undo what it did first"""
    out = {"ok": False, "error": str(e)}
    if isinstance(e, Unchanged):
        out["unchanged"] = True
    if isinstance(e, Retry):
        out["retry"] = True
    return out


# ---- downloading ---------------------------------------------------------

class HttpsOnly(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.startswith("https://"):
            raise Bad("the download was sent somewhere not secure (" + newurl.split("/")[2] + ")")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


OPENER = urllib.request.build_opener(HttpsOnly)


def download(url, limit, what, seconds=180):
    """A link's bytes, at most limit of them, within seconds (a server that
    drips a byte at a time doesn't hold things up for ever)"""
    if not url.startswith("https://"):
        raise Bad(what + " must come over https")
    req = urllib.request.Request(url, headers={"User-Agent": "om-pg apps (Omarchy program guide)"})
    deadline = time.monotonic() + seconds
    chunks, size = [], 0
    try:
        with OPENER.open(req, timeout=30) as resp:
            while True:
                if time.monotonic() > deadline:
                    raise Bad("getting " + what + " took too long")
                chunk = resp.read1(65536)
                if not chunk:
                    break
                size += len(chunk)
                if size > limit:
                    raise Bad(what + " is bigger than " + str(limit // 1024) + " KB")
                chunks.append(chunk)
    except Bad:
        raise
    except OSError as e:
        raise Bad("couldn't get " + what + ": " + str(getattr(e, "reason", None) or e)[:120])
    return b"".join(chunks)


def open_plain(path, follow=True):
    """A plain file, opened to read: never a pipe or a device (a read from
    one could wait for ever), nor a link unless follow"""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | (0 if follow else os.O_NOFOLLOW))
    f = os.fdopen(fd, "rb")
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        f.close()
        raise Bad(os.path.basename(path) + " isn't a plain file")
    return f


def read_local(path, limit, what):
    try:
        with open_plain(path) as f:
            data = f.read(limit + 1)
    except OSError as e:
        raise Bad("couldn't read " + what + ": " + (e.strerror or str(e)))
    if len(data) > limit:
        raise Bad(what + " is bigger than " + str(limit // 1024) + " KB")
    return data


def fetch(where, limit, what, seconds=180):
    return download(where, limit, what, seconds) if re.match(r"https?://", where) else read_local(where, limit, what)


def resolve(base, ref):
    """A file the catalog names, on the catalog's own site (or in its folder)"""
    if not isinstance(ref, str) or not ref or len(ref) > 500:
        raise Bad("the catalog names a file badly")
    if re.match(r"https?://", base):
        url = urllib.parse.urljoin(base, ref)
        b, u = urllib.parse.urlsplit(base), urllib.parse.urlsplit(url)
        if u.scheme != "https" or u.netloc != b.netloc:
            raise Bad("the catalog names a file that isn't on its own site")
        return url
    if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", ref) or ref.startswith("/"):
        raise Bad("the catalog names a file outside its folder")
    folder = os.path.dirname(os.path.realpath(base))
    path = os.path.realpath(os.path.join(folder, ref))
    if not path.startswith(folder + os.sep):
        raise Bad("the catalog names a file outside its folder")
    return path


# ---- checking what an app says --------------------------------------------

def text(obj, key, lo, hi, where, required=True):
    v = obj.get(key)
    if v is None and not required:
        return ""
    if not isinstance(v, str):
        raise Bad(where + ": " + key + " must be text")
    v = v.strip()
    if not lo <= len(v) <= hi:
        raise Bad(where + ": " + key + " must be " + (str(lo) + " to " if lo else "up to ") + str(hi) + " characters")
    # control characters, and the invisible ones (right-to-left overrides,
    # zero-width spaces) that could make a name look like another
    if any(unicodedata.category(c) in ("Cc", "Cf", "Co", "Cs") for c in v):
        raise Bad(where + ": " + key + " has hidden or control characters")
    return v


def check_asks(perms, kind, where):
    """The permissions an app asks for, checked and tidied: {"web": [domains]}"""
    if perms is None:
        perms = {}
    if not isinstance(perms, dict):
        raise Bad(where + ": permissions must be an object")
    out = {}
    for key in perms:
        if key not in KNOWN_ASKS:
            raise Bad(where + ": it asks for something this guide doesn't know (" + str(key)[:40] + ")")
        if key not in KIND_ASKS.get(kind, set()):
            raise Bad(where + ": it asks for " + key + ", which only apps with code can ask for, and this guide doesn't run those yet")
    web = perms.get("web", [])
    if not isinstance(web, list) or len(web) > 10:
        raise Bad(where + ": permissions.web must be a list of up to 10 websites")
    domains = []
    for d in web:
        if not isinstance(d, str) or not DOMAIN_RE.match(d):
            raise Bad(where + ": permissions.web has something that isn't a website's name (" + str(d)[:60] + ")")
        if d not in domains:
            domains.append(d)
    if kind == "launcher" and not domains:
        raise Bad(where + ": a launcher asks to open a website (permissions.web)")
    if domains:
        out["web"] = sorted(domains)
    return out


def check_web(url, domains, where):
    """A launcher's link: plain https, on one of its websites, no name or password in it"""
    if not isinstance(url, str) or not URL_RE.match(url):
        raise Bad(where + ": launch.web must be a plain https link (no spaces, quotes or $)")
    u = urllib.parse.urlsplit(url)
    if u.scheme != "https":
        raise Bad(where + ": launch.web must be an https link")
    if "@" in u.netloc:
        raise Bad(where + ": launch.web mustn't have a name or password in it")
    host = u.hostname or ""
    # no port, not even :443: the guide reads a link's website the same way
    if ":" in u.netloc or not DOMAIN_RE.match(host) or u.netloc != host:
        raise Bad(where + ": launch.web must go to a website by its name (lowercase, no port)")
    if not any(host == d or host.endswith("." + d) for d in domains):
        raise Bad(where + ": launch.web goes to " + host + ", which isn't in its permissions")
    return url


def check_manifest(m, files):
    """app.json, checked and tidied; files is what the package holds"""
    where = "app.json"
    if not isinstance(m, dict):
        raise Bad("app.json must be an object")
    api = m.get("api")
    if not isinstance(api, int) or isinstance(api, bool) or api < 1:
        raise Bad("app.json: api must be a number (this guide speaks api " + str(API) + ")")
    if api > API:
        raise Bad("this app needs a newer Uber TV (it's for api " + str(api) + ")")
    app_id = m.get("id")
    if not isinstance(app_id, str) or not ID_RE.match(app_id):
        raise Bad("app.json: id must be like com.example.myapp (lowercase letters, digits, dots, dashes)")
    version = m.get("version")
    if not isinstance(version, str) or not VERSION_RE.match(version):
        raise Bad("app.json: version must be like 1.0.0")
    kind = m.get("kind")
    if kind == "app":
        return check_app_manifest(m, files, where)
    if kind != "launcher":
        raise Bad("app.json: kind must be launcher or app")
    if api != 1:
        raise Bad("app.json: a launcher is api 1")
    out = {
        "id": app_id, "version": version, "api": api, "kind": kind,
        "name": text(m, "name", 1, 40, where),
        "author": text(m, "author", 1, 60, where),
        "description": text(m, "description", 0, 300, where, required=False),
    }
    color = m.get("color", "")
    if color and (not isinstance(color, str) or not COLOR_RE.match(color)):
        raise Bad("app.json: color must be like #e50914")
    out["color"] = (color or "").lower()
    icon = m.get("icon", "")
    if icon:
        if not isinstance(icon, str) or icon not in files or os.path.splitext(icon)[1].lower() not in IMAGES:
            raise Bad("app.json: icon must be a .png, .jpg or .webp file in the app")
    out["icon"] = icon or ""
    out["permissions"] = check_asks(m.get("permissions"), kind, where)
    launch = m.get("launch")
    if not isinstance(launch, dict) or set(launch) != {"web"}:
        raise Bad("app.json: a launcher has launch: {\"web\": \"https://…\"}")
    out["launch"] = {"web": check_web(launch["web"], out["permissions"]["web"], where)}
    return out


def check_app_manifest(m, files, where):
    """app.json of an app with code (api 2, 3 or 4), checked strictly:
    unknown fields are refused, every list and string has a cap. The api is
    kept: it's the schema the app's results are checked against"""
    api = m.get("api")
    if api not in (2, 3, 4):
        raise Bad("app.json: an app with code is api 2, 3 or 4")
    unknown = sorted(set(m) - (APP_KEYS_3 if api >= 3 else APP_KEYS))
    if unknown:
        raise Bad(where + ": it has a field this guide doesn't know (" + str(unknown[0])[:40] + ")")
    out = {
        "id": m["id"], "version": m["version"], "api": api, "kind": "app",
        "name": text(m, "name", 1, 40, where),
        "author": text(m, "author", 1, 60, where),
        "description": text(m, "description", 0, 300, where, required=False),
    }
    color = m.get("color", "")
    if color and (not isinstance(color, str) or not COLOR_RE.match(color)):
        raise Bad("app.json: color must be like #e50914")
    out["color"] = (color or "").lower()
    icon = m.get("icon", "")
    if icon:
        if not isinstance(icon, str) or icon not in files or os.path.splitext(icon)[1].lower() not in IMAGES:
            raise Bad("app.json: icon must be a .png, .jpg or .webp file in the app")
    out["icon"] = icon or ""
    main = m.get("main")
    if not isinstance(main, str) or "/" in main or not main.endswith(".py") or main not in files:
        raise Bad("app.json: main must be a .py file at the top of the app")
    out["main"] = main
    out["permissions"] = check_app_asks(m.get("permissions"), where, api)
    out["settings"] = check_settings(m.get("settings", []), where)
    out["home"] = check_home(m.get("home", []), where, api)
    if api >= 3:
        out["layout"] = check_layout(m.get("layout", {}), where)
    return out


def check_layout(v, where):
    """api 3's layout: the look the app suggests, and its rows' defaults
    (each by its row id: a label for Customize, a shape, a size, a layout)"""
    if not isinstance(v, dict) or set(v) - {"look", "rows"}:
        raise Bad(where + ": layout is { look, rows }")
    # each one present is checked as itself: [], false and 0 aren't "absent"
    look = v.get("look", "")
    if "look" in v and (not isinstance(look, str) or look not in LOOKS):
        raise Bad(where + ": layout.look is " + ", ".join(LOOKS[:-1]) + " or " + LOOKS[-1])
    rows = v.get("rows", [])
    if not isinstance(rows, list) or len(rows) > 40:
        raise Bad(where + ": layout.rows must be a list of up to 40 rows")
    out, ids = {"look": look or "", "rows": []}, set()
    for r in rows:
        if not isinstance(r, dict) or set(r) - {"id", "label", "shape", "size", "layout"}:
            raise Bad(where + ": a layout row is { id, label, shape, size, layout }")
        rid = r.get("id")
        if not isinstance(rid, str) or not ROW_ID_RE.match(rid) or rid in ids:
            raise Bad(where + ": a layout row's id must be unique: lowercase letters, digits, - and _, starting with a letter")
        ids.add(rid)
        row = {"id": rid, "label": text(r, "label", 1, 40, where + ": layout row " + rid)}
        for k, allowed in (("shape", SHAPES), ("size", SIZES), ("layout", LAYOUTS)):
            if k not in r:
                continue
            if not isinstance(r[k], str) or r[k] not in allowed:
                raise Bad(where + ": layout row " + rid + "'s " + k + " is " + ", ".join(allowed[:-1]) + " or " + allowed[-1])
            row[k] = r[k]
        out["rows"].append(row)
    return out


def check_app_asks(p, where, api=4):
    """An app's permissions, canonical: exact hosts it may connect to
    (GET/HEAD), the ones of those it may also send changes to (api 4's
    netWrite, by method), one server the user chooses, playing media, a code
    sign-in, its own storage"""
    if p is None:
        p = {}
    if not isinstance(p, dict):
        raise Bad(where + ": permissions must be an object")
    unknown = sorted(set(p) - APP_ASKS)
    if unknown:
        raise Bad(where + ": it asks for something this guide doesn't know (" + str(unknown[0])[:40] + ")")
    out = {"net": [], "netWrite": {}, "server": None, "play": False, "signIn": "", "storage": False}
    net = p.get("net", [])
    if not isinstance(net, list) or len(net) > 10:
        raise Bad(where + ": permissions.net must be a list of up to 10 websites")
    for h in net:
        if not isinstance(h, str) or not DOMAIN_RE.match(h):
            raise Bad(where + ": permissions.net has something that isn't a website's exact name (" + str(h)[:60] + ")")
        if h not in out["net"]:
            out["net"].append(h)
    out["net"].sort()
    writes = p.get("netWrite", {})
    if "netWrite" in p and api < 4:
        raise Bad(where + ": permissions.netWrite needs api 4")
    if not isinstance(writes, dict):
        raise Bad(where + ": permissions.netWrite is { \"<website>\": [\"POST\", ...] }")
    for h in sorted(writes):
        if h not in out["net"]:
            raise Bad(where + ": permissions.netWrite names a website that isn't in permissions.net (" + str(h)[:60] + ")")
        methods = writes[h]
        if (not isinstance(methods, list) or not methods or len(methods) > len(WRITE_METHODS)
                or not all(isinstance(x, str) and x in WRITE_METHODS for x in methods) or len(set(methods)) != len(methods)):
            raise Bad(where + ": permissions.netWrite." + h + " is a list of POST, PUT, PATCH or DELETE, each once")
        out["netWrite"][h] = [x for x in WRITE_METHODS if x in methods]
    server = p.get("server")
    if server is not None:
        if not isinstance(server, dict) or set(server) - {"label", "defaultPort", "fromSignIn"}:
            raise Bad(where + ": permissions.server is { label, defaultPort, fromSignIn }")
        port = server.get("defaultPort", 0)
        if not isinstance(port, int) or isinstance(port, bool) or not 0 <= port <= 65535:
            raise Bad(where + ": permissions.server.defaultPort must be a port number")
        out["server"] = {"label": text(server, "label", 1, 40, where + ": permissions.server"), "defaultPort": port}
        # api 4: the server is chosen while signing in (an account that lists your servers)
        if "fromSignIn" in server:
            if not isinstance(server["fromSignIn"], bool):
                raise Bad(where + ": permissions.server.fromSignIn must be true or false")
            if api < 4:
                raise Bad(where + ": permissions.server.fromSignIn needs api 4")
            if server["fromSignIn"]:
                out["server"]["fromSignIn"] = True
    for flag in ("play", "storage"):
        v = p.get(flag, False)
        if not isinstance(v, bool):
            raise Bad(where + ": permissions." + flag + " must be true or false")
        out[flag] = v
    # how it signs in: "code", "password" (api 4) or both; kept as one string
    # in a fixed order ("code", "password", "code+password")
    sign = p.get("signIn", "")
    ways = [] if sign == "" else [sign] if isinstance(sign, str) else sign
    if (not isinstance(ways, list) or (isinstance(sign, list) and not ways) or len(set(map(str, ways))) != len(ways)
            or not all(w in SIGN_IN_WAYS for w in ways)):
        raise Bad(where + ": permissions.signIn is \"code\", \"password\" or [\"code\", \"password\"]")
    if (isinstance(sign, list) or "password" in ways) and api < 4:
        raise Bad(where + ": signing in with a password needs api 4")
    if ways and not out["server"]:
        raise Bad(where + ": signing in needs a server (permissions.server)")
    if out["server"] and out["server"].get("fromSignIn") and not ways:
        raise Bad(where + ": choosing the server while signing in needs a sign-in (permissions.signIn)")
    out["signIn"] = "+".join(w for w in SIGN_IN_WAYS if w in ways)
    return out


def check_settings(items, where):
    if not isinstance(items, list) or len(items) > 16:
        raise Bad(where + ": settings must be a list of up to 16 fields")
    out, keys = [], set()
    for f in items:
        if not isinstance(f, dict) or set(f) - {"key", "type", "label", "choices"}:
            raise Bad(where + ": a setting is { key, type, label, choices }")
        key = f.get("key")
        if not isinstance(key, str) or not KEY_RE.match(key) or key in keys or key in ("server", "signIn"):
            raise Bad(where + ": a setting's key must be a short unique name (letters, digits, _)")
        keys.add(key)
        kind = f.get("type")
        if kind not in SETTING_TYPES:
            raise Bad(where + ": a setting's type is text, choice, switch or secret")
        field = {"key": key, "type": kind, "label": text(f, "label", 1, 40, where + ": setting " + key)}
        if kind == "choice":
            choices = f.get("choices")
            if not isinstance(choices, list) or not 1 <= len(choices) <= 20:
                raise Bad(where + ": setting " + key + " needs 1 to 20 choices")
            field["choices"] = [text({"c": c}, "c", 1, 40, where + ": setting " + key) for c in choices]
        elif "choices" in f:
            raise Bad(where + ": only a choice setting has choices")
        out.append(field)
    return out


def check_home(items, where, api=2):
    """Home rows an app offers; api 3 can say their shape (poster or wide,
    the shapes a Home row takes)"""
    if not isinstance(items, list) or len(items) > 4:
        raise Bad(where + ": home must be a list of up to 4 rows")
    out, keys = [], set()
    for r in items:
        if not isinstance(r, dict) or set(r) - ({"key", "label", "shape"} if api >= 3 else {"key", "label"}):
            raise Bad(where + ": a Home row is { key, label" + (", shape }" if api >= 3 else " }"))
        key = r.get("key")
        if not isinstance(key, str) or not KEY_RE.match(key) or key in keys:
            raise Bad(where + ": a Home row's key must be a short unique name")
        keys.add(key)
        row = {"key": key, "label": text(r, "label", 1, 40, where + ": Home row " + key)}
        if "shape" in r:
            if not isinstance(r["shape"], str) or r["shape"] not in HOME_SHAPES:
                raise Bad(where + ": Home row " + key + "'s shape is poster or wide")
            row["shape"] = r["shape"]
        out.append(row)
    return out


MAX_SIDE = 4096
MAX_PIXELS = 4096 * 4096                # "16 Mpx": the design caps both at 4096 x 4096
SOF = {0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF}


def image_info(data):
    """A picture's kind and size, read from its header without decoding it:
    ("png"|"jpeg"|"webp", width, height), or None if it isn't one"""
    try:
        if data.startswith(b"\x89PNG\r\n\x1a\n") and data[12:16] == b"IHDR":
            w, h = struct.unpack(">II", data[16:24])
            return "png", w, h
        if data.startswith(b"\xff\xd8\xff"):
            i = 2
            while i + 4 <= len(data):
                if data[i] != 0xFF:
                    return None
                marker = data[i + 1]
                if marker == 0xFF:
                    i += 1
                    continue
                if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
                    i += 2
                    continue
                if marker in (0xD9, 0xDA):
                    return None   # image data before any size
                length = struct.unpack(">H", data[i + 2:i + 4])[0]
                if length < 2:
                    return None
                if marker in SOF:
                    h, w = struct.unpack(">HH", data[i + 5:i + 9])
                    return "jpeg", w, h
                i += 2 + length
            return None
        if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
            chunk = data[12:16]
            if chunk == b"VP8 " and data[23:26] == b"\x9d\x01\x2a":
                w, h = struct.unpack("<HH", data[26:30])
                return "webp", w & 0x3FFF, h & 0x3FFF
            if chunk == b"VP8L" and data[20] == 0x2F:
                b = data[21:25]
                w = 1 + (b[0] | (b[1] & 0x3F) << 8)
                h = 1 + (b[1] >> 6 | b[2] << 2 | (b[3] & 0x0F) << 10)
                return "webp", w, h
            if chunk == b"VP8X":
                w = 1 + int.from_bytes(data[24:27], "little")
                h = 1 + int.from_bytes(data[27:30], "little")
                return "webp", w, h
    except (struct.error, IndexError):
        return None
    return None


def picture_problem(data):
    """Why bytes aren't a picture the guide shows ("" when they are): PNG,
    JPEG or WebP by their magic, at most 4096 by 4096 and 16 megapixels"""
    info = image_info(data)
    if not info:
        return "isn't a PNG, JPEG or WebP picture"
    _, w, h = info
    if not (0 < w <= MAX_SIDE and 0 < h <= MAX_SIDE) or w * h > MAX_PIXELS:
        return "is bigger than 4096 by 4096 pixels"
    return ""


def image_ok(path):
    with open(path, "rb") as f:
        return not picture_problem(f.read(MAX_ICON + 1))


def check_files(folder, files):
    """What a package holds: app.json, and only the files its kind may have"""
    if "app.json" not in files:
        raise Bad("there's no app.json in it")
    if len(files) > MAX_FILES:
        raise Bad("it has more than " + str(MAX_FILES) + " files")
    path = os.path.join(folder, "app.json")
    if os.path.getsize(path) > MAX_MANIFEST:
        raise Bad("app.json is bigger than 64 KB")
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except (ValueError, UnicodeDecodeError, RecursionError) as e:
        raise Bad("app.json isn't valid JSON: " + str(e)[:100])
    manifest = check_manifest(raw, files)
    allowed = KIND_FILES[manifest["kind"]]
    for name in files:
        if name == "app.json":
            continue
        full = os.path.join(folder, name)
        ext = os.path.splitext(name)[1].lower()
        licence = name in LICENSES
        if not licence and ext not in allowed:
            raise Bad(name + ": a " + manifest["kind"] + " app can't have this kind of file")
        with open(full, "rb") as f:
            head = f.read(4)
        # a .py may start with a #! line (agents add them by habit): it's text
        # the sandbox's Python reads, never a program the kernel runs
        shebang_ok = manifest["kind"] == "app" and ext == ".py"
        if head == b"\x7fELF" or head[:2] == b"MZ" or (head[:2] == b"#!" and not shebang_ok):
            raise Bad(name + " is a program, and apps can't bring programs")
        if ext in IMAGES and not licence:
            if os.path.getsize(full) > MAX_ICON:
                raise Bad(name + " is bigger than 512 KB")
            if not image_ok(full):
                raise Bad(name + " isn't the picture its name says")
        else:
            if licence and os.path.getsize(full) > MAX_LICENSE:
                raise Bad(name + " is bigger than 256 KB")
            with open(full, "rb") as f:
                data = f.read()
            if b"\0" in data:
                raise Bad(name + " isn't text")
            if manifest["kind"] == "app":
                try:
                    data.decode("utf-8")
                except UnicodeDecodeError:
                    raise Bad(name + " isn't valid UTF-8 text")
    return manifest


# ---- unpacking -------------------------------------------------------------

def clean_name(raw):
    """A file's path in a package, or None for the package's own folder"""
    name = raw
    while name.startswith("./"):
        name = name[2:]
    name = name.rstrip("/")
    if name in ("", "."):
        return None
    if name.startswith("/") or "\\" in name or "//" in name:
        raise Bad(raw[:80] + ": not an allowed file name")
    parts = name.split("/")
    if len(parts) - 1 > MAX_DEPTH:
        raise Bad(raw[:80] + ": folders go " + str(MAX_DEPTH) + " deep at most")
    for p in parts:
        if not PART_RE.match(p):
            raise Bad(raw[:80] + ": not an allowed file name (letters, digits, . _ -, no hidden files)")
    return name


class Counter:
    def __init__(self):
        self.total = 0
        self.files = {}

    def add(self, name, src, dest_folder):
        """Copies a stream into dest_folder/name, counting and hashing it"""
        if name in self.files:
            raise Bad(name + " is in it twice")
        if len(self.files) >= MAX_FILES:
            raise Bad("it has more than " + str(MAX_FILES) + " files")
        target = os.path.join(dest_folder, name)
        os.makedirs(os.path.dirname(target), mode=0o755, exist_ok=True)
        h = hashlib.sha256()
        with open(target, "xb") as out:          # never over something already there
            while True:
                chunk = src.read(65536)
                if not chunk:
                    break
                self.total += len(chunk)
                if self.total > MAX_UNPACKED:
                    raise Bad("it's bigger than 20 MB unpacked")
                h.update(chunk)
                out.write(chunk)
        os.chmod(target, 0o644)
        self.files[name] = h.hexdigest()


class Unzipped:
    """The tar in a package's gzip, unpacked as tarfile reads it, a little at
    a time: Bad once it passes MAX_TAR bytes, whatever they're in (tarfile
    reads an extended header whole, and skips what no one reads, so
    counting the files' bytes isn't enough). Only the gzip's first member,
    as tarfile's own r|gz reads it: zlib reads its header (a long name in
    it too) and stops at its end, so a package of a million empty members
    is refused at once, never read through"""

    def __init__(self, raw):
        self.raw, self.z, self.left, self.first = raw, zlib.decompressobj(16 + zlib.MAX_WBITS), MAX_TAR, True

    def read(self, n=-1):
        want = self.left + 1 if n is None or n < 0 else min(n, self.left + 1)
        data = b""
        # (never 0 for want: to zlib that's no limit at all)
        while want and not data and not self.z.eof:
            chunk = self.z.unconsumed_tail or self.raw.read(65536)
            if self.first and chunk[:2] != b"\x1f\x8b":
                raise tarfile.ReadError("not a gzip file")
            self.first = False
            try:
                data = self.z.decompress(chunk, want)
            except zlib.error:
                raise tarfile.ReadError("invalid compressed data") from None
            if not (chunk or data or self.z.eof):
                raise tarfile.ReadError("unexpected end of data")
        self.left -= len(data)
        if self.left < 0:
            raise Bad("it's bigger than 20 MB unpacked")
        return data


EXTENDED = (tarfile.XHDTYPE, tarfile.XGLTYPE, tarfile.SOLARIS_XHDTYPE, tarfile.GNUTYPE_LONGNAME, tarfile.GNUTYPE_LONGLINK)


class Member(tarfile.TarInfo):
    """An entry of a package as tarfile reads it, checked before tarfile
    reads anything of it whole into memory: an extended header (pax
    records, a GNU long name: a block or two in a real package) only while
    the package has room for it, and four in a row at most; a global one
    (its records go into every entry after it) with nothing but a comment
    in it, as git archive writes one; and no sparse file (its map can be
    any size, and apps don't need one)"""

    def _proc_member(self, tf):
        # what a global header said (tarfile keeps it for every entry after
        # it), checked before any of it goes into the next one: a comment
        # changes nothing
        if any(k != "comment" for k in tf.pax_headers):
            raise Bad("it isn't an app package (a .tar.gz): its global header says more than a comment: pack it with om-pg-apps pack")
        if self.type not in EXTENDED:
            return super()._proc_member(tf)
        if self.size < 0:
            raise Bad("it isn't an app package (a .tar.gz): a header in it has a size below zero")
        took = tarfile.BLOCKSIZE * (1 + (self.size + tarfile.BLOCKSIZE - 1) // tarfile.BLOCKSIZE)   # its header and its body
        if took > tf.room:
            raise Bad("it isn't an app package (a .tar.gz): its headers are too big")
        if tf.depth >= 4:
            raise Bad("it isn't an app package (a .tar.gz): it has too many headers in a row")
        tf.room -= took
        tf.depth += 1   # tarfile reads the entry it's for (or another header) before this returns
        try:
            return super()._proc_member(tf)
        finally:
            tf.depth -= 1

    def _sparse(self, *a):
        raise Bad("it isn't an app package (a .tar.gz): it has a sparse file")

    # GNU's sparse files, and pax's three kinds
    _proc_sparse = _proc_gnusparse_00 = _proc_gnusparse_01 = _proc_gnusparse_10 = _sparse


class Package(tarfile.TarFile):
    """A package read with Member, its room for extended headers its own"""
    tarinfo = Member

    def __init__(self, *a, **k):
        self.room, self.depth = MAX_EXTENDED, 0   # before the first entry is read (in __init__)
        super().__init__(*a, **k)


def open_package(raw):
    """A package (a .tar.gz), from a file open to read, read as a stream
    within its caps (Unzipped, Member)"""
    return Package.open(fileobj=Unzipped(raw), mode="r|")


def unpack(package, dest):
    """A .tar.gz, read as a stream within its caps (open_package): nothing
    is extracted that isn't checked first"""
    count = Counter()
    members = 0
    try:
        with open_plain(package) as raw, open_package(raw) as tf:
            for m in tf:
                # every member counts, folders too: a package of empty
                # folders is still a package too big
                members += 1
                if members > MAX_MEMBERS:
                    raise Bad("it has more than " + str(MAX_MEMBERS) + " files and folders")
                name = clean_name(m.name)
                if name is None:
                    if not m.isdir():
                        raise Bad(m.name[:80] + ": not an allowed file name")
                    continue
                if m.isdir():
                    os.makedirs(os.path.join(dest, name), mode=0o755, exist_ok=True)
                    continue
                if not m.isreg():
                    raise Bad(name + ": only plain files and folders are allowed (no links or devices)")
                if m.size > MAX_UNPACKED:
                    raise Bad("it's bigger than 20 MB unpacked")
                count.add(name, tf.extractfile(m), dest)
    # (ValueError: a header with a number tarfile can't read)
    except (tarfile.TarError, EOFError, gzip.BadGzipFile, zlib.error, OSError, ValueError) as e:
        if isinstance(e, FileExistsError):
            raise Bad("it has a file in it twice")
        raise Bad("it isn't an app package (a .tar.gz): " + str(e)[:80])
    return count.files


def copy_folder(src, dest):
    """An app's folder (developer mode): plain files only, hidden ones left out"""
    count = Counter()
    src = os.path.realpath(src)
    for root, dirs, names in os.walk(src, followlinks=False):
        rel_root = os.path.relpath(root, src)
        keep = []
        for d in sorted(dirs):
            if d.startswith(".") or d in ("node_modules", "__pycache__"):
                continue
            if os.path.islink(os.path.join(root, d)):
                raise Bad(os.path.normpath(os.path.join(rel_root, d)) + " is a link, and links aren't allowed")
            keep.append(d)
        dirs[:] = keep
        for n in sorted(names):
            if n.startswith("."):
                continue
            full = os.path.join(root, n)
            name = clean_name(os.path.normpath(os.path.join(rel_root, n)))
            st = os.lstat(full)
            if stat.S_ISLNK(st.st_mode):
                raise Bad(name + " is a link, and links aren't allowed")
            if not stat.S_ISREG(st.st_mode):
                raise Bad(name + " isn't a plain file")
            with open(full, "rb") as f:
                count.add(name, f, dest)
    return count.files


def staged(staging_root):
    """A new private folder to unpack into; ones left from a day ago go"""
    os.makedirs(staging_root, mode=0o700, exist_ok=True)
    os.chmod(staging_root, 0o700)
    for old in os.listdir(staging_root):
        full = os.path.join(staging_root, old)
        if old.startswith("app-") and os.lstat(full).st_mtime < time.time() - 86400:
            remove_tree(full)
    folder = tempfile.mkdtemp(prefix="app-", dir=staging_root)
    os.chmod(folder, 0o700)
    return folder


def sha256_file(path):
    h = hashlib.sha256()
    with open_plain(path, follow=False) as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def tree_sha(files):
    return hashlib.sha256(json.dumps(files, sort_keys=True).encode()).hexdigest()


# ---- the catalog -----------------------------------------------------------

SIGNED = "apps-catalog.signed.json"   # the catalog as it came, with its signature, to check again
PROOF = ("package.tar.gz", "proof.json")   # kept with an app from the catalog


def signers_ok(path):
    try:
        with open(path) as f:
            return any(line.strip() and not line.lstrip().startswith("#") for line in f)
    except OSError:
        return False


def verify_signature(data, sig, signers):
    if not signers_ok(signers):
        raise Untrusted("this guide has no catalog key yet, so no catalog can be trusted")
    fd, sig_path = tempfile.mkstemp(prefix="om-pg-catalog-", suffix=".sig")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(sig)
        r = subprocess.run(["/usr/bin/ssh-keygen", "-Y", "verify", "-f", signers, "-I", PRINCIPAL, "-n", NAMESPACE, "-s", sig_path],
                           input=data, capture_output=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
        raise Bad("couldn't check the catalog's signature: " + str(e)[:80])
    finally:
        try:
            os.unlink(sig_path)
        except OSError:
            pass
    if r.returncode != 0:
        raise Untrusted("the catalog's signature isn't right, so it was refused (it may have been changed)")


def check_entry(e, base):
    """One app in the catalog, checked; Bad if it's not right"""
    if not isinstance(e, dict):
        raise Bad("not an object")
    app_id, version = e.get("id"), e.get("version")
    if not isinstance(app_id, str) or not ID_RE.match(app_id) or not isinstance(version, str) or not VERSION_RE.match(version):
        raise Bad("bad id or version")
    kind = e.get("kind", "launcher")
    if kind != "launcher":
        raise Bad("the catalog offers launchers only")   # apps with code come with the plugin (v1)
    sha, size = e.get("sha256"), e.get("size")
    if not isinstance(sha, str) or not SHA_RE.match(sha) or not isinstance(size, int) or not 0 < size <= MAX_PACKAGE:
        raise Bad("bad sha256 or size")
    color = e.get("color", "")
    out = {
        "id": app_id, "version": version, "kind": kind,
        "name": text(e, "name", 1, 40, app_id), "author": text(e, "author", 1, 60, app_id),
        "description": text(e, "description", 0, 300, app_id, required=False),
        "color": color.lower() if isinstance(color, str) and COLOR_RE.match(color) else "",
        "permissions": check_asks(e.get("permissions"), kind, app_id),
        "package": resolve(base, e.get("package")), "sha256": sha, "size": size,
    }
    if e.get("icon"):
        icon_sha = e.get("iconSha256")
        if isinstance(icon_sha, str) and SHA_RE.match(icon_sha) and os.path.splitext(str(e["icon"]))[1].lower() in IMAGES:
            out["icon"] = resolve(base, e["icon"])
            out["iconSha256"] = icon_sha
    return out


def check_source_entry(e, base):
    """One app in a source's list: a launcher, as the catalog's are, or an
    app with code (its API and permissions checked as its app.json's will be
    when it installs); never one whose name or author says it's Uber TV's
    own, by the rule a source's own name has (lib/appsources.py
    claims_uber_tv: the review, Home and Settings show them, and its
    app.json must say the same, as_listed); Bad if it's not right"""
    if not isinstance(e, dict):
        raise Bad("not an object")
    if e.get("kind", "launcher") != "app":
        out = dict(check_entry(e, base), source=True)
    else:
        app_id, version = e.get("id"), e.get("version")
        if not isinstance(app_id, str) or not ID_RE.match(app_id) or not isinstance(version, str) or not VERSION_RE.match(version):
            raise Bad("bad id or version")
        api = e.get("api")
        if not isinstance(api, int) or isinstance(api, bool) or not 2 <= api <= API:
            raise Bad(app_id + ": an app with code says its api (2 to " + str(API) + ")")
        sha, size = e.get("sha256"), e.get("size")
        if not isinstance(sha, str) or not SHA_RE.match(sha) or not isinstance(size, int) or isinstance(size, bool) or not 0 < size <= MAX_PACKAGE:
            raise Bad("bad sha256 or size")
        color = e.get("color", "")
        out = {
            "id": app_id, "version": version, "kind": "app", "api": api, "source": True,
            "name": text(e, "name", 1, 40, app_id), "author": text(e, "author", 1, 60, app_id),
            "description": text(e, "description", 0, 300, app_id, required=False),
            "color": color.lower() if isinstance(color, str) and COLOR_RE.match(color) else "",
            "permissions": check_app_asks(e.get("permissions"), app_id, api),
            "package": resolve(base, e.get("package")), "sha256": sha, "size": size,
        }
    # (each already cut to 40 or 60 characters: the rule reads every one)
    for k in ("name", "author"):
        if APPFILES().claims_uber_tv(out[k]):
            raise Bad(out["id"] + ": its " + k + " says it's Uber TV's own")
    return out


def as_listed(manifest, entry):
    """app.json (checked) says what its source's list says of the app
    (entry, checked by check_source_entry): the same id, version, kind and
    permissions (and api, for an app with code), and the same name, author,
    description and color, which are what its review showed. Both are tidied
    by the same checks, and source build makes the entry from app.json, so
    an honest list always does"""
    return (manifest["id"] == entry["id"] and manifest["version"] == entry["version"] and manifest["kind"] == entry["kind"]
            and manifest["permissions"] == entry["permissions"] and (entry["kind"] != "app" or manifest.get("api") == entry.get("api"))
            and all(manifest[k] == entry[k] for k in ("name", "author", "description", "color")))


def check_app_release(data):
    """A signed app file's release.json, strictly checked and canonical.

    It carries one catalog-like entry plus the monotonic time, update folder
    and cumulative withdrawals.  Package addresses are deliberately only a
    file name: appnet later resolves that name inside the signed update
    folder's already-checked host.
    """
    bad = "release.json isn't a release Uber TV understands"
    if not isinstance(data, (bytes, bytearray)) or len(data) > MAX_RELEASE:
        raise Bad(bad)
    try:
        raw = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError, RecursionError):
        raise Bad(bad)
    required = {"format", "id", "version", "name", "author", "updated", "kind", "api",
                "permissions", "package", "updates", "revoked"}
    allowed = required | {"description", "color"}
    if not isinstance(raw, dict) or set(raw) - allowed or not required <= set(raw) or raw.get("format") != 1:
        raise Bad(bad)
    app_id, version, kind, api = raw.get("id"), raw.get("version"), raw.get("kind"), raw.get("api")
    if (not isinstance(app_id, str) or not ID_RE.match(app_id) or not isinstance(version, str)
            or not VERSION_RE.match(version) or kind not in ("launcher", "app")
            or not isinstance(api, int) or isinstance(api, bool)):
        raise Bad("release.json has a bad id, version, kind or api")
    if (kind == "launcher" and api != 1) or (kind == "app" and api not in (2, 3, 4)):
        raise Bad("release.json's kind and api don't go together")
    updated = raw.get("updated")
    if not isinstance(updated, int) or isinstance(updated, bool) or not 0 < updated < 2 ** 53:
        raise Bad("release.json.updated must be whole seconds below 2^53")
    package = raw.get("package")
    if not isinstance(package, dict) or set(package) != {"url", "sha256", "size"}:
        raise Bad("release.json.package is { url, sha256, size }")
    sha, size = package.get("sha256"), package.get("size")
    if (not isinstance(sha, str) or not SHA_RE.match(sha) or not isinstance(size, int)
            or isinstance(size, bool) or not 0 < size <= MAX_PACKAGE):
        raise Bad("release.json.package has a bad sha256 or size")
    AF, net = APPFILES(), NET()
    try:
        updates = AF.update_folder(net, raw.get("updates"))
        package_name = package.get("url")
        package_url = AF.package_url(net, updates, package_name)
    except AF.Problem as e:
        raise Bad(str(e))
    entry = {
        "id": app_id, "version": version, "kind": kind, "api": api,
        "name": text(raw, "name", 1, 40, app_id),
        "author": text(raw, "author", 1, 60, app_id),
        "description": text(raw, "description", 0, 300, app_id, required=False),
        "color": "", "permissions": (check_asks(raw.get("permissions"), kind, app_id)
                                          if kind == "launcher" else check_app_asks(raw.get("permissions"), app_id, api)),
        "package": package_url, "packageName": package_name, "sha256": sha, "size": size,
    }
    color = raw.get("color", "")
    if color and (not isinstance(color, str) or not COLOR_RE.match(color)):
        raise Bad(app_id + ": color must be like #e50914")
    entry["color"] = (color or "").lower()
    for key in ("name", "author"):
        if APPFILES().claims_uber_tv(entry[key]):
            raise Bad(app_id + ": its " + key + " says it's Uber TV's own")
    revoked, seen = [], set()
    rows = raw.get("revoked")
    if not isinstance(rows, list) or len(rows) > MAX_REVOKED:
        raise Bad("release.json.revoked must be a list of up to " + str(MAX_REVOKED) + " withdrawals")
    for row in rows:
        if not isinstance(row, dict) or set(row) != {"version", "reason"}:
            raise Bad("a withdrawal is { version, reason }")
        version_ = row.get("version")
        if version_ != "*" and (not isinstance(version_, str) or not VERSION_RE.match(version_)):
            raise Bad("a withdrawn version must be like 1.2.0, or *")
        reason = row.get("reason")
        if (not isinstance(reason, str) or not 1 <= len(reason) <= 200 or not reason.isprintable()
                or any(unicodedata.category(c) in ("Cc", "Cf", "Co", "Cs") for c in reason)):
            raise Bad("a withdrawal reason is 1 to 200 visible characters")
        if version_ in seen:
            raise Bad("release.json withdraws the same version twice")
        seen.add(version_)
        revoked.append({"version": version_, "reason": reason})
    release = dict(entry, format=1, updated=updated, updates=updates, revoked=revoked,
                   package={"url": package_name, "sha256": sha, "size": size})
    release.pop("packageName", None)
    release.pop("sha256", None)
    release.pop("size", None)
    return {"release": release, "entry": entry, "raw": bytes(data), "document": raw}


APP_FILE_MEMBERS = ("key.pub", "release.json", "release.json.sig", "package.tar.gz")
APP_FILE_STATE = "app-file.state"
APP_FILE_STATE_MAX = 2 * MAX_RELEASE + 4 * MAX_SIGNATURE


def read_app_file(path):
    """Read and authenticate one ``.tvapp`` entirely from its opened file.

    The outer file is a bounded plain file opened no-follow.  Its tar has
    exactly the four named regular members; none is extracted by path.
    """
    AF = APPFILES()
    if not isinstance(path, str) or not path.startswith("/"):
        raise Bad("an app file's full path")
    try:
        raw = AF.read_plain(path, MAX_APP_FILE, "the app file")
    except AF.Problem as e:
        raise Bad(str(e))
    limits = {"key.pub": AF.MAX_PUB, "release.json": MAX_RELEASE,
              "release.json.sig": MAX_SIGNATURE, "package.tar.gz": MAX_PACKAGE}
    parts = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:") as archive:
            members = archive.getmembers()
            if len(members) != len(APP_FILE_MEMBERS) or {m.name for m in members} != set(APP_FILE_MEMBERS):
                raise Bad("an app file holds exactly key.pub, release.json, release.json.sig and package.tar.gz")
            for member in members:
                if not member.isreg() or member.size < 0 or member.size > limits[member.name] or member.pax_headers:
                    raise Bad(member.name + " in the app file isn't a plain file of a size Uber TV accepts")
                stream = archive.extractfile(member)
                body = stream.read(limits[member.name] + 1) if stream is not None else b""
                if len(body) != member.size or len(body) > limits[member.name]:
                    raise Bad(member.name + " in the app file can't be read")
                parts[member.name] = body
    except Bad:
        raise
    except (tarfile.TarError, EOFError, OSError, ValueError):
        raise Bad("the app file isn't an uncompressed tar Uber TV can read")
    try:
        line, fingerprint = AF.parse_key(parts["key.pub"])
        AF.verify(parts["release.json"], parts["release.json.sig"], line)
    except AF.Problem as e:
        raise Bad(str(e))
    checked = check_app_release(parts["release.json"])
    entry, package = checked["entry"], parts["package.tar.gz"]
    if len(package) != entry["size"] or hashlib.sha256(package).hexdigest() != entry["sha256"]:
        raise Bad("package.tar.gz isn't the package the signed release names")
    return dict(checked, key=line, fingerprint=fingerprint, source=AF.source_id(line),
                signature=parts["release.json.sig"], package=package)


def version_key(version):
    """A checked three-part version in comparison order."""
    if not isinstance(version, str) or not VERSION_RE.match(version):
        raise Bad("a version is like 1.2.0")
    return tuple(int(part) for part in version.split("."))


def withdrawn(revoked, version):
    """The cumulative withdrawal covering ``version``, if any."""
    return next((row for row in revoked if row["version"] in ("*", version)), None)


def checked_state_revoked(rows):
    """A bounded cumulative withdrawal set kept with one signed app."""
    if not isinstance(rows, list) or len(rows) > MAX_REVOKED:
        raise Bad("the app's kept withdrawals can't be read")
    out, seen = [], set()
    for row in rows:
        if not isinstance(row, dict) or set(row) != {"version", "reason"}:
            raise Bad("the app's kept withdrawals can't be read")
        version, reason = row.get("version"), row.get("reason")
        if (version != "*" and (not isinstance(version, str) or not VERSION_RE.match(version))) or version in seen:
            raise Bad("the app's kept withdrawals can't be read")
        if (not isinstance(reason, str) or not 1 <= len(reason) <= 200 or not reason.isprintable()
                or any(unicodedata.category(c) in ("Cc", "Cf", "Co", "Cs") for c in reason)):
            raise Bad("the app's kept withdrawals can't be read")
        seen.add(version)
        out.append({"version": version, "reason": reason})
    return out


def state_bytes(app, revoked=None):
    """The immutable state directory's one file for an accepted note."""
    rows = checked_state_revoked(list(app["release"]["revoked"]) if revoked is None else revoked)
    body = {
        "format": 1, "key": app["key"], "updated": app["entry"]["updated"] if "updated" in app["entry"] else app["release"]["updated"],
        "noteSha256": hashlib.sha256(app["raw"]).hexdigest(), "data": base64.b64encode(app["raw"]).decode(),
        "sig": base64.b64encode(app["signature"]).decode(), "revoked": rows,
    }
    return (json.dumps(body, sort_keys=True, separators=(",", ":")) + "\n").encode()


def parse_app_state(raw, source="", app_id=""):
    """A state.json checked back to its key and signed release."""
    bad = "the app's kept signed release can't be read"
    if not isinstance(raw, (bytes, bytearray)) or len(raw) > APP_FILE_STATE_MAX:
        raise Bad(bad)
    try:
        state = json.loads(raw.decode("utf-8"))
        if (not isinstance(state, dict) or set(state) != {"format", "key", "updated", "noteSha256", "data", "sig", "revoked"}
                or state.get("format") != 1):
            raise ValueError()
        data = base64.b64decode(state["data"], validate=True)
        sig = base64.b64decode(state["sig"], validate=True)
        line, fingerprint = APPFILES().parse_key(state["key"].encode())
        APPFILES().verify(data, sig, line)
    except (KeyError, TypeError, ValueError, APPFILES().Problem):
        raise Bad(bad)
    checked = check_app_release(data)
    sha = hashlib.sha256(data).hexdigest()
    if (state.get("updated") != checked["release"]["updated"] or state.get("noteSha256") != sha
            or (source and APPFILES().source_id(line) != source) or (app_id and checked["entry"]["id"] != app_id)):
        raise Bad(bad)
    rows = checked_state_revoked(state.get("revoked"))
    have = {row["version"] for row in rows}
    if any(row["version"] not in have for row in checked["release"]["revoked"]):
        raise Bad("the app's kept signed release lost a withdrawal")
    return dict(checked, key=line, fingerprint=fingerprint, signature=sig, state=state,
                revoked=rows, token=hashlib.sha256(raw).hexdigest(), stateRaw=bytes(raw))


def merge_app_state(app, current):
    """Accept ``app`` without rollback, same-time forks or lost withdrawals."""
    new_sha = hashlib.sha256(app["raw"]).hexdigest()
    revoked = list(current["revoked"]) if current else []
    if current:
        old_updated, old_sha = current["release"]["updated"], current["state"]["noteSha256"]
        if app["release"]["updated"] < old_updated or (app["release"]["updated"] == old_updated and new_sha != old_sha):
            raise Bad("that signed release is older than one already accepted (or different at the same time), so it was refused")
    by_version = {row["version"] for row in revoked}
    for row in app["release"]["revoked"]:
        if row["version"] not in by_version:
            revoked.append(row)
            by_version.add(row["version"])
    if len(revoked) > MAX_REVOKED:
        raise Bad("the app has too many kept withdrawals")
    raw = state_bytes(app, revoked)
    return parse_app_state(raw, app["source"], app["entry"]["id"])


def read_app_state(home, source, app_id, missing_ok=False):
    """The state directory under an app home, without following any link."""
    path = os.path.join(home, APP_FILE_STATE)
    if not os.path.lexists(path):
        if missing_ok:
            return None
        raise Bad("the app's kept signed release is gone")
    try:
        if not stat.S_ISDIR(os.lstat(path).st_mode):
            raise Bad("the app's kept signed release was changed")
        with open_plain(os.path.join(path, "state.json"), follow=False) as stream:
            raw = stream.read(APP_FILE_STATE_MAX + 1)
        if len(raw) > APP_FILE_STATE_MAX:
            raise Bad("the app's kept signed release is too big")
    except OSError:
        raise Bad("the app's kept signed release can't be read")
    return parse_app_state(raw, source, app_id)


def current_installed_version(home):
    """The one installed version in an app home, or none."""
    try:
        versions = [name for name in os.listdir(home) if VERSION_RE.match(name) and stat.S_ISDIR(os.lstat(os.path.join(home, name)).st_mode)]
    except FileNotFoundError:
        return None
    if not versions:
        return None
    return max(versions, key=version_key)


def app_snapshot(source, app_id, current, candidate):
    return {"format": 1, "source": source, "id": app_id,
            "current": current["token"] if current else "", "candidate": candidate["token"]}


def read_app_snapshot(folder):
    bad = Bad("what the signed app was reviewed against is gone: look again")
    try:
        with open_plain(os.path.join(folder, "app-file.json"), follow=False) as stream:
            raw = stream.read(4097)
        snap = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, ValueError, RecursionError):
        raise bad
    if (not isinstance(snap, dict) or set(snap) != {"format", "source", "id", "current", "candidate"}
            or snap.get("format") != 1 or not isinstance(snap.get("source"), str) or not SOURCE_RE.match(snap["source"])
            or not snap["source"].startswith("app:") or not isinstance(snap.get("id"), str) or not ID_RE.match(snap["id"])
            or not isinstance(snap.get("current"), str) or (snap["current"] and not SHA_RE.match(snap["current"]))
            or not isinstance(snap.get("candidate"), str) or not SHA_RE.match(snap["candidate"])):
        raise bad
    return snap


def do_app_inspect(path, staging_root, apps_root):
    """Authenticate a picked ``.tvapp`` and stage exactly those bytes."""
    app = read_app_file(path)
    entry, source = app["entry"], app["source"]
    held = lock_apps(apps_root)
    try:
        home = os.path.join(apps_root, source_dir(source), entry["id"])
        installed = current_installed_version(home)
        state_exists = os.path.lexists(os.path.join(home, APP_FILE_STATE))
        current = read_app_state(home, source, entry["id"], missing_ok=not state_exists and installed is None)
        candidate = merge_app_state(app, current)
        if installed and version_key(entry["version"]) < version_key(installed):
            raise Bad("that app file is older than the installed version")
        pulled = withdrawn(candidate["revoked"], entry["version"])
        if pulled:
            raise Bad("the developer withdrew this version: " + pulled["reason"])
        snapshot = app_snapshot(source, entry["id"], current, candidate)
    finally:
        os.close(held)
    folder = staged(staging_root)
    files_dir = os.path.join(folder, "files")
    os.mkdir(files_dir, 0o755)
    try:
        pkg = os.path.join(folder, "package.tar.gz")
        with open(pkg, "xb") as stream:
            stream.write(app["package"])
        files = unpack(pkg, files_dir)
        manifest = check_files(files_dir, files)
        if not as_listed(manifest, entry):
            raise Bad("the app isn't what its signed release says it is, so it was refused")
        proof = {"type": "appFile", "key": app["key"], "data": base64.b64encode(app["raw"]).decode(),
                 "sig": base64.b64encode(app["signature"]).decode()}
        write_json(os.path.join(folder, "proof.json"), proof)
        state_dir = os.path.join(folder, APP_FILE_STATE)
        os.mkdir(state_dir, 0o700)
        with open(os.path.join(state_dir, "state.json"), "xb") as stream:
            stream.write(candidate["stateRaw"])
        write_json(os.path.join(folder, "app-file.json"), snapshot)
    except BaseException:
        remove_tree(folder)
        raise
    return {"ok": True, "staging": folder, "manifest": manifest, "files": files, "tree": tree_sha(files),
            "sha256": entry["sha256"], "source": "appFile", "sourceName": "Signed app file", "sourceId": source,
            "keyFingerprint": app["fingerprint"], "updated": entry["updated"] if "updated" in entry else app["release"]["updated"],
            "updates": app["release"]["updates"] or ""}


def read_staged_app_state(folder, source, app_id):
    try:
        with open_plain(os.path.join(folder, APP_FILE_STATE, "state.json"), follow=False) as stream:
            raw = stream.read(APP_FILE_STATE_MAX + 1)
    except OSError:
        raise Bad("the signed release that was reviewed is gone: look again")
    if len(raw) > APP_FILE_STATE_MAX:
        raise Bad("the signed release that was reviewed is too big: look again")
    return parse_app_state(raw, source, app_id)


def staged_plain(folder, name, limit, what):
    try:
        with open_plain(os.path.join(folder, name), follow=False) as stream:
            data = stream.read(limit + 1)
    except OSError:
        raise Bad(what + " is gone: look again")
    if len(data) > limit:
        raise Bad(what + " is too big: look again")
    return data


def check_app_install_snapshot(folder, hfd, source, manifest, files):
    """Under the apps lock, bind a signed install to its reviewed state."""
    snap = read_app_snapshot(folder)
    if snap["source"] != source or snap["id"] != manifest["id"]:
        raise Bad("the signed app was reviewed for something else: look again")
    candidate = read_staged_app_state(folder, source, manifest["id"])
    if candidate["token"] != snap["candidate"] or candidate["entry"]["version"] != manifest["version"]:
        raise Bad("the signed release changed while it waited: look again")
    here = "/proc/self/fd/%d" % hfd
    exists = os.path.lexists(os.path.join(here, APP_FILE_STATE))
    current = read_app_state(here, source, manifest["id"], missing_ok=not exists)
    if current is None and current_installed_version(here) is not None:
        raise Bad("the app's kept signed release is gone: look again")
    now = current["token"] if current else ""
    if now != snap["current"]:
        raise Bad("another signed release was accepted while this waited: look again")
    if current:
        # Re-evaluate the monotonic and cumulative rules from the bytes on
        # disk; the snapshot alone is never trusted to describe them.
        merged = merge_app_state({"raw": candidate["raw"], "release": candidate["release"],
                                  "entry": candidate["entry"], "key": candidate["key"],
                                  "signature": candidate["signature"], "source": source}, current)
        if merged["token"] != candidate["token"]:
            raise Bad("the signed release no longer carries every withdrawal: look again")
    pulled = withdrawn(candidate["revoked"], manifest["version"])
    if pulled:
        raise Bad("the developer withdrew this version: " + pulled["reason"])
    proof_raw = staged_plain(folder, "proof.json", MAX_CATALOG * 2, "the signed proof that was reviewed")
    package = staged_plain(folder, "package.tar.gz", MAX_PACKAGE, "the package that was reviewed")
    try:
        proof = json.loads(proof_raw.decode("utf-8"))
        if not isinstance(proof, dict) or set(proof) != {"type", "key", "data", "sig"} or proof.get("type") != "appFile":
            raise ValueError()
        data = base64.b64decode(proof["data"], validate=True)
        sig = base64.b64decode(proof["sig"], validate=True)
    except (UnicodeDecodeError, ValueError, TypeError, KeyError, RecursionError):
        raise Bad("the signed proof changed while it waited: look again")
    if (proof["key"] != candidate["key"] or data != candidate["raw"] or sig != candidate["signature"]
            or len(package) != candidate["entry"]["size"]
            or hashlib.sha256(package).hexdigest() != candidate["entry"]["sha256"]
            or package_tree(package) != files):
        raise Bad("the signed proof or package changed while it waited: look again")
    return candidate, {"proof.json": hashlib.sha256(proof_raw).hexdigest(),
                       "package.tar.gz": hashlib.sha256(package).hexdigest()}


def installed_app_state(held, apps_root, source, app_id):
    """An installed signed app and its accepted state, under the apps lock."""
    if not isinstance(source, str) or not source.startswith("app:") or not SOURCE_RE.match(source):
        raise Bad("not a signed app file's origin")
    if not isinstance(app_id, str) or not ID_RE.match(app_id):
        raise Bad("not an app's id")
    sdir = source_dir(source)
    try:
        hfd = open_in(held, sdir + "/" + app_id)
    except OSError:
        raise Bad("that signed app isn't installed")
    try:
        home = "/proc/self/fd/%d" % hfd
        version = current_installed_version(home)
        if version is None:
            raise Bad("that signed app isn't installed")
        state = read_app_state(home, source, app_id)
        folder, proof = os.path.join(home, version), os.path.join(home, version + ".proof")
        files = tree_of(folder, "a link was put in its files")
        kind, blob = proof_source(proof)
        if kind != "appFile":
            raise Bad("that isn't an installed signed app file")
        entry, _, _ = check_app_file_proof(home, proof, blob, app_id, version, files, sdir, allow_revoked=True)
        manifest = check_files(folder, files)
        if not as_listed(manifest, entry):
            raise Bad("the installed app isn't what its signed release says it is")
        return hfd, home, version, state
    except BaseException:
        os.close(hfd)
        raise


def update_review(source, app_id, installed, state):
    entry = state["entry"]
    return {"format": 1, "source": source, "id": app_id, "installed": installed,
            "state": state["token"], "updated": state["release"]["updated"],
            "version": entry["version"], "size": entry["size"], "url": entry["package"] or "",
            "fingerprint": state["fingerprint"], "entry": entry}


def replace_app_state(hfd, state):
    """Commit a verified newer state by one exchange under the apps lock."""
    here, tag = "/proc/self/fd/%d" % hfd, secrets.token_hex(6)
    final = os.path.join(here, APP_FILE_STATE)
    new = os.path.join(here, ".new-state-" + tag)
    trash = {"path": os.path.join(here, ".trash-state-" + tag), "fd": None, "ino": None,
             "tried": False, "maybe": False, "stuck": []}
    made, own = {}, {}
    committed = False
    try:
        trash_fd(trash)
        dst = new_folder(new, made)
        try:
            own[new] = set()
            write_at(dst, "state.json", state["stateRaw"])
            fd = os.open("state.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dst)
            try:
                own[new].add(fd_ino(fd))
            finally:
                os.close(fd)
            seal(dst, {"state.json": state["token"]}, set(), own[new])
        finally:
            os.close(dst)
        old, fresh = inode(final), made[new]
        if old is None:
            raise Bad("the app's kept signed release is gone")
        try:
            swap_own(new, final, fresh, old)
        except BaseException as error:
            # A signal can arrive after the exchange but before Python sees
            # its return.  What is on disk decides whether it committed.
            if inode(final) == fresh and inode(new) == old:
                committed = True
            else:
                raise error
        else:
            committed = True
        warning = []
        try:
            taken = take_own(new, old, trash)
            if not wipe_own(trash["fd"], taken, old, None):
                warning.append("the previous signed-release state")
        except OSError:
            warning.append("the previous signed-release state")
        warning += [sentence(word) for word in end_trash(trash, here)]
        return " ".join(warning)
    except BaseException as error:
        if committed or inode(final) == made.get(new):
            return "The newer signed release was accepted, but its previous state couldn't be tidied."
        left = taken_back(made, own, {new: APP_FILE_STATE}, here, trash)
        if left:
            raise Bad("the signed release wasn't accepted, but taking away what it made didn't finish:" + "".join(left))
        if isinstance(error, Bad):
            raise
        raise Bad("the signed release wasn't accepted (" + said_of(error) + "), so nothing changed")
    finally:
        if trash["fd"] is not None:
            os.close(trash["fd"])


def do_app_update_check(apps_root, source, app_id):
    """Fetch and accept only a signed release note, never its package."""
    held = lock_apps(apps_root)
    try:
        hfd, _, installed, before = installed_app_state(held, apps_root, source, app_id)
        try:
            start = before["token"]
            base, line = before["release"]["updates"], before["key"]
        finally:
            os.close(hfd)
    finally:
        os.close(held)
    if base is None:
        raise Bad("this app doesn't have an update address")
    net, AF = NET(), APPFILES()
    host = net.parse_url(base).host
    try:
        data = AF.get(net, base + "release.json", host, MAX_RELEASE, "the app's release note")
        sig = AF.get(net, base + "release.json.sig", host, MAX_SIGNATURE, "the app's release signature")
        AF.verify(data, sig, line)
    except (AF.Problem, net.NetError) as e:
        raise Bad(str(e))
    checked = check_app_release(data)
    if checked["entry"]["id"] != app_id or AF.source_id(line) != source:
        raise Bad("the signed release is for another app")
    if version_key(checked["entry"]["version"]) < version_key(installed):
        raise Bad("the signed release names an older app version, so it was refused")
    candidate_app = dict(checked, key=line, signature=sig, source=source)
    held = lock_apps(apps_root)
    try:
        hfd, _, now_version, current = installed_app_state(held, apps_root, source, app_id)
        try:
            if current["token"] != start or now_version != installed:
                raise Bad("the app changed while its update was checked: check again")
            candidate = merge_app_state(candidate_app, current)
            warning = ""
            if candidate["token"] != current["token"]:
                warning = replace_app_state(hfd, candidate)
        finally:
            os.close(hfd)
    finally:
        os.close(held)
    pulled = withdrawn(candidate["revoked"], installed)
    update = candidate["entry"] if version_key(candidate["entry"]["version"]) > version_key(installed) else None
    out = {"ok": True, "checked": int(time.time()), "review": update_review(source, app_id, installed, candidate),
           "update": update, "revoked": pulled}
    if warning:
        out["warning"] = warning
    return out


def parse_update_review(raw):
    if not isinstance(raw, (bytes, bytearray)) or len(raw) > 64 * 1024:
        raise Bad("that isn't the update review you agreed to")
    try:
        review = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError, RecursionError):
        raise Bad("that isn't the update review you agreed to")
    return review


def do_app_update_prepare(raw, apps_root, source, app_id, staging_root):
    """After consent, fetch and stage exactly the reviewed package."""
    review = parse_update_review(raw)
    held = lock_apps(apps_root)
    try:
        hfd, _, installed, state = installed_app_state(held, apps_root, source, app_id)
        os.close(hfd)
        if review != update_review(source, app_id, installed, state):
            raise Bad("the signed release changed since you reviewed it: look again")
        entry = state["entry"]
        if version_key(entry["version"]) <= version_key(installed):
            raise Bad("that release isn't a newer version")
        pulled = withdrawn(state["revoked"], entry["version"])
        if pulled:
            raise Bad("the developer withdrew this version: " + pulled["reason"])
        start = state["token"]
    finally:
        os.close(held)
    if not entry["package"]:
        raise Bad("the signed release has no update package address")
    net, AF = NET(), APPFILES()
    host = net.parse_url(state["release"]["updates"]).host
    try:
        package = AF.get(net, entry["package"], host, MAX_PACKAGE, "the app update", AF.PACKAGE_SECONDS)
    except (AF.Problem, net.NetError) as e:
        raise Bad(str(e))
    if len(package) != entry["size"] or hashlib.sha256(package).hexdigest() != entry["sha256"]:
        raise Bad("the download isn't the package the signed release names, so it was refused")
    folder = staged(staging_root)
    files_dir = os.path.join(folder, "files")
    os.mkdir(files_dir, 0o755)
    try:
        with open(os.path.join(folder, "package.tar.gz"), "xb") as stream:
            stream.write(package)
        files = unpack(os.path.join(folder, "package.tar.gz"), files_dir)
        manifest = check_files(files_dir, files)
        if not as_listed(manifest, entry):
            raise Bad("the app isn't what its signed release says it is, so it was refused")
        write_json(os.path.join(folder, "proof.json"), {"type": "appFile", "key": state["key"],
                   "data": base64.b64encode(state["raw"]).decode(), "sig": base64.b64encode(state["signature"]).decode()})
        os.mkdir(os.path.join(folder, APP_FILE_STATE), 0o700)
        with open(os.path.join(folder, APP_FILE_STATE, "state.json"), "xb") as stream:
            stream.write(state["stateRaw"])
        write_json(os.path.join(folder, "app-file.json"), app_snapshot(source, app_id, state, state))
        held = lock_apps(apps_root)
        try:
            hfd, _, now_version, current = installed_app_state(held, apps_root, source, app_id)
            os.close(hfd)
            if current["token"] != start or now_version != installed:
                raise Bad("the app changed while its update was downloaded: look again")
        finally:
            os.close(held)
    except BaseException:
        remove_tree(folder)
        raise
    return {"ok": True, "staging": folder, "manifest": manifest, "files": files, "tree": tree_sha(files),
            "sha256": entry["sha256"], "source": "appFile", "sourceName": "Signed app file", "sourceId": source,
            "keyFingerprint": state["fingerprint"], "updated": state["release"]["updated"],
            "updates": state["release"]["updates"] or ""}


def do_app_current(folder, staging_root, apps_root):
    """A staged signed app is still bound to the accepted state reviewed."""
    if not inside(folder, staging_root) or not os.path.basename(folder).startswith("app-") or os.path.islink(folder):
        raise Bad("nothing waiting to be installed there")
    snap = read_app_snapshot(folder)
    held = lock_apps(apps_root)
    try:
        if not snap["current"]:
            home = os.path.join(apps_root, source_dir(snap["source"]), snap["id"])
            if current_installed_version(home) is not None or os.path.lexists(os.path.join(home, APP_FILE_STATE)):
                raise Bad("the signed app changed since you reviewed it: look again")
        else:
            hfd, _, _, current = installed_app_state(held, apps_root, snap["source"], snap["id"])
            os.close(hfd)
            if current["token"] != snap["current"]:
                raise Bad("the signed release changed since you reviewed it: look again")
    finally:
        os.close(held)
    return {"ok": True}


def get_icon(entry, folder):
    """The icon, checked against its SHA-256, kept by its SHA-256"""
    ext = os.path.splitext(entry["icon"].split("?")[0])[1].lower()
    path = os.path.join(folder, entry["iconSha256"] + ext)
    if os.path.isfile(path):
        return path
    data = fetch(entry["icon"], MAX_ICON, "an icon", 30)
    if hashlib.sha256(data).hexdigest() != entry["iconSha256"]:
        raise Bad("an icon isn't the one the catalog lists")
    fd, tmp = tempfile.mkstemp(dir=folder)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    if not image_ok(tmp):
        os.unlink(tmp)
        raise Bad("an icon isn't a picture")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return path


def pulled(revoked, app_id, version):
    """The catalog's revocation of this app at this version, if it has one"""
    return next((r for r in revoked if r["id"] == app_id and r["version"] in ("*", version)), None)


def parse_catalog(data, source, seen, entry_of=None):
    """A catalog whose signature is good, read and checked: the newest of
    each app (pulled versions left out) and the revocations. entry_of: how
    each entry is checked (a source's list: check_source_entry)"""
    try:
        cat = json.loads(data.decode("utf-8"))
    except (ValueError, UnicodeDecodeError, RecursionError):
        raise Bad("the catalog isn't valid JSON")
    if not isinstance(cat, dict) or cat.get("format") != 1:
        raise Bad("the catalog is a kind this guide doesn't read (format " + str(cat.get("format") if isinstance(cat, dict) else "?") + ")")
    updated = cat.get("updated")
    if not isinstance(updated, int) or isinstance(updated, bool) or not 0 < updated < 2 ** 53:
        raise Bad("the catalog doesn't say when it was made")
    if updated < seen:
        raise Bad("this catalog is older than one the guide has already seen, so it was refused")
    listed, pulls = cat.get("apps", []), cat.get("revoked", [])
    if not isinstance(listed, list) or not isinstance(pulls, list):
        raise Bad("the catalog's apps and revoked must be lists, so it was refused")
    revoked = []
    for r in pulls:
        # a revocation it can't read could be the one that matters
        if not (isinstance(r, dict) and isinstance(r.get("id"), str) and ID_RE.match(r["id"]) and isinstance(r.get("version"), str)
                and (r["version"] == "*" or VERSION_RE.match(r["version"]))):
            raise Bad("the catalog has a revocation this guide can't read, so it was refused")
        reason = r.get("reason") if isinstance(r.get("reason"), str) else ""
        revoked.append({"id": r["id"], "version": r["version"], "reason": "".join(c for c in reason if c.isprintable())[:200]})
    apps, skipped = {}, 0
    for e in listed[:MAX_CATALOG_APPS]:
        try:
            entry = (entry_of or check_entry)(e, source)
        except Bad:
            skipped += 1
            continue
        if pulled(revoked, entry["id"], entry["version"]):
            continue
        have = apps.get(entry["id"])
        if not have or [int(x) for x in entry["version"].split(".")] > [int(x) for x in have["version"].split(".")]:
            apps[entry["id"]] = entry
    name = cat.get("name") if isinstance(cat.get("name"), str) else "The catalog"
    return {"name": name[:60], "updated": updated, "apps": apps, "revoked": revoked, "skipped": skipped}


def write_json(path, obj):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, separators=(",", ":"))
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def signed_blob(source, data, sig):
    return {"source": source, "data": base64.b64encode(data).decode(), "sig": base64.b64encode(sig).decode()}


def read_signed(path, missing):
    """A catalog kept as it came: (where it came from, its bytes, its signature)"""
    try:
        with open_plain(path) as f:
            blob = json.loads(f.read(MAX_CATALOG * 2).decode("utf-8"))
        return str(blob["source"]), base64.b64decode(blob["data"], validate=True), base64.b64decode(blob["sig"], validate=True)
    except (OSError, ValueError, KeyError, TypeError):
        raise Bad(missing)


def do_catalog(source, signers, seen, cache):
    if not (source.startswith("https://") or source.startswith("/")):
        raise Bad("the catalog must be an https link (or a file on this computer)")
    os.makedirs(cache, mode=0o700, exist_ok=True)
    data = fetch(source, MAX_CATALOG, "the catalog")
    sig = fetch(source + ".sig", MAX_SIGNATURE, "the catalog's signature")
    verify_signature(data, sig, signers)
    cat = parse_catalog(data, source, seen)
    icons = os.path.join(cache, "app-icons")
    os.makedirs(icons, mode=0o700, exist_ok=True)
    for entry in cat["apps"].values():
        if "icon" in entry:
            try:
                entry["iconFile"] = get_icon(entry, icons)
            except Bad:
                pass
    kept = {"source": source, "name": cat["name"], "updated": cat["updated"], "fetched": int(time.time()),
            "apps": sorted(cat["apps"].values(), key=lambda a: a["name"].lower()), "revoked": cat["revoked"], "skipped": cat["skipped"]}
    # as it came, so an install checks the signature again instead of
    # trusting what's kept here for the guide to show
    write_json(os.path.join(cache, SIGNED), signed_blob(source, data, sig))
    write_json(os.path.join(cache, "apps-catalog.json"), kept)
    return {"ok": True, "catalog": kept}


# ---- inspecting, installing, removing --------------------------------------

def do_inspect(source, staging_root):
    if not isinstance(source, dict):
        raise Bad("bad request")
    folder = staged(staging_root)
    files_dir = os.path.join(folder, "files")
    os.mkdir(files_dir, 0o755)
    try:
        if source.get("type") == "catalog":
            app_id = source.get("id")
            try:
                seen = int(source.get("seen") or 0)
            except (TypeError, ValueError):
                seen = 0
            where, data, sig = read_signed(os.path.join(str(source.get("cache") or ""), SIGNED), "the catalog needs getting again (open Get apps)")
            verify_signature(data, sig, str(source.get("signers") or ""))
            cat = parse_catalog(data, where, seen)
            entry = cat["apps"].get(app_id) if isinstance(app_id, str) else None
            if not entry:
                if any(r["id"] == app_id for r in cat["revoked"]):
                    raise Bad("the catalog pulled it")
                raise Bad("that app isn't in the catalog")
            package = fetch(entry["package"], MAX_PACKAGE, "the app")
            sha = hashlib.sha256(package).hexdigest()
            if sha != entry["sha256"] or len(package) != entry["size"]:
                raise Bad("the download isn't the app the catalog lists (it may have been changed), so it was refused")
            pkg = os.path.join(folder, "package.tar.gz")
            with open(pkg, "wb") as f:
                f.write(package)
            files = unpack(pkg, files_dir)
            manifest = check_files(files_dir, files)
            if manifest["id"] != entry["id"] or manifest["version"] != entry["version"] or manifest["permissions"] != entry["permissions"]:
                raise Bad("the app isn't what the catalog says it is, so it was refused")
            # kept with the app: the package and the signed catalog listing it,
            # so it can be traced back to the catalog every time it's checked
            write_json(os.path.join(folder, "proof.json"), signed_blob(where, data, sig))
            from_, name = "catalog", cat["name"]
        elif source.get("type") == "bundled":
            # a first-party app shipped inside the plugin (the reviewed commit)
            app_id = source.get("id")
            if not isinstance(app_id, str) or not ID_RE.match(app_id):
                raise Bad("not an app's id")
            path = os.path.join(str(source.get("plugin") or ""), "apps", "first-party", app_id)
            if not os.path.isdir(path) or os.path.islink(path):
                raise Bad("the guide doesn't come with that app")
            files = copy_folder(path, files_dir)
            sha = tree_sha(files)
            manifest = check_files(files_dir, files)
            if manifest["id"] != app_id:
                raise Bad("that app's app.json isn't its own")
            from_, name = "bundled", "Uber TV"
        elif source.get("type") == "file":
            path = source.get("path")
            if not isinstance(path, str) or not path.startswith("/"):
                raise Bad("a file's full path")
            if os.path.basename(path) == "app.json":
                path = os.path.dirname(path)
            if os.path.isdir(path):
                files = copy_folder(path, files_dir)
                sha = tree_sha(files)
            elif os.path.isfile(path):
                if os.path.getsize(path) > MAX_PACKAGE:
                    raise Bad("it's bigger than 20 MB")
                files = unpack(path, files_dir)
                sha = sha256_file(path)
            else:
                raise Bad("there's no such file or folder")
            manifest = check_files(files_dir, files)
            from_, name = "file", path
        else:
            raise Bad("bad request")
    except BaseException:
        remove_tree(folder)
        raise
    return {"ok": True, "staging": folder, "manifest": manifest, "files": files, "tree": tree_sha(files), "sha256": sha,
            "source": from_, "sourceName": name}






def still_current(folder, store, source, locked=False):
    """A staged app from one of your sources still what its review was for
    (lib/appsources.py current): its snapshot read from the staging, for that
    source, the source unchanged since (locked: the caller holds the store's
    lock). Bad if not"""
    S = SOURCES()
    try:
        with open_plain(os.path.join(folder, "snapshot.json"), follow=False) as f:
            raw = f.read(S.MAX_SNAPSHOT + 1)
        snap = S.snapshot_of(raw)
    except (OSError, Bad, S.Problem):
        raise Bad("what it was got ready for is gone: look again")
    if snap["source"] != source:
        raise Bad("it was got ready for another source")
    try:
        S.current(store, snap, locked)
    except S.Problem as e:
        raise Bad(str(e))


def remove_tree(path):
    """Deletes a folder, read-only parts too (never following links)"""
    if not os.path.lexists(path):
        return
    if os.path.islink(path) or not os.path.isdir(path):
        os.unlink(path)
        return
    for root, dirs, names in os.walk(path, followlinks=False):
        os.chmod(root, 0o700)
        for d in dirs:
            full = os.path.join(root, d)
            if not os.path.islink(full):
                os.chmod(full, 0o700)
    shutil.rmtree(path)


def inside(path, root):
    return os.path.realpath(path).startswith(os.path.realpath(root) + os.sep)


def tree_of(folder, link, folders=None, inodes=None):
    """Each plain file in a folder and its SHA-256: a link (or anything but
    folders and plain files) is Bad, with link saying so (and each folder in
    it put in folders, if that's given). If inodes is given, each folder's
    and file's (device, inode) is put in it, a file's from the very
    descriptor hashed, and no more is read than an app can hold"""
    files, room = {}, [0, MAX_UNPACKED]
    for root, dirs, names in os.walk(folder, followlinks=False):
        for d in dirs:
            if os.path.islink(os.path.join(root, d)):
                raise Bad(link)
            if folders is not None:
                folders.add(os.path.relpath(os.path.join(root, d), folder))
            if inodes is not None:
                st = os.lstat(os.path.join(root, d))
                inodes.add((st.st_dev, st.st_ino))
        for n in names:
            full = os.path.join(root, n)
            mode = os.lstat(full).st_mode
            if stat.S_ISLNK(mode):
                raise Bad(link)
            if not stat.S_ISREG(mode):
                raise Bad("something that isn't a file was put in its files")
            if inodes is None:
                files[os.path.relpath(full, folder)] = sha256_file(full)
                continue
            with open_plain(full, follow=False) as f:
                files[os.path.relpath(full, folder)] = sha256_fd(f.fileno(), room)
                st = os.fstat(f.fileno())
            inodes.add((st.st_dev, st.st_ino))
    return files


def ensure_dir(path, mode=0o755):
    """A plain folder (never a link), made if missing"""
    if os.path.lexists(path):
        if not stat.S_ISDIR(os.lstat(path).st_mode):
            raise Bad("its place in the apps folder isn't a plain folder, so nothing was installed")
    else:
        os.mkdir(path, mode)


def do_install(folder, apps_root, data_root, tree, source, store=""):
    files_dir = os.path.join(folder, "files")
    if not os.path.basename(folder).startswith("app-") or os.path.islink(folder) or os.path.islink(files_dir) or not os.path.isdir(files_dir):
        raise Unchanged("nothing waiting to be installed there")
    if source.startswith("source:"):
        # from one of your sources: still what its review was for, checked
        # and put in place as one, under your sources' lock, so no fetch, key
        # change or removal lands between the check and the commit
        if not store:
            raise Unchanged("an app from one of your sources installs only with your sources")
        with SOURCES().held(store):
            try:
                still_current(folder, store, source, locked=True)
            except Bad as e:
                raise Unchanged(str(e))
            return install_tree(folder, files_dir, apps_root, tree, source)
    return install_tree(folder, files_dir, apps_root, tree, source)


def install_tree(folder, files_dir, apps_root, tree, source):
    """A checked, staged tree put in place as one step, one install or
    removal at a time (the apps folder held: lock_apps).

    The new version and its proof are made beside what's there, under names
    no version has, each written down the moment it's made by the inode of a
    folder held open that's provably its own (the staged one moved there, or
    one it made and found empty), then filled, checked to be exactly the
    files you were shown and made read-only through that descriptor, never
    through a name that could have been swapped. Then they're swapped in:
    before each rename, what it will do is written down with the inode of
    what it moves, and each rename is one that can't destroy anything
    (exchanged with what's at the name, so it's never without one, or moved
    to a name with nothing at it), checked right after: what moved, if it
    isn't its own, goes straight back. Whatever stops the swap (an error,
    Ctrl-C) is undone the same way, from what's actually on disk, each step
    tried twice, then every name checked. Its own copies are only ever taken
    away into a private folder beside them (made before anything else, so
    that needs no new room, and held open), checked there to be exactly
    what it made, and only what's its own in them is deleted there.
    Only a checked undo, or a make whose copies all went that way, says
    nothing changed (Unchanged); otherwise the error says what's where. Once
    both are in, it's installed: tidying away the old versions (only names a
    version has, and what it put aside itself) and the staging can only add
    a warning, never deny the install."""
    try:
        folders, known = set(), set()
        files = tree_of(files_dir, "something changed while it waited", folders, known)
        # what you saw in the review, and nothing else (and no more folders
        # than its files could be in)
        if tree_sha(files) != tree or len(folders) > MAX_MEMBERS + MAX_FILES * MAX_DEPTH:
            raise Bad("it changed while it waited, so it wasn't installed")
        manifest = check_files(files_dir, files)
        sdir = source_dir(source)
        held = lock_apps(apps_root)
    except Bad as e:
        raise Unchanged(str(e))
    except OSError as e:
        raise Unchanged("it couldn't be installed (" + said_of(e) + "), so nothing changed")
    try:
        return put_in(folder, files_dir, apps_root, held, sdir, manifest, files, folders, known, source)
    finally:
        os.close(held)


def put_in(folder, files_dir, apps_root, held, sdir, manifest, files, folders, known, source):
    """install_tree's steps, the apps folder held (held: its descriptor)"""
    try:
        hfd = below(held, sdir, manifest["id"])   # the app's folder, made if missing: never a link followed
    except Bad as e:
        raise Unchanged(str(e))
    except OSError as e:
        raise Unchanged("it couldn't be installed (" + said_of(e) + "), so nothing changed")
    try:
        return put_in_held(folder, files_dir, hfd, os.path.join(apps_root, sdir, manifest["id"]), sdir, manifest, files, folders, known, source)
    finally:
        os.close(hfd)


def put_in_held(folder, files_dir, hfd, home, sdir, manifest, files, folders, known, source):
    """put_in's steps, the app's folder held (hfd) and worked in through that
    descriptor (/proc/self/fd), whatever comes to be at its name (home, for
    the words and the answer)"""
    here = "/proc/self/fd/%d" % hfd
    try:
        os.stat(here)
    except OSError as e:
        raise Unchanged("it couldn't be installed (" + said_of(e) + "), so nothing changed")
    version = manifest["version"]
    target = os.path.join(here, version)
    proof = target + ".proof"
    tag = secrets.token_hex(6)
    new_target, new_proof = os.path.join(here, ".new-" + tag), os.path.join(here, ".new-" + tag + ".proof")
    state = os.path.join(here, APP_FILE_STATE)
    new_state = os.path.join(here, ".new-" + tag + ".state")
    app_file = source.startswith("app:")
    named = {new_target: version, new_proof: version + ".proof"}
    if app_file:
        named[new_state] = APP_FILE_STATE
    # its private folder, held open (trash_fd)
    trash = {"path": os.path.join(here, ".trash-" + tag), "fd": None, "ino": None, "tried": False, "maybe": False, "stuck": []}
    # Signed app files, the catalog and old-style sources always carry
    # proof. Developer mode's unsigned file lineage and bundled apps do not.
    proved = source.startswith(("catalog:", "source:")) or app_file
    made, own = {}, {}   # its own new copies, each by its inode, written down as it's made; and what's its own in each
    try:
        try:
            trash_fd(trash)   # (made first, so taking back and tidying need no new room: a full disk)
        except BaseException as e:
            said = end_trash(trash, home)
            if said:
                raise Bad("it couldn't be installed (" + said_of(e) + "):" + "".join(said))
            if isinstance(e, OSError):
                raise Unchanged("it couldn't be installed (" + said_of(e) + "), so nothing changed")
            raise
        try:
            checked_app = check_app_install_snapshot(folder, hfd, source, manifest, files) if app_file else None
            candidate, proof_expected = checked_app if checked_app else (None, None)
            make_copies(folder, files_dir, files, folders, known, new_target, new_proof if proved else None,
                        new_state if app_file else None, proof_expected, candidate["token"] if candidate else None, made, own)
        except BaseException as e:
            said = taken_back(made, own, named, home, trash)
            if said:
                raise Bad("it couldn't be made ready to put in place (" + said_of(e) + "), and taking away what it made didn't finish:" + "".join(said))
            if isinstance(e, (OSError, Bad)):
                raise Retry("it couldn't be made ready to put in place (" + said_of(e) + "), so nothing changed")
            raise
        swaps = []   # one per final name, written down before any of its renames
        try:
            pairs = [(new_target, target), (new_proof, proof)] + ([(new_state, state)] if app_file else [])
            for new, final in pairs:
                pre, came = inode(final), made.get(new)
                sw = {"final": final, "pre": pre, "new": new, "came": came,
                      "aside": new if came is not None else os.path.join(here, ".old-" + tag + "-" + os.path.basename(final))}
                swaps.append(sw)
                # a copy it made goes in only if it's provably the one it
                # made: one whose inode isn't known is never "nothing to
                # move in"
                if (new == new_target or proved or app_file) and (came is None or inode(new) != came):
                    raise Bad("its new copy isn't the one it made")
                if pre is not None and came is not None:
                    swap_own(new, final, came, pre)     # in, and what was there out to its name, in one step
                elif pre is not None:
                    move_own(final, sw["aside"], pre)   # (no new proof: the old one put aside)
                elif came is not None:
                    move_own(new, final, came)          # to a name with nothing at it
        except BaseException as e:
            said, stays = [], set()
            for sw, now, kept in undo(swaps):
                f, a, at = os.path.basename(sw["final"]), os.path.basename(sw["aside"]), " in " + home
                if sw["came"] is not None and now == sw["came"]:
                    stays.add(now)   # its own new one, where the error says
                    if sw["pre"] is None:
                        said.append(" the new " + f + at + " is still there (remove it);")
                    elif kept:
                        said.append(" the new " + f + at + " is still there, and " + a + " there is what was at it (remove the new one, then rename that back);")
                    else:
                        said.append(" the new " + f + at + " is still there, and what was at it isn't at " + a + " any more (look at both names before anything else);")
                elif now is None and kept:
                    said.append(" " + a + at + " is what was at " + f + " (rename it back);")
                elif now is None:
                    said.append(" nothing is at " + f + at + " now, and what was at it isn't at " + a + " any more (look before anything else);")
                else:
                    said.append(" something else is at " + f + at + " now (look at it before anything else" + ("; what was at it is " + a + " there" if kept else "") + ");")
            left = taken_back(made, own, named, home, trash, stays)
            if said:
                raise Bad("it couldn't be put in place (" + said_of(e) + "), and putting back what was there didn't finish:" + "".join(said + left))
            if left:
                raise Bad("it couldn't be put in place (" + said_of(e) + "), and what was there is back, but taking away what it made didn't finish:" + "".join(left))
            if isinstance(e, (OSError, Bad)):
                raise Unchanged("it couldn't be put in place (" + said_of(e) + "), so nothing changed")
            raise
        # installed: the rest is tidying, and can't take that back
        left, kept = tidy(here, home, (version, version + ".proof"), {os.path.basename(sw["aside"]): sw["pre"] for sw in swaps if sw["pre"] is not None}, trash)
        try:
            remove_tree(folder)
        except OSError:
            left.append("what it was installed from")
        proof_kind = ("appFile" if app_file else "source" if source.startswith("source:") else "catalog") if proved else "none"
        out = {"ok": True, "manifest": manifest, "files": files, "path": os.path.join(home, version),
               "proof": proof_kind, "source": source, "sourceDir": sdir}
        if app_file:
            out["keyFingerprint"] = candidate["fingerprint"]
        elif proved and source.startswith("source:"):
            out["keyFingerprint"] = proof_fingerprint(proof)
        warn = ["It's installed, but " + ", ".join(left) + " couldn't be tidied away (the next install of it tries again)."] if left else []
        warn += [sentence(w) for w in kept + end_trash(trash, home)]
        try:
            st = os.stat(home)   # (its name followed, as the guide follows it)
            moved = (st.st_dev, st.st_ino) != fd_ino(hfd)
        except OSError:
            moved = True
        if moved:
            warn.append("It's installed, but " + home + " isn't the folder it was installed in any more: look at it before anything else.")
        if warn:
            out["warning"] = " ".join(warn)
        return out
    finally:
        if trash["fd"] is not None:   # (only if something unforeseen stopped it first)
            os.close(trash["fd"])


def make_copies(folder, files_dir, files, folders, known, new_target, new_proof, new_state,
                proof_expected, state_expected, made, own):
    """The new version (and its proof, unless new_proof is None) made under
    names nothing has, each written down in made the moment it's made by
    the inode of a folder held open that's its own: the staged one, moved
    there, or one it made and found empty (None until that's shown; never a
    name whose making failed). What's in it is made and checked through
    that descriptor (seal: exactly files, in folders), never a name that
    could have been swapped, and what's its own in it written down in own:
    each thing it makes, as it's made, or in the staged one moved there,
    what the tree check hashed (known: their inodes)"""
    src = open_folder(files_dir)   # the staged files, held from before they move
    try:
        ino = fd_ino(src)
        try:
            rename_at(files_dir, new_target, RENAME_NOREPLACE)
        except OSError:
            # another filesystem, say: copied, into a folder of its own
            # making (never one already there)
            dst = new_folder(new_target, made)
            try:
                own[new_target] = set()
                copy_into(src, dst, files, folders, own[new_target])
                seal(dst, files, folders, own[new_target])
            finally:
                os.close(dst)
        else:
            made[new_target] = ino   # (a rename keeps the inode: this very folder, held open)
            own[new_target] = set(known)
            seal(src, files, folders, own[new_target])
    finally:
        os.close(src)
    # from the catalog or a source: the package and the signed list go with it
    if new_proof is not None:
        sfd = open_folder(folder)
        try:
            dst = new_folder(new_proof, made)
            try:
                own[new_proof], room = set(), [MAX_PACKAGE + 4 * MAX_CATALOG]
                for n in PROOF:
                    copy_one(sfd, n, dst, own[new_proof], room)
                seal(dst, proof_expected or dict.fromkeys(PROOF), set(), own[new_proof])
            finally:
                os.close(dst)
        finally:
            os.close(sfd)
    if new_state is not None:
        src = open_folder(os.path.join(folder, APP_FILE_STATE))
        try:
            dst = new_folder(new_state, made)
            try:
                own[new_state], room = set(), [APP_FILE_STATE_MAX]
                copy_one(src, "state.json", dst, own[new_state], room)
                seal(dst, {"state.json": state_expected}, set(), own[new_state])
            finally:
                os.close(dst)
        finally:
            os.close(src)


def open_folder(path):
    """A folder held open by its path, never a link followed"""
    return os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)


def from_start(fd):
    """A folder held open, read again from its start, for a listing: on
    btrfs a descriptor that was read once doesn't show what was added after
    that until it's rewound (a new copy, checked empty when it was made,
    looked empty again once its files were in, and nothing installed)"""
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def below(top, *names):
    """A folder below one held open (top), each on the way made if missing
    and opened through the one before, never a link followed: its
    descriptor (Bad if one on the way isn't a plain folder)"""
    fd = os.dup(top)
    try:
        for n in names:
            try:
                os.mkdir(n, 0o755, dir_fd=fd)
            except FileExistsError:
                pass
            try:
                nfd = os.open(n, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            except OSError as e:
                if e.errno in (errno.ENOTDIR, errno.ELOOP):
                    raise Bad("its place in the apps folder isn't a plain folder, so nothing was installed")
                raise
            os.close(fd)
            fd = nfd
    except BaseException:
        os.close(fd)
        raise
    return fd


def fd_ino(fd):
    """What a descriptor holds, as (device, inode)"""
    st = os.fstat(fd)
    return (st.st_dev, st.st_ino)


def new_folder(path, made):
    """A folder of its own made at path (mkdir: never one already there),
    held open and written down in made by its inode once it's shown to be
    the empty private folder it made (None until then: it may be left).
    Its descriptor"""
    os.mkdir(path, 0o700)
    made[path] = None
    fd = open_folder(path)
    try:
        st = os.fstat(fd)
        with os.scandir(from_start(fd)) as found:
            empty = next(found, None) is None   # (one look: whatever else a folder there holds)
        if st.st_uid != os.geteuid() or st.st_mode & 0o077 or not empty:
            raise OSError(errno.ESTALE, "what's at its name isn't the folder it made")
    except BaseException:
        os.close(fd)
        raise
    made[path] = (st.st_dev, st.st_ino)
    return fd


def open_in(top, rel, own=None):
    """The folder at rel in a folder held open (top), opened through it
    without following a link anywhere: a new descriptor (each folder on the
    way, if own is given, one of its own)"""
    fd = os.dup(top)
    try:
        for p in rel.split("/") if rel else []:
            nfd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
            if own is not None and fd_ino(fd) not in own:
                raise Bad("its new copy changed while it was made")
    except BaseException:
        os.close(fd)
        raise
    return fd


def copy_into(src, dst, files, folders, own):
    """The files you were shown (files, in folders) copied from the staged
    folder held open (src) into one of its own held open (dst), through
    descriptors, never a name followed: each folder and file made new (never
    one already there) and written down in own as it's made"""
    room = [MAX_UNPACKED]
    for rel in sorted(folders, key=lambda p: p.count("/")):   # (each one's folder first)
        at, name = os.path.split(rel)
        pfd = open_in(dst, at, own)
        try:
            os.mkdir(name, 0o700, dir_fd=pfd)
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=pfd)
            try:
                own.add(fd_ino(fd))
            finally:
                os.close(fd)
        finally:
            os.close(pfd)
    for rel in sorted(files):
        at, name = os.path.split(rel)
        sfd = open_in(src, at)
        try:
            dfd = open_in(dst, at, own)
            try:
                copy_one(sfd, name, dfd, own, room)
            finally:
                os.close(dfd)
        finally:
            os.close(sfd)


def copy_one(sfd, name, dfd, own, room):
    """A plain file copied between folders held open, under its name: never
    a link, never over something already there, written down in own as it's
    made; room[0], the bytes it may still take"""
    s = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=sfd)
    try:
        if not stat.S_ISREG(os.fstat(s).st_mode):
            raise Bad("something that isn't a file was put in its files")
        d = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dfd)
        try:
            own.add(fd_ino(d))
            while True:
                chunk = os.read(s, 65536)
                if not chunk:
                    break
                room[0] -= len(chunk)
                if room[0] < 0:
                    raise Bad("its files changed while it waited")
                view = memoryview(chunk)
                while view:
                    view = view[os.write(d, view):]
        finally:
            os.close(d)
    finally:
        os.close(s)


def seal(top, files, folders, own):
    """A copy held open (top) checked to be exactly files (each path in it
    to its SHA-256, or None for whatever it holds) in folders (those it may
    have), and made read-only, each file and folder through its own
    descriptor, never a name followed: each only if it's one written down
    in own (as it was made, or as the tree check hashed it); anything else
    (one put at its name included) is never touched, and is Bad, as is
    anything missing or changed"""
    seen, odd, room = set(), [], [len(files) + len(folders) + 1, MAX_UNPACKED]   # (entries, then bytes: anything past what it holds is odd)

    def walk(dfd, at):
        with os.scandir(from_start(dfd)) as found:
            for e in found:
                room[0] -= 1
                if room[0] < 0:
                    raise Bad("its files changed while it waited")
                rel = at + e.name
                try:
                    st = os.stat(e.name, dir_fd=dfd, follow_symlinks=False)
                    if (st.st_dev, st.st_ino) not in own:
                        odd.append(rel)   # (not its own: never touched)
                        continue
                    if stat.S_ISDIR(st.st_mode) and rel in folders and rel.count("/") <= MAX_DEPTH:
                        fd = os.open(e.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
                    elif stat.S_ISREG(st.st_mode) and rel in files:
                        fd = os.open(e.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
                    else:
                        odd.append(rel)
                        continue
                except OSError:
                    odd.append(rel)
                    continue
                try:
                    now = os.fstat(fd)
                    if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
                        odd.append(rel)   # (swapped meanwhile: never touched)
                        continue
                    if stat.S_ISDIR(now.st_mode):
                        walk(fd, rel + "/")
                        os.fchmod(fd, 0o555)
                    else:
                        os.fchmod(fd, 0o444)
                        seen.add(rel)
                        if files[rel] is not None and sha256_fd(fd, room) != files[rel]:
                            odd.append(rel)
                finally:
                    os.close(fd)
    walk(top, "")
    if odd or seen != set(files):
        raise Bad("its files changed while it waited")
    os.fchmod(top, 0o555)


def sha256_fd(fd, room):
    """A file held open, hashed; room[1], the bytes it may still read"""
    h = hashlib.sha256()
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            return h.hexdigest()
        room[1] -= len(chunk)
        if room[1] < 0:
            raise Bad("its files changed while it waited")
        h.update(chunk)


def taken_back(made, own, named, home, trash, stays=()):
    """Its own new copies (made; those whose inodes are in stays are where
    the error says) taken away into its private folder and deleted there,
    only what's its own in each (own), then the private folder gone: what
    isn't, in words for the error ([] once all of that's done)"""
    said = []
    for path, ino in made.items():
        if ino is not None and ino in stays:
            continue
        name, f = os.path.basename(path), named[path]
        if ino is None:
            said.append(" the new " + f + " may be left at " + name + " in " + home + " (look at it before anything else);")
            continue
        try:
            taken = take_own(path, ino, trash)
        except OSError:
            try:
                now = inode(path)
            except OSError:
                now = False
            if now == ino:
                said.append(" the new " + f + " is left at " + name + " in " + home + " (remove it);")
            elif now is None:
                said.append(" the new " + f + " isn't at " + name + " in " + home + " any more (something else moved it);")
            else:
                said.append(" something else is at " + name + " in " + home + " now, not the new " + f + " (look at it before anything else);")
            continue
        wipe_own(trash["fd"], taken, ino, own.get(path, set()))   # (what stays of it keeps the private folder: end_trash)
    return said + end_trash(trash, home)


def old_version(name):
    """A name an old version (or its proof) has in an app's folder"""
    return bool(VERSION_RE.match(name) or (name.endswith(".proof") and VERSION_RE.match(name[:-6])))


def tidy(here, home, keep, asides, trash):
    """After the swap, what it replaced taken away into the private folder
    and deleted there: the old versions (names a version has, and their
    proofs, but keep), each only while it's exactly what the listing found
    (its inode as the listing read it), and what it put aside itself
    (asides: each name to the inode put there), never something that took
    its place. Nothing else in the app's folder is ever touched (another
    install's leftovers, or something of someone else's). ([the names that
    couldn't be], [what it put aside and couldn't, in words]; here, the
    app's folder to work in, home its name for the words)"""
    try:
        dev = os.stat(here).st_dev
        with os.scandir(here) as found:
            old = sorted((e.name, (dev, e.inode())) for e in found if e.name not in keep and old_version(e.name))
    except OSError:
        return ["its old versions"], []
    left, kept = [], []
    for name, ino in old + sorted(asides.items()):
        path = os.path.join(here, name)
        try:
            taken = take_own(path, ino, trash)
        except OSError:
            try:
                now = inode(path)
            except OSError:
                now = False
            if name in asides:
                if now == ino:
                    kept.append(" what it replaced is left at " + name + " in " + home + " (remove it);")
                elif now is False:
                    kept.append(" what it replaced may be left at " + name + " in " + home + " (look at it before anything else);")
            elif now is not None:
                left.append(name)   # (gone already: nothing to say)
            continue
        wipe_own(trash["fd"], taken, ino, None)
    return left, kept


def sentence(said):
    """Words for an error (" what (to do);") as a sentence for a warning"""
    what, _, do = said.strip().rstrip(";").rpartition(" (")
    return what[:1].upper() + what[1:] + ": " + do.rstrip(")") + "."


def inode(path):
    """What's at a path, as (device, inode), without following a link; None
    if nothing is. Any other error is raised"""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None
    return (st.st_dev, st.st_ino)


def undo(swaps):
    """An install's swap undone from what's on disk, touching only what's
    provably its own, each step one that can't destroy anything, checked
    right after: the new one exchanged back out with what was there (or
    renamed back out to its empty .new- name), what was there renamed back
    in from where it was put aside, each tried twice. Then each final name
    checked against exactly what was there before, nothing included:
    anything else counts as not done. [(its record, what's at the final
    now: False if that can't be checked, whether its aside provably holds
    what was there)] for each not back"""
    for sw in reversed(swaps):
        final, new, aside, pre, came = sw["final"], sw["new"], sw["aside"], sw["pre"], sw["came"]
        for _ in range(2):
            try:
                if pre is not None and came is not None:
                    if inode(final) == came and inode(new) == pre:
                        swap_own(new, final, pre, came)
                elif pre is not None:
                    if inode(final) is None and inode(aside) == pre:
                        move_own(aside, final, pre)
                elif came is not None:
                    if inode(final) == came:
                        move_own(final, new, came)
                break
            except OSError:
                continue
    left = []
    for sw in swaps:
        try:
            now = inode(sw["final"])
        except OSError:
            now = False   # can't be checked: never counted as back
        if now == sw["pre"]:
            continue
        try:
            kept = sw["pre"] is not None and inode(sw["aside"]) == sw["pre"]
        except OSError:
            kept = False
        left.append((sw, now, kept))
    return left


def move_own(src, dst, ino):
    """A rename of what's provably its own (ino, checked just before) to a
    name with nothing at it, never replacing: checked right after, and if
    what moved isn't it, moved straight back (never replacing either) and
    raised, so the step counts as not done. A check that errors is raised:
    nothing is moved blind"""
    move_one(src, dst)
    if inode(dst) != ino:
        move_one(dst, src)
        raise OSError(errno.ESTALE, "what was moved wasn't its own, so it was moved back")


def swap_own(a, b, at_a, at_b):
    """a and b, provably holding at_a and at_b (checked just before),
    exchanged in one step (both stay: nothing is replaced): checked right
    after, and if what moved isn't those two, exchanged straight back and
    raised, so the step counts as not done. A check that errors is raised:
    nothing is moved blind"""
    exchange_one(a, b)
    if inode(b) != at_a or inode(a) != at_b:
        exchange_one(a, b)
        raise OSError(errno.ESTALE, "what was swapped wasn't its own, so it was swapped back")


def take_own(path, ino, trash):
    """An entry of its own (ino) taken away with no look ever deciding a
    delete: renamed into its private folder beside it (held open: trash_fd)
    by a rename that never replaces anything, and checked there to be
    exactly ino before it's the caller's to delete there (wipe_own).
    Anything else that moved is renamed straight back (never replacing
    either), or if even that can't be, stays in there, named in
    trash["stuck"]. Its name in there; OSError if it wasn't taken"""
    if ino is None or inode(path) != ino:
        raise OSError(errno.ESTALE, "it isn't its own")
    tfd, name = trash_fd(trash), os.path.basename(path)
    writable(path, ino)
    rename_at(path, name, RENAME_NOREPLACE, dst_dir_fd=tfd)
    try:
        ours = inode_at(tfd, name) == ino
    except OSError:
        ours = False   # can't be checked: never deleted
    if not ours:
        try:
            rename_at(name, path, RENAME_NOREPLACE, src_dir_fd=tfd)
        except OSError:
            trash["stuck"].append(name)
        raise OSError(errno.ESTALE, "what was moved wasn't its own, so it was moved back")
    return name


def trash_fd(trash):
    """Its private folder, made on first use beside what it takes (a fresh
    name, 0700: never a folder already there; an install makes it before
    anything else) and held open: its descriptor. OSError if it can't be
    made, or isn't shown to be the folder it made (then it's never used)"""
    if trash["fd"] is None:
        if trash["tried"]:
            raise OSError(errno.ESTALE, "its private folder couldn't be made")
        trash["tried"], made = True, {}
        try:
            fd = new_folder(trash["path"], made)
        except BaseException:
            trash["maybe"] = trash["path"] in made   # (made, but never shown to be its own)
            raise
        trash["fd"], trash["ino"] = fd, made[trash["path"]]
    return trash["fd"]


def writable(path, ino):
    """A folder of its own (ino) made writable through itself, never through
    a path that could have been swapped (renamed into another folder, a
    folder's .. changes, and read-only it can't be). Anything else is left
    as it is"""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return   # not a folder (a file or a link needs nothing), or not there
    try:
        st = os.fstat(fd)
        if (st.st_dev, st.st_ino) == ino and not st.st_mode & stat.S_IWUSR:
            os.fchmod(fd, stat.S_IMODE(st.st_mode) | stat.S_IWUSR)
    finally:
        os.close(fd)


def quarantine_own(dfd, name, ino, prefix):
    """Whatever is at name moved to a fresh name in the same held folder
    (a rename that never replaces anything), and checked to be ino there:
    the last check before a delete. Something else that moved is put
    straight back without replacing anything, or left at the fresh name if
    its old name was filled meanwhile. (The delete that follows is still by
    name: what keeps it safe is the lock, lock_apps.) (fresh name if ino
    moved, None otherwise; a retained foreign name, if there is one)"""
    slot = prefix + secrets.token_hex(8)
    rename_at(name, slot, RENAME_NOREPLACE, src_dir_fd=dfd, dst_dir_fd=dfd)
    try:
        ours = inode_at(dfd, slot) == ino
    except OSError:
        ours = False
    if ours:
        return slot, None
    return None, restore_quarantine(dfd, slot, name)


def restore_quarantine(dfd, slot, name):
    """Put a quarantined entry back at its old empty name without replacing
    anything.  None if it went back, otherwise the name that still holds it."""
    try:
        rename_at(slot, name, RENAME_NOREPLACE, src_dir_fd=dfd, dst_dir_fd=dfd)
        return None
    except OSError:
        return slot


def wipe_own(dfd, name, ino, own, depth=0):
    """An entry of its own (ino) in a folder held open (its private folder)
    moved to a fresh name and checked there before it's deleted (under the
    lock: lock_apps), with what's in it: all of that if own is None (an old version), else
    only what's its own (own: inodes). Anything substituted after a check is
    put back or kept under the fresh name; anything else stays, and so does
    every folder holding it; so does a folder deeper than an app's go. True
    if it's gone"""
    try:
        fd = os.open(name, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if (st.st_dev, st.st_ino) != ino:
            return False
        try:
            held, _ = quarantine_own(dfd, name, ino, ".wipe-")
        except OSError:
            return False
        if held is None:
            return False
        if not stat.S_ISDIR(st.st_mode):
            try:
                os.unlink(held, dir_fd=dfd)
                return True
            except OSError:
                restore_quarantine(dfd, held, name)
                return False
        try:
            whole = depth <= MAX_DEPTH + 1 and wipe_in(fd, st, own, depth)
        except OSError:
            whole = False
        if not whole:
            restore_quarantine(dfd, held, name)
            return False
        try:
            os.rmdir(held, dir_fd=dfd)   # (only ever empty)
            return True
        except OSError:
            restore_quarantine(dfd, held, name)
            return False
    except OSError:
        return False
    finally:
        os.close(fd)


def wipe_in(pfd, st, own, depth):
    """What's in a folder of its own (pfd, st) deleted as wipe_own says:
    True if nothing's left in it"""
    d = os.open(".", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC, dir_fd=pfd)   # (that very folder)
    try:
        os.fchmod(d, stat.S_IMODE(st.st_mode) | stat.S_IRWXU)
        names = []
        with os.scandir(d) as found:
            for e in found:
                names.append(e.name)
                if len(names) > 4 * MAX_MEMBERS:
                    return False   # (more than an app holds: left as it is)
        whole = True
        for n in names:
            try:
                at = os.stat(n, dir_fd=d, follow_symlinks=False)
            except OSError:
                whole = False
                continue
            ino = (at.st_dev, at.st_ino)
            if (own is not None and ino not in own) or not wipe_own(d, n, ino, own, depth + 1):
                whole = False
        return whole
    finally:
        os.close(d)


def end_trash(trash, home):
    """The private folder gone once nothing's left in it (rmdir, only while
    it's still the folder made), its descriptor let go: what's left there,
    in words for the error ([] once it's gone, or if it was never made)"""
    name, fd = os.path.basename(trash["path"]), trash["fd"]
    if fd is None:
        return [" " + name + " in " + home + " may be left (look at it before anything else);"] if trash["maybe"] else []
    trash["fd"] = None
    try:
        try:
            inside = []
            with os.scandir(from_start(fd)) as found:
                for e in found:
                    inside.append(e.name)
                    if len(inside) > len(trash["stuck"]):
                        break
        except OSError:
            inside = None
        if inside == []:
            try:
                if inode(trash["path"]) == trash["ino"]:
                    pfd = os.open(os.path.dirname(trash["path"]), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
                    try:
                        held, foreign = quarantine_own(pfd, name, trash["ino"], ".end-")
                        if held is not None:
                            try:
                                os.rmdir(held, dir_fd=pfd)   # (empty)
                            except OSError:
                                kept = restore_quarantine(pfd, held, name)
                                return [" " + (kept or name) + " in " + home + " may be left (look at it before anything else);"]
                            return []
                        if foreign is not None:
                            return [" what was at " + name + " in " + home + " is at " + foreign + " there now (look at it before anything else);"]
                    finally:
                        os.close(pfd)
            except OSError:
                pass
            return [" " + name + " in " + home + " may be left (look at it before anything else);"]
        said = [" what was at " + n + " in " + home + " is in " + name + " there now (look at it before anything else);" for n in trash["stuck"]]
        if inside is None or not set(inside) <= set(trash["stuck"]):
            said.append(" " + name + " in " + home + " holds what couldn't be taken away (look at it before anything else);")
        return said
    finally:
        os.close(fd)


def lock_apps(apps_root):
    """The apps folder held while an install, a removal or the move to the
    (source, id) layout changes anything in it, so two never cross (another
    waits its turn): an flock on the folder itself, which is never removed
    (an app's own folder is). Lock order: your sources' lock first (an
    install from a source holds it), then this one; nothing takes them the
    other way round. The descriptor held: closing it lets go.

    This is what keeps cleanup safe. Linux can't delete by inode, so a
    delete is by name however carefully what's there was checked; deletes
    happen only under this lock (or a build's lock on its source folder),
    in names only this helper uses, so nothing else of Uber TV's is ever
    there. A process outside Uber TV that writes into those names while
    they're cleaned up has the user's own rights anyway, and isn't guarded
    against."""
    os.makedirs(apps_root, mode=0o755, exist_ok=True)
    try:
        fd = os.open(apps_root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        if e.errno in (errno.ELOOP, errno.ENOTDIR) and os.path.islink(apps_root):   # (only for the words)
            raise Bad("the apps folder can't be a link, so nothing changed")
        raise
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
    except BaseException:
        os.close(fd)
        raise
    return fd


def said_of(e):
    """An exception in a few words"""
    if isinstance(e, OSError):
        return (e.strerror or str(e))[:80]
    if isinstance(e, KeyboardInterrupt):
        return "interrupted"
    return str(e)[:80] or type(e).__name__


def move_one(src, dst):
    """A rename to a name with nothing at it (RENAME_NOREPLACE: what's
    there, if anything, is never replaced)"""
    rename_at(src, dst, RENAME_NOREPLACE)


def exchange_one(a, b):
    """Two names' entries swapped in one step (RENAME_EXCHANGE: both must be
    there, and both stay)"""
    rename_at(a, b, RENAME_EXCHANGE)


RENAME_NOREPLACE, RENAME_EXCHANGE = 1, 2
_renameat2 = None


def rename_at(src, dst, flags, src_dir_fd=None, dst_dir_fd=None):
    """Linux's renameat2, one atomic step: RENAME_NOREPLACE moves src to dst
    only if nothing is at dst (EEXIST otherwise, and what's there is never
    replaced), RENAME_EXCHANGE swaps the two (both must be there). Neither
    follows a link. Any error is raised, a kernel or filesystem without it
    included: never a plain rename instead"""
    global _renameat2
    if _renameat2 is None:
        try:
            fn = ctypes.CDLL(None, use_errno=True).renameat2
        except (OSError, AttributeError):
            raise OSError(errno.ENOSYS, "renameat2 isn't available here")
        fn.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        fn.restype = ctypes.c_int
        _renameat2 = fn
    a, b = os.fsencode(src), os.fsencode(dst)
    if b"\0" in a or b"\0" in b:
        raise ValueError("embedded null byte")   # (C would see a shorter name)
    here = -100   # AT_FDCWD
    if _renameat2(here if src_dir_fd is None else src_dir_fd, a, here if dst_dir_fd is None else dst_dir_fd, b, flags) != 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e), src, None, dst)


def proof_fingerprint(proof):
    """The fingerprint of the key that signed the list an app from a source
    came from (kept with it: what its details name, whatever the source's key
    is now)"""
    kind, blob = proof_source(proof)
    try:
        if kind == "appFile":
            return APPFILES().parse_key(str((blob or {}).get("key", "")).encode())[1]
        return SOURCES().parse_key(str((blob or {}).get("key", "")).encode())[1] if kind == "source" else ""
    except Exception:
        return ""


def do_discard(folder, staging_root):
    if inside(folder, staging_root) and os.path.basename(folder).startswith("app-"):
        remove_tree(folder)
    return {"ok": True}


def do_remove(app_id, source, roots):
    """An app and everything of it: its files, storage, secrets, log,
    pictures and Activity (roots: {"apps", "store", "secrets", "logs",
    "images", "activity", "data"}), the apps folder held, so no install
    crosses it (lock_apps)"""
    if not ID_RE.match(app_id):
        raise Bad("not an app's id")
    sdir = source_dir(source)
    r = roots if isinstance(roots, dict) else {}
    apps = r.get("apps")
    held = lock_apps(apps) if isinstance(apps, str) and apps.startswith("/") else None
    try:
        paths = [(r.get("apps"), os.path.join(sdir, app_id)), (r.get("store"), os.path.join(sdir, app_id + ".json")),
                 (r.get("secrets"), os.path.join(sdir, app_id + ".json")), (r.get("logs"), os.path.join(sdir, app_id + ".log")),
                 (r.get("images"), os.path.join(sdir, app_id)), (r.get("activity"), os.path.join(sdir, app_id + ".json")),
                 (r.get("data"), app_id), (r.get("apps"), app_id)]
        for root, rel in paths:
            if not isinstance(root, str) or not root.startswith("/"):
                continue
            path = os.path.join(root, rel)
            if os.path.lexists(path) and inside(path, root):
                remove_tree(path)
        # a source's folder with nothing left in it goes too (rmdir: only if empty)
        for root in set(v for k, v in r.items() if k != "data" and isinstance(v, str) and v.startswith("/")):
            try:
                os.rmdir(os.path.join(root, sdir))
            except OSError:
                pass
    finally:
        if held is not None:
            os.close(held)
    return {"ok": True}


def package_tree(data):
    """The plain files in a package (its bytes) and their SHA-256s, read
    within the caps an install's unpack reads it in (open_package, and 20
    MB of files)"""
    files, members, total = {}, 0, 0
    try:
        with open_package(io.BytesIO(data)) as tf:
            for m in tf:
                members += 1
                if members > MAX_MEMBERS:
                    raise Bad("its package has too many files")
                name = clean_name(m.name)
                if name is None or m.isdir():
                    continue
                if not m.isreg():
                    raise Bad("its package has something that isn't a plain file")
                h, src = hashlib.sha256(), tf.extractfile(m)
                for chunk in iter(lambda: src.read(65536), b""):
                    total += len(chunk)
                    if total > MAX_UNPACKED:
                        raise Bad("its package is bigger than 20 MB unpacked")
                    h.update(chunk)
                files[name] = h.hexdigest()
    except (tarfile.TarError, EOFError, gzip.BadGzipFile, zlib.error, ValueError):
        raise Bad("its package can't be read")
    return files


def check_proof(proof, app_id, version, files, signers):
    """An app from the catalog traced back to it: the catalog it came from
    (its signature good) lists this version's package (its SHA-256), and
    the package holds exactly the files on disk"""
    where, data, sig = read_signed(os.path.join(proof, "proof.json"), "what shows it came from the catalog is gone")
    verify_signature(data, sig, signers)
    cat = parse_catalog(data, where, 0)
    entry = cat["apps"].get(app_id)
    if not entry or entry["version"] != version:
        raise Bad("the catalog it came from doesn't list this version")
    package = read_local(os.path.join(proof, "package.tar.gz"), MAX_PACKAGE, "its package")
    if hashlib.sha256(package).hexdigest() != entry["sha256"] or len(package) != entry["size"]:
        raise Bad("its package isn't the one the catalog listed")
    if package_tree(package) != files:
        raise Bad("its files were changed after it was installed")
    return entry


def proof_source(proof):
    """Which kind of proof is kept with an app: a source's ("source:<hex>")
    or the catalog's (its address)"""
    try:
        with open_plain(os.path.join(proof, "proof.json"), follow=False) as f:
            blob = json.loads(f.read(MAX_CATALOG * 2).decode("utf-8"))
    except (OSError, ValueError, Bad):
        return None, None
    if isinstance(blob, dict) and blob.get("type") == "appFile":
        return "appFile", blob
    if isinstance(blob, dict) and isinstance(blob.get("source"), str) and blob["source"].startswith("source:"):
        return "source", blob
    return "catalog", None


def check_app_file_proof(home, proof, blob, app_id, version, files, sdir, allow_revoked=False):
    """A signed app file traced to its exact note, key, package and state."""
    bad = "what shows the app file's signature was changed"
    if not isinstance(blob, dict) or set(blob) != {"type", "key", "data", "sig"} or blob.get("type") != "appFile":
        raise Bad(bad)
    try:
        data = base64.b64decode(blob["data"], validate=True)
        sig = base64.b64decode(blob["sig"], validate=True)
        if len(data) > MAX_RELEASE or len(sig) > MAX_SIGNATURE:
            raise ValueError()
        line, fingerprint = APPFILES().parse_key(blob["key"].encode())
        APPFILES().verify(data, sig, line)
    except (KeyError, TypeError, ValueError, APPFILES().Problem):
        raise Bad(bad)
    source = APPFILES().source_id(line)
    if source_dir(source) != sdir:
        raise Bad("the app file's key isn't its installed origin")
    checked = check_app_release(data)
    entry = checked["entry"]
    if entry["id"] != app_id or entry["version"] != version:
        raise Bad("the signed release doesn't name this app and version")
    package = read_local(os.path.join(proof, "package.tar.gz"), MAX_PACKAGE, "its package")
    if hashlib.sha256(package).hexdigest() != entry["sha256"] or len(package) != entry["size"]:
        raise Bad("its package isn't the one its signed release names")
    if package_tree(package) != files:
        raise Bad("its files were changed after it was installed")
    state = read_app_state(home, source, app_id)
    if state["key"] != line:
        raise Bad("the key kept with the app isn't the one that signed it")
    proof_sha = hashlib.sha256(data).hexdigest()
    if (state["release"]["updated"] < checked["release"]["updated"]
            or (state["release"]["updated"] == checked["release"]["updated"]
                and state["state"]["noteSha256"] != proof_sha)):
        raise Bad("the signed release kept with the app went backwards")
    if not {row["version"] for row in checked["release"]["revoked"]} <= {row["version"] for row in state["revoked"]}:
        raise Bad("the signed release kept with the app lost a withdrawal")
    pulled = withdrawn(state["revoked"], version)
    if pulled and not allow_revoked:
        raise Bad("the developer withdrew this version: " + pulled["reason"])
    return entry, state, fingerprint


def check_source_proof(proof, blob, app_id, version, files, store, sdir):
    """An app from one of your sources traced back to it (lib/appsources.py
    check_proof), installed under that source's folder, its package the one
    that list names and holding exactly the files on disk"""
    if not store:
        raise Bad("it can't be checked without your sources")
    if source_dir(blob.get("source")) != sdir:
        raise Bad("what shows where it came from isn't its own")
    S = SOURCES()
    try:
        entry = S.check_proof(store, blob, app_id, version, source_list)
    except S.Problem as e:
        raise Bad(str(e))
    package = read_local(os.path.join(proof, "package.tar.gz"), MAX_PACKAGE, "its package")
    if hashlib.sha256(package).hexdigest() != entry["sha256"] or len(package) != entry["size"]:
        raise Bad("its package isn't the one its source listed")
    if package_tree(package) != files:
        raise Bad("its files were changed after it was installed")
    return entry


def verify_one(home, app_id, version, signers, store="", sdir=""):
    item = {"id": app_id, "version": version, "files": {}, "proof": "none", "manifest": None, "problem": ""}
    folder = os.path.join(home, version)
    try:
        if not stat.S_ISDIR(os.lstat(folder).st_mode):
            raise Bad("its files are gone")
        item["files"] = tree_of(folder, "a link was put in its files")
        entry = None
        proof = folder + ".proof"
        if os.path.lexists(proof):
            if not stat.S_ISDIR(os.lstat(proof).st_mode):
                raise Bad("what shows it came from the catalog was changed")
            kind, blob = proof_source(proof)
            if kind == "appFile":
                entry, state, fingerprint = check_app_file_proof(home, proof, blob, app_id, version, item["files"], sdir)
                item["proof"] = "appFile"
                item["keyFingerprint"] = fingerprint
                if version_key(state["entry"]["version"]) > version_key(version):
                    item["update"] = state["entry"]
            elif kind == "source":
                entry = check_source_proof(proof, blob, app_id, version, item["files"], store, sdir)
                item["proof"] = "source"
                item["keyFingerprint"] = proof_fingerprint(proof)
            else:
                try:
                    entry = check_proof(proof, app_id, version, item["files"], signers)
                    item["proof"] = "catalog"
                except Untrusted:
                    # signed with a key the guide no longer trusts (one that was
                    # stolen, say): not proof of anything, so the guide installs it
                    # again from the catalog it trusts now
                    item["proof"] = "untrusted"
        manifest = check_files(folder, item["files"])
        if manifest["id"] != app_id or manifest["version"] != version:
            raise Bad("its app.json isn't this app's")
        if entry and manifest["permissions"] != entry["permissions"]:
            named_by = {"source": "its source", "appFile": "its signed release"}.get(item["proof"], "the catalog")
            raise Bad("it asks for more than " + named_by + " lists")
        # one from a source is all its list says it is, by the name and maker
        # its review showed (one installed before prepare checked that turns off)
        if item["proof"] in ("source", "appFile") and not as_listed(manifest, entry):
            raise Bad("it isn't what its signed release says it is")
        item["manifest"] = manifest
    except Bad as e:
        item["problem"] = str(e)
        item["proof"] = "none"
    except Exception:
        item["problem"] = "its files couldn't be read"
        item["proof"] = "none"
    return item   # proof: "catalog", "source", "appFile", "untrusted" (install it again) or "none"


def folder_tree(src):
    """The files copy_folder would take from a folder, and their SHA-256s,
    without copying (hidden files and build leftovers left out)"""
    files = {}
    src = os.path.realpath(src)
    for root, dirs, names in os.walk(src, followlinks=False):
        rel_root = os.path.relpath(root, src)
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and d not in ("node_modules", "__pycache__")
                         and not os.path.islink(os.path.join(root, d)))
        for n in sorted(names):
            if n.startswith("."):
                continue
            full = os.path.join(root, n)
            if stat.S_ISREG(os.lstat(full).st_mode):
                files[os.path.normpath(os.path.join(rel_root, n))] = sha256_file(full)
    return files


def do_verify(apps_root, signers, plugin_dir="", store=""):
    """Every app installed, as it is on disk: its files, where it traces back
    to (a signed catalog, one of your sources (store: sources.json), or the
    plugin's own copy for a bundled app), and its app.json, checked. Apps still in the old layout (<apps>/<id>/<version>,
    before sources) are listed with "legacy": true, for the guide to move."""
    found = []
    try:
        top = sorted(os.listdir(apps_root))
    except FileNotFoundError:
        top = []
    bundled = source_dir("bundled")
    for name in top:
        path = os.path.join(apps_root, name)
        if not stat.S_ISDIR(os.lstat(path).st_mode):
            continue
        if ID_RE.match(name) and not re.match(r"^[0-9a-f]{16}\Z", name):
            for version in sorted(os.listdir(path)):
                if VERSION_RE.match(version):
                    item = verify_one(path, name, version, signers)
                    item.update(legacy=True, sourceDir="")
                    found.append(item)
            continue
        if not re.match(r"^[0-9a-f]{16}\Z", name):
            continue
        for app_id in sorted(os.listdir(path)):
            home = os.path.join(path, app_id)
            if not ID_RE.match(app_id) or not stat.S_ISDIR(os.lstat(home).st_mode):
                continue
            for version in sorted(os.listdir(home)):
                if not VERSION_RE.match(version):
                    continue
                item = verify_one(home, app_id, version, signers, store, name)
                item["sourceDir"] = name
                if name == bundled and not item["problem"]:
                    # bundled: traced to the plugin's own copy (the reviewed commit)
                    copy = os.path.join(plugin_dir, "apps", "first-party", app_id)
                    try:
                        same = os.path.isdir(copy) and folder_tree(copy) == item["files"]
                    except OSError:
                        same = False
                    item["proof"] = "bundled" if same else "bundledChanged"
                found.append(item)
    return {"ok": True, "apps": found}


def do_bundled(plugin_dir):
    """The first-party apps the plugin comes with: each one's checked app.json
    and tree, or why it can't be offered"""
    base = os.path.join(plugin_dir, "apps", "first-party")
    out = []
    try:
        names = sorted(os.listdir(base))
    except FileNotFoundError:
        names = []
    for app_id in names:
        path = os.path.join(base, app_id)
        if not ID_RE.match(app_id) or not os.path.isdir(path) or os.path.islink(path):
            continue
        try:
            files = folder_tree(path)
            manifest = check_files(path, files)
            if manifest["id"] != app_id:
                raise Bad("its app.json isn't its own")
            out.append({"id": app_id, "manifest": manifest, "tree": tree_sha(files)})
        except Bad as e:
            out.append({"id": app_id, "problem": str(e)})
    # apps with code need bubblewrap and a systemd user manager to run
    can_run = all(os.access(p, os.X_OK) for p in ("/usr/bin/bwrap", "/usr/bin/systemd-run", "/usr/bin/python3"))
    return {"ok": True, "apps": out, "canRun": can_run}


def do_migrate(apps_root, journal, legacy):
    """Apps from before sources (<apps>/<id>/<version>) into the (source, id)
    layout: one from the catalog keeps the catalog as its source (a missing or
    untrusted proof means it's installed again from the catalog, never made a
    file app); one from a file gets its own lineage. The journal records each
    decision before anything moves, so a rerun after an interruption makes the
    same ones. All of it under the apps folder's lock (lock_apps), the
    journal read included: another move waits, then reads and answers the
    very decisions the first one made"""
    held = lock_apps(apps_root)
    try:
        try:
            with open_plain(journal) as f:
                decided = json.loads(f.read(256 * 1024).decode("utf-8"))
            if not isinstance(decided, dict):
                decided = {}
        except (OSError, ValueError):
            decided = {}
        for item in legacy if isinstance(legacy, list) else []:
            app_id = item.get("id") if isinstance(item, dict) else None
            if not isinstance(app_id, str) or not ID_RE.match(app_id) or app_id in decided:
                continue
            decided[app_id] = "catalog:uber" if item.get("from") != "file" else "file:" + os.urandom(8).hex()
        os.makedirs(os.path.dirname(journal), mode=0o700, exist_ok=True)
        write_json(journal, decided)
        moved = {}
        for app_id, source in decided.items():
            if not ID_RE.match(app_id) or not SOURCE_RE.match(source):
                continue
            sdir = source_dir(source)
            old = os.path.join(apps_root, app_id)
            new = os.path.join(apps_root, sdir, app_id)
            if os.path.lexists(old) and stat.S_ISDIR(os.lstat(old).st_mode) and not os.path.lexists(new):
                ensure_dir(os.path.join(apps_root, sdir))
                try:
                    rename_at(old, new, RENAME_NOREPLACE)
                except FileExistsError:
                    pass   # (something's there already: left as it is)
            moved[app_id] = {"source": source, "sourceDir": sdir}
        return {"ok": True, "moved": moved}
    finally:
        os.close(held)


def do_check(folder):
    """An app folder as an install would check it, plus a lint of its Python:
    imports only from the standard library, the toolkit (uber_tv) and the app's
    own modules. The lint isn't a security boundary (the sandbox is)."""
    import ast
    errors, warnings = [], []
    tmp = tempfile.mkdtemp(prefix="check-")
    try:
        try:
            files = copy_folder(os.path.abspath(folder), tmp)
            manifest = check_files(tmp, files)
            pack_tree(tmp, files)   # (a package a guide installs)
        except Bad as e:
            return {"ok": False, "errors": [{"code": "invalid", "text": str(e)}], "warnings": []}
        local = {n.split("/")[0][:-3] if n.split("/")[0].endswith(".py") else n.split("/")[0] for n in files}
        allowed = set(sys.stdlib_module_names) | {"uber_tv"} | local
        if manifest["kind"] == "app":
            for name in sorted(files):
                if not name.endswith(".py"):
                    continue
                try:
                    with open(os.path.join(tmp, name), encoding="utf-8") as f:
                        tree = ast.parse(f.read(), filename=name)
                except SyntaxError as e:
                    errors.append({"code": "syntax", "text": name + ":" + str(e.lineno) + ": " + str(e.msg)})
                    continue
                for node in ast.walk(tree):
                    mods = []
                    if isinstance(node, ast.Import):
                        mods = [a.name for a in node.names]
                    elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
                        mods = [node.module]
                    for mod in mods:
                        if mod.split(".")[0] not in allowed:
                            errors.append({"code": "import", "text": name + ":" + str(node.lineno) + ": imports " + mod +
                                           ", which isn't in Python's standard library, the toolkit or this app"})
        return {"ok": not errors, "manifest": manifest, "errors": errors, "warnings": warnings}
    finally:
        remove_tree(tmp)


def secrets_file(path):
    """A secrets file's folder: private (0700), and the file itself never a link"""
    if not isinstance(path, str) or not path.startswith("/") or not path.endswith(".json"):
        raise Bad("not a secrets file")
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    os.chmod(os.path.dirname(path), 0o700)
    if os.path.lexists(path) and not stat.S_ISREG(os.lstat(path).st_mode):
        raise Bad("the secrets file isn't a plain file")


@contextlib.contextmanager
def secrets_locked(path):
    """Every change to a secrets file is read, changed and written whole
    under a lock on its folder, so two writers (a setting, a sign-in, an
    update's clean-up) never undo each other"""
    fd = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


# a secrets file at its biggest: 32 values of up to 4 KB of UTF-8 each,
# every byte written as up to 6 in JSON (\u0001), with their names and
# server, fit with room to spare. Whatever the code can write, it can read.
MAX_SECRETS_FILE = 1024 * 1024
MAX_SECRET = 4096


def read_secrets(path, changing=False):
    """An app's secrets file: {"user": {name: value}} for what you typed in
    its settings, {"signIn": {"server", "values"}} for what its sign-in kept
    (good only for that server). changing: read to be written back. One
    there that can't be read (too big, not JSON) is then Bad, never taken
    as empty and written over (what it holds would be lost)."""
    data = None
    try:
        with open_plain(path, follow=False) as f:
            raw = f.read(MAX_SECRETS_FILE + 1)
        if len(raw) <= MAX_SECRETS_FILE:
            data = json.loads(raw.decode("utf-8"))
    except FileNotFoundError:
        data = {}
    except (OSError, ValueError):
        pass
    if not isinstance(data, dict):
        if changing:
            raise Bad("the app's secrets file couldn't be read, so it was left as it is")
        data = {}
    user = data.get("user") if isinstance(data.get("user"), dict) else {}
    sign = data.get("signIn") if isinstance(data.get("signIn"), dict) else {}
    return {"user": {k: v for k, v in user.items() if isinstance(k, str) and isinstance(v, str)},
            "signIn": {"server": str(sign.get("server") or ""),
                       "values": {k: v for k, v in (sign.get("values") or {}).items() if isinstance(k, str) and isinstance(v, str)}
                       if isinstance(sign.get("values"), dict) else {}}}


def do_secret_set(path, name, value):
    """One secret kept for an app (the value came on stdin, never in argv)"""
    secrets_file(path)
    if not isinstance(name, str) or not re.match(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}\Z", name):
        raise Bad("not a secret's name")
    if len(value.encode("utf-8")) > MAX_SECRET or "\0" in value:
        raise Bad("a secret is up to 4 KB of text")
    with secrets_locked(path):
        data = read_secrets(path, changing=True)
        if name not in data["user"] and len(data["user"]) + len(data["signIn"]["values"]) >= 32:
            raise Bad("an app keeps up to 32 secrets")
        data["user"][name] = value
        write_json(path, data)
    return {"ok": True}


def do_secret_clear(path, *names):
    """Secrets you typed gone, or (name "*") every secret, or (name "signIn")
    what its sign-in kept: all the names given, in one write"""
    secrets_file(path)
    if not names or not all(isinstance(n, str) and (n in ("*", "signIn") or re.match(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}\Z", n)) for n in names):
        raise Bad("not a secret's name")
    with secrets_locked(path):
        # forgetting every secret needs nothing from the file; anything less
        # keeps the rest, so it must be read
        data = {"user": {}, "signIn": {"server": "", "values": {}}} if "*" in names else read_secrets(path, changing=True)
        for name in names:
            if name == "*":
                data = {"user": {}, "signIn": {"server": "", "values": {}}}
            elif name == "signIn":
                data["signIn"] = {"server": "", "values": {}}
            else:
                data["user"].pop(name, None)
        write_json(path, data)
    return {"ok": True}


# ---- the guide's own private files (app-screens.json, settings.json) ---------

# their names, and how big each may be
PRIVATE_FILES = {"app-screens.json": 64 * 1024, "settings.json": 1024 * 1024, "lock.json": 1024 * 1024}
# the file layer, one place (the tests make each step fail in turn)
_fs = os


def private_limit(path):
    """One of the guide's own files, by its full path: a known name. Its cap"""
    if not isinstance(path, str) or not path.startswith("/") or os.path.basename(path) not in PRIVATE_FILES:
        raise Bad("not one of the guide's files")
    return PRIVATE_FILES[os.path.basename(path)]


def do_private_read(path):
    """One read through its descriptor: never a link, a plain file, no
    bigger than its cap, UTF-8. {ok, text}; {ok, text: "", missing} if it
    isn't there; else {ok: false, code, error} in the guide's words"""
    limit = private_limit(path)
    try:
        fd = _fs.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return {"ok": True, "text": "", "missing": True}
    except OSError:
        return {"ok": False, "code": "unreadable", "error": "it couldn't be read (a link, or not yours)"}
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return {"ok": False, "code": "notfile", "error": "it isn't a plain file"}
        data = f.read(limit + 1)
    if len(data) > limit:
        return {"ok": False, "code": "toobig", "error": "it's bigger than " + str(limit // 1024) + " KB"}
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return {"ok": False, "code": "text", "error": "it isn't text"}
    return {"ok": True, "text": text}


def do_private_write(path, data):
    """Written and made durable, and how that went said exactly: a new name
    (made 0600 from the first byte, exclusive, never a link) written and
    synced, read back byte for byte, renamed over the file (the commit),
    then its folder synced. saved only after that last sync; unconfirmed if
    only it failed (the new file is in place, but a power cut could bring
    back the old one); failed, with nothing changed, for anything up to and
    including the rename (the new name is removed)."""
    limit = private_limit(path)
    if len(data) > limit:
        return {"ok": False, "outcome": "failed", "why": "too big"}
    folder = os.path.dirname(path)
    tmp = None
    try:
        _fs.makedirs(folder, mode=0o700, exist_ok=True)
        if not stat.S_ISDIR(os.lstat(folder).st_mode):
            raise OSError("not a folder")
        tmp = os.path.join(folder, "." + os.path.basename(path) + ".tmp-" + secrets.token_hex(6))
        fd = _fs.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            _fs.fsync(f.fileno())
        fd = _fs.open(tmp, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        with os.fdopen(fd, "rb") as f:
            if f.read(limit + 1) != data:
                raise OSError("it read back different")
        _fs.replace(tmp, path)
        tmp = None
    except OSError:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        return {"ok": False, "outcome": "failed", "why": "it couldn't be written"}
    try:
        dfd = _fs.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            _fs.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError:
        return {"ok": True, "outcome": "unconfirmed", "why": "the disk hasn't confirmed it"}
    return {"ok": True, "outcome": "saved"}


# ---- pictures you pick, and themes saved as one confirmed transaction ---------

MAX_PICTURE = 40 * 1024 * 1024
MAX_PICTURE_SIDE = 8192
MAX_PICTURE_PIXELS = 40 * 1000 * 1000
PICTURE_EXT = {"png": "png", "jpeg": "jpg", "webp": "webp"}
THEME_ID = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}\Z")
# The only names the guide writes in a theme's folder, and so the only ones
# it ever deletes there: a save's copies (pic-<16 hex>.<ext>) and its
# theme.json before the commit (.theme-<16 hex>.json.tmp); and the old shell
# writer's, which named copies after their area (masthead.png,
# background.jpg, home-background.webp...) with .<name>.tmp beside them
PIC_NAME = re.compile(r"^pic-[0-9a-f]{16}\.(?:png|jpg|webp)\Z")
TEMP_NAME = re.compile(r"^\.theme-[0-9a-f]{16}\.json\.tmp\Z")
OLD_AREAS = "masthead|infoPanel|header|band|channelCell|cell|lt|card|box|background|home-background"
OLD_PIC_NAME = re.compile(r"^(?:" + OLD_AREAS + r")\.(?:png|jpg|webp)\Z")
OLD_TEMP_NAME = re.compile(r"^\.(?:theme\.json|(?:" + OLD_AREAS + r")\.(?:png|jpg|webp))\.tmp\Z")


def guide_wrote(name):
    """A name only the guide writes in a theme's folder"""
    return bool(PIC_NAME.match(name) or OLD_PIC_NAME.match(name) or TEMP_NAME.match(name) or OLD_TEMP_NAME.match(name))
MAX_THEME_TEXT = 256 * 1024
MAX_REQUEST = 512 * 1024


def user_picture(path):
    """A picture you picked: opened without following a link, checked through
    that open file (a plain file, at most 40 MiB, PNG, JPEG or WebP by its
    first bytes, at most 8192 pixels a side and 40 MP). (bytes, extension)"""
    if not isinstance(path, str) or not path.startswith("/") or "\0" in path or len(path) > 4096:
        raise Bad("a picture is given by its full path")
    try:
        fd = _fs.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise Bad("a picture couldn't be read (it isn't there, it's a link, or it isn't yours)")
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        os.close(fd)
        raise Bad("a picture isn't a plain file")
    with os.fdopen(fd, "rb") as f:
        if st.st_size > MAX_PICTURE:
            raise Bad("a picture is bigger than 40 MB")
        data = f.read(MAX_PICTURE + 1)
    if len(data) > MAX_PICTURE:
        raise Bad("a picture is bigger than 40 MB")
    info = image_info(data)
    if not info:
        raise Bad("a picture isn't a PNG, JPEG or WebP")
    kind, w, h = info
    if not (0 < w <= MAX_PICTURE_SIDE and 0 < h <= MAX_PICTURE_SIDE) or w * h > MAX_PICTURE_PIXELS:
        raise Bad("a picture is bigger than 8192 pixels a side or 40 megapixels")
    return data, PICTURE_EXT[kind]


def write_new(folder, name, data, made=None):
    """A new file, ours from the first byte (0600, exclusive, never a link),
    synced; once it exists, its name is added to made (so a failure after
    that takes it away, and never a file that was there before)"""
    fd = _fs.open(os.path.join(folder, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    if made is not None:
        made.append(name)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
        f.flush()
        _fs.fsync(f.fileno())


def sync_folder(folder):
    dfd = _fs.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        _fs.fsync(dfd)
    finally:
        os.close(dfd)


def plain_dir(path):
    """A folder of ours, by its own name: never a link"""
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def theme_pictures(theme):
    """Where a theme names pictures: (the part, its key) for each one given"""
    out = []
    images = theme.get("images")
    if isinstance(images, dict):
        for spec in images.values():
            if isinstance(spec, dict) and isinstance(spec.get("src"), str) and spec["src"]:
                out.append((spec, "src"))
    home = theme.get("home")
    apps = theme.get("apps")
    multiview = theme.get("multiview")
    for part in (theme.get("background"), home.get("background") if isinstance(home, dict) else None,
                 apps.get("background") if isinstance(apps, dict) else None,
                 multiview.get("background") if isinstance(multiview, dict) else None):
        if isinstance(part, dict) and isinstance(part.get("image"), str) and part["image"]:
            out.append((part, "image"))
    return out


def named_in(theme):
    """The files in its folder a theme names (plain names only)"""
    return {part[key] for part, key in theme_pictures(theme) if "/" not in part[key] and part[key] not in (".", "..")}


def read_theme(folder):
    """theme.json read afresh through its descriptor (never a link, a plain
    file, bounded): ("ok", the theme), ("missing", None) or ("bad", None)"""
    try:
        fd = _fs.open(os.path.join(folder, "theme.json"), os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return "missing", None
    except OSError:
        return "bad", None
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        return "bad", None
    with os.fdopen(fd, "rb") as f:
        data = f.read(MAX_THEME_TEXT + 1)
    if len(data) > MAX_THEME_TEXT:
        return "bad", None
    try:
        theme = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return "bad", None
    return ("ok", theme) if isinstance(theme, dict) else ("bad", None)


def theme_request(raw):
    try:
        req = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Bad("not a request")
    themes = req.get("dir") if isinstance(req, dict) else None
    if not isinstance(themes, str) or not themes.startswith("/") or "\0" in themes:
        raise Bad("not a request")
    return req, themes


def unlink_plain(path):
    """Takes a plain file away (never a link's target, nor a folder)"""
    try:
        if stat.S_ISREG(os.lstat(path).st_mode):
            _fs.unlink(path)
            return True
    except OSError:
        pass
    return False


def do_theme_save(raw):
    """A theme saved as one confirmed transaction. Each picture it names (a
    full path) is checked and copied into its folder under a new name, and
    synced; the new theme.json is written under a temporary name and synced;
    the folder is synced (for a new theme, the themes folder too), so every
    new name is on disk before anything points at it; the temporary file is
    read back byte for byte, with every picture it names in the folder; it's
    renamed over theme.json (the commit); the folder is synced. saved only
    after that last sync; unconfirmed if only it failed (nothing that depends
    on it should happen yet); failed for anything up to and including the
    rename, with every name it made taken away and the old folder as it was.
    Answers the theme as written (pictures by their new names) and, once
    saved, the names only the old theme.json named (theme-tidy takes those
    once the guide has put the new one on)."""
    req, themes = theme_request(raw)
    tid, theme = req.get("id"), req.get("theme")
    if not isinstance(tid, str) or not THEME_ID.match(tid) or tid == "retro" or not isinstance(theme, dict):
        raise Bad("not a theme to save")
    folder = os.path.join(themes, tid)
    made = []
    new_folder = False
    try:
        _fs.makedirs(themes, mode=0o700, exist_ok=True)
        if not plain_dir(themes):
            raise Bad("the themes folder isn't a folder")
        try:
            _fs.mkdir(folder, 0o700)
            new_folder = True
        except FileExistsError:
            if not plain_dir(folder):
                raise Bad("its folder isn't a folder")
        was, old = read_theme(folder)
        old_named = named_in(old) if was == "ok" else set()
        theme = json.loads(json.dumps(theme))
        named = []
        for part, key in theme_pictures(theme):
            data, ext = user_picture(part[key])
            name = "pic-" + secrets.token_hex(8) + "." + ext
            write_new(folder, name, data, made)
            part[key] = name
            named.append(name)
        text = (json.dumps(theme, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
        if len(text) > MAX_THEME_TEXT:
            raise Bad("the theme is too big")
        tmp = ".theme-" + secrets.token_hex(8) + ".json.tmp"
        write_new(folder, tmp, text, made)
        sync_folder(folder)
        if new_folder:
            sync_folder(themes)
        fd = _fs.open(os.path.join(folder, tmp), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        with os.fdopen(fd, "rb") as f:
            if f.read(MAX_THEME_TEXT + 1) != text:
                raise OSError("it read back different")
        for name in named:
            if not stat.S_ISREG(os.lstat(os.path.join(folder, name)).st_mode):
                raise OSError("a picture isn't there")
        _fs.replace(os.path.join(folder, tmp), os.path.join(folder, "theme.json"))
        made.remove(tmp)
    except (Bad, OSError) as e:
        for name in made:
            try:
                os.unlink(os.path.join(folder, name))
            except OSError:
                pass
        if new_folder:
            try:
                os.rmdir(folder)
            except OSError:
                pass
        return {"ok": False, "outcome": "failed", "why": str(e) if isinstance(e, Bad) else "it couldn't be written"}
    try:
        sync_folder(folder)
    except OSError:
        return {"ok": True, "outcome": "unconfirmed", "why": "the disk hasn't confirmed it", "theme": theme, "old": []}
    return {"ok": True, "outcome": "saved", "theme": theme, "old": sorted(n for n in old_named - set(named) if PIC_NAME.match(n) or OLD_PIC_NAME.match(n))}


def do_theme_tidy(raw):
    """After a saved theme is on: the pictures only its old theme.json named
    (given), and its old single-file form, taken away; only names the guide
    writes (a save's copies, the old writer's area names), only ones its
    theme.json, read afresh, doesn't name, and only plain files"""
    req, themes = theme_request(raw)
    tid, drop = req.get("id"), req.get("drop")
    if not isinstance(tid, str) or not THEME_ID.match(tid) or not isinstance(drop, list):
        raise Bad("not a theme to tidy")
    folder = os.path.join(themes, tid)
    if not plain_dir(folder):
        return {"ok": True, "removed": 0}
    was, theme = read_theme(folder)
    if was != "ok":
        return {"ok": True, "removed": 0}
    keep = named_in(theme)
    n = 0
    for name in drop[:64]:
        if isinstance(name, str) and (PIC_NAME.match(name) or OLD_PIC_NAME.match(name)) and name not in keep:
            n += unlink_plain(os.path.join(folder, name))
    n += unlink_plain(os.path.join(themes, tid + ".json"))
    return {"ok": True, "removed": n}


def do_theme_sweep(raw):
    """What a save cut off by a crash left: in each theme folder, once it's
    synced (so the theme.json in it now is the one that survives), the copies
    in a save's naming that a fresh read of its theme.json doesn't name, and
    the guide's temporary files (its own and the old writer's names only). A folder that won't sync, or whose theme.json can't be
    read or checked, keeps everything; one with no theme.json names nothing
    (a first save that never committed), and goes once it's empty. The guide
    runs this only while it holds the turn theme changes take."""
    req, themes = theme_request(raw)
    removed = 0
    try:
        entries = sorted(os.listdir(themes))
    except OSError:
        return {"ok": True, "removed": 0}
    for entry in entries:
        folder = os.path.join(themes, entry)
        if not THEME_ID.match(entry) or not plain_dir(folder):
            continue
        try:
            sync_folder(folder)
        except OSError:
            continue
        was, theme = read_theme(folder)
        if was == "bad":
            continue
        keep = named_in(theme) if was == "ok" else set()
        try:
            names = os.listdir(folder)
        except OSError:
            continue
        for name in names:
            if (PIC_NAME.match(name) and name not in keep) or TEMP_NAME.match(name) or OLD_TEMP_NAME.match(name):
                removed += unlink_plain(os.path.join(folder, name))
        if was == "missing":
            try:
                os.rmdir(folder)
            except OSError:
                pass
    return {"ok": True, "removed": removed}


def do_theme_remove(raw):
    """One of your themes taken away: its theme.json (or its old single
    file) first, which is the commit, then the folder synced and the themes
    folder too; only after that, the files in its folder the guide wrote
    (its copies and temporary files, by their names), and the folder once
    it's empty. unconfirmed if a sync failed (its pictures stay, so a theme.json
    a power cut brings back still loads whole); failed if nothing was taken"""
    req, themes = theme_request(raw)
    tid = req.get("id")
    if not isinstance(tid, str) or not THEME_ID.match(tid) or tid == "retro":
        raise Bad("not a theme to remove")
    folder = os.path.join(themes, tid)
    flat = os.path.join(themes, tid + ".json")
    took = False
    try:
        if plain_dir(folder):
            try:
                _fs.unlink(os.path.join(folder, "theme.json"))
                took = True
            except FileNotFoundError:
                pass
        try:
            if stat.S_ISREG(os.lstat(flat).st_mode):
                _fs.unlink(flat)
                took = True
        except FileNotFoundError:
            pass
    except OSError:
        return {"ok": False, "outcome": "failed", "why": "it couldn't be removed"}
    if not took and not plain_dir(folder):
        return {"ok": False, "outcome": "failed", "why": "it isn't there"}
    try:
        if plain_dir(folder):
            sync_folder(folder)
        sync_folder(themes)
    except OSError:
        return {"ok": True, "outcome": "unconfirmed", "why": "the disk hasn't confirmed it"}
    # only what the guide wrote there; the folder goes only if nothing else is in it
    if plain_dir(folder):
        for name in os.listdir(folder):
            if guide_wrote(name):
                unlink_plain(os.path.join(folder, name))
        try:
            os.rmdir(folder)
            sync_folder(themes)
        except OSError:
            pass
    return {"ok": True, "outcome": "saved"}


def do_picture_import(raw):
    """A picture you picked, copied into the guide's own folder (configDir/
    app-pictures, 0700) as <32 hex>.<ext>, 0600, checked as user_picture
    says and synced; only the copy is shown. {ok, path}"""
    try:
        req = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Bad("not a request")
    into, src = req.get("into") if isinstance(req, dict) else None, req.get("from") if isinstance(req, dict) else None
    if not isinstance(into, str) or not into.startswith("/") or os.path.basename(into) != "app-pictures" or "\0" in into:
        raise Bad("not the guide's pictures folder")
    data, ext = user_picture(src)
    try:
        _fs.makedirs(into, mode=0o700, exist_ok=True)
        if not plain_dir(into):
            raise Bad("the pictures folder isn't a folder")
        name = secrets.token_hex(16) + "." + ext
        write_new(into, name, data)
        sync_folder(into)
    except OSError:
        raise Bad("it couldn't be copied")
    return {"ok": True, "path": os.path.join(into, name)}


PICTURE_COPY = re.compile(r"^[0-9a-f]{32}\.(?:png|jpg|webp)\Z")


def do_picture_prune(raw):
    """The guide's copies of pictures you picked that no choice names any
    more (keep: the names still named), taken away: only its own names, plain
    files, and only ones older than ten minutes (a pick may be on its way)"""
    try:
        req = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Bad("not a request")
    into, keep = req.get("into") if isinstance(req, dict) else None, req.get("keep") if isinstance(req, dict) else None
    if not isinstance(into, str) or not into.startswith("/") or os.path.basename(into) != "app-pictures" or not isinstance(keep, list):
        raise Bad("not the guide's pictures folder")
    keep = {k for k in keep if isinstance(k, str)}
    if not plain_dir(into):
        return {"ok": True, "removed": 0}
    removed = 0
    old = time.time() - 600
    for name in os.listdir(into):
        path = os.path.join(into, name)
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if PICTURE_COPY.match(name) and name not in keep and stat.S_ISREG(st.st_mode) and st.st_mtime < old:
            removed += unlink_plain(path)
    return {"ok": True, "removed": removed}


def load_appnet():
    import importlib.util
    from importlib.machinery import SourceFileLoader
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib", "appnet.py")
    loader = SourceFileLoader("appnet", path)
    spec = importlib.util.spec_from_file_location("appnet", path, loader=loader)
    net = importlib.util.module_from_spec(spec)
    loader.exec_module(net)
    return net


def do_cert(raw):
    """A server's certificate, for you to pin: its SHA-256 (of the DER), and
    whether this computer's own trust store already vouches for it"""
    import socket
    import ssl
    net = load_appnet()
    try:
        base = net.normalize_base(raw)
    except net.NetError as e:
        raise Bad(str(e))
    if base.scheme != "https":
        raise Bad("it isn't https, so there's no certificate")
    host = base.bare_host
    try:
        with socket.create_connection((host, base.port), timeout=10) as sock:
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            with ctx.wrap_socket(sock, server_hostname=host) as tls:
                der = tls.getpeercert(binary_form=True)
    except (OSError, ssl.SSLError) as e:
        raise Bad("couldn't reach it (" + str(getattr(e, "strerror", None) or e)[:100] + ")")
    if not der:
        raise Bad("it sent no certificate")
    verified = True
    try:
        with socket.create_connection((host, base.port), timeout=10) as sock:
            with ssl.create_default_context().wrap_socket(sock, server_hostname=host):
                pass
    except (OSError, ssl.SSLError):
        verified = False
    return {"ok": True, "sha256": hashlib.sha256(der).hexdigest(), "verified": verified}


def do_forget(what, app_id, source, roots):
    """What a sign-out, a new server or Clear its data takes away, done by the
    guide itself once the app has stopped (whatever the app said):
    signIn and server: the secrets its sign-in kept, its storage marked
    server, its pictures; data: all its storage, and its Activity"""
    if what not in ("signIn", "server", "data"):
        raise Bad("forget signIn, server or data")
    if not ID_RE.match(app_id):
        raise Bad("not an app's id")
    sdir = source_dir(source)
    r = roots if isinstance(roots, dict) else {}
    def under(key, rel):
        root = r.get(key)
        if not isinstance(root, str) or not root.startswith("/"):
            return None
        path = os.path.join(root, sdir, rel)
        return path if inside(path, root) else None
    store = under("store", app_id + ".json")
    seen = under("activity", app_id + ".json")
    if what == "data" and seen and os.path.lexists(seen):
        remove_tree(seen)
    if store and os.path.lexists(store):
        if what == "data":
            remove_tree(store)
        else:
            try:
                with open_plain(store, follow=False) as f:
                    d = json.loads(f.read(16 * 1024 * 1024).decode("utf-8"))
                keys = {k: v for k, v in (d.get("keys") or {}).items() if isinstance(v, dict) and v.get("s") is not True}
                write_json(store, {"v": 1, "keys": keys})
            except (OSError, ValueError, AttributeError):
                remove_tree(store)   # unreadable: nothing in it can be told apart
    if what in ("signIn", "server"):
        sec = under("secrets", app_id + ".json")
        if sec and os.path.lexists(sec):
            do_secret_clear(sec, "signIn")
        img = under("images", app_id)
        if img and os.path.lexists(img):
            remove_tree(img)
    return {"ok": True}


def do_activity(app_id, source, roots):
    """An app's Activity as totals for the guide: the file read bounded and
    checked field by field (lib/appactivity.py), nothing in it trusted"""
    if not ID_RE.match(app_id):
        raise Bad("not an app's id")
    sdir = source_dir(source)
    root = (roots if isinstance(roots, dict) else {}).get("activity")
    if not isinstance(root, str) or not root.startswith("/"):
        raise Bad("no Activity folder")
    path = os.path.join(root, sdir, app_id + ".json")
    seen = load_lib("appactivity")
    raw = None
    if inside(path, root) and os.path.lexists(path):
        try:
            with open_plain(path, follow=False) as f:
                raw = f.read(seen.MAX_FILE * 2 + 1)
        except OSError:
            raw = None
        if raw is not None and len(raw) > seen.MAX_FILE * 2:
            raw = None
    return dict({"ok": True}, **seen.Activity(raw).summary())


def source_list(data, base, seen):
    """A source's list, its signature good: checked as the catalog is, plus
    apps with code (lib/appsources.py's check_list)"""
    cat = parse_catalog(data, base, seen, check_source_entry)
    return dict(cat, apps=sorted(cat["apps"].values(), key=lambda a: a["name"].lower()))


_LIBS = {}


