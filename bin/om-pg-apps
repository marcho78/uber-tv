        _LIBS["appfiles"] = load_lib("appfiles")
    return _LIBS["appfiles"]




PUBLISHER_JSON_MAX = 64 * 1024
PUBLISHER_HISTORY_MAX = 512 * 1024
PUBLISHER_MAX_APPS = 500
PUBLISHER_MAX_ENTRIES = 2000


def do_app_key(folder):
    """Initialize one permanent, private publisher workspace and key."""
    folder = os.path.abspath(folder)
    if not sys.stdin.isatty():
        raise Bad("run it in a terminal: ssh-keygen asks for a passphrase for the key, and that's yours to type")
    if os.path.lexists(folder):
        if os.path.islink(folder) or not os.path.isdir(folder):
            raise Bad("the publisher folder must be a plain folder, not a link")
        if os.listdir(folder):
            raise Bad("that publisher folder isn't empty")
        os.chmod(folder, 0o700)
    else:
        os.mkdir(folder, 0o700)
    try:
        dfd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        raise Bad("the publisher folder can't be opened: " + said_of(e))
    key = ""
    try:
        fcntl.flock(dfd, fcntl.LOCK_EX)
        if os.listdir(from_start(dfd)):
            raise Bad("that publisher folder isn't empty")
        ssh = os.path.join(os.path.expanduser("~"), ".ssh")
        if os.path.lexists(ssh) and (os.path.islink(ssh) or not os.path.isdir(ssh)):
            raise Bad("~/.ssh must be a plain folder, not a link")
        os.makedirs(ssh, mode=0o700, exist_ok=True)
        os.chmod(ssh, 0o700)
        slug = re.sub(r"[^a-z0-9]+", "-", os.path.basename(folder).lower()).strip("-")[:40] or "publisher"
        key = os.path.join(ssh, "uber-tv-app-" + slug + "-" + secrets.token_hex(4))
        if os.path.lexists(key) or os.path.lexists(key + ".pub"):
            raise Bad("a key unexpectedly already has the new key's name")
        try:
            result = subprocess.run(["/usr/bin/ssh-keygen", "-t", "ed25519", "-f", key,
                                     "-C", "Uber TV app publisher " + os.path.basename(folder)])
        except OSError as e:
            raise Bad("ssh-keygen couldn't be run: " + said_of(e))
        if result.returncode != 0:
            raise Bad("ssh-keygen didn't make the publisher key")
        try:
            public = APPFILES().read_plain(key + ".pub", APPFILES().MAX_PUB, "the publisher key")
            line, fingerprint = APPFILES().parse_key(b" ".join(public.split()[:2]))
        except APPFILES().Problem as e:
            raise Bad(str(e))
        conf = (json.dumps({"format": 1, "key": key, "public": line, "fingerprint": fingerprint},
                           sort_keys=True, separators=(",", ":")) + "\n").encode()
        history = b'{"apps":{},"format":1}\n'
        write_at(dfd, "publisher.json", conf)
        write_at(dfd, "history.json", history)
        chmod_at(dfd, "publisher.json", 0o600)
        chmod_at(dfd, "history.json", 0o600)
        os.fsync(dfd)
    finally:
        os.close(dfd)
    return {"ok": True, "folder": folder, "key": key, "fingerprint": fingerprint,
            "next": "om-pg-apps app-file <app folder> " + folder + " [update address]"}


def publisher_history(raw):
    bad = "the publisher's private history can't be read; put back history.json from the workspace"
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError, RecursionError):
        raise Bad(bad)
    if (not isinstance(data, dict) or set(data) != {"format", "apps"} or data.get("format") != 1
            or not isinstance(data.get("apps"), dict) or len(data["apps"]) > PUBLISHER_MAX_APPS):
        raise Bad(bad)
    apps = {}
    for app_id, record in data["apps"].items():
        if (not isinstance(app_id, str) or not ID_RE.match(app_id) or not isinstance(record, dict)
                or set(record) != {"folder", "updated", "sha256", "revoked"}
                or not isinstance(record.get("folder"), str) or "/" in record["folder"] or not record["folder"]
                or len(record["folder"]) > 255 or not isinstance(record.get("updated"), int)
                or isinstance(record["updated"], bool) or not 0 < record["updated"] < 2 ** 53
                or not isinstance(record.get("sha256"), str) or not SHA_RE.match(record["sha256"])):
            raise Bad(bad)
        apps[app_id] = dict(record, revoked=checked_state_revoked(record["revoked"]))
    return {"format": 1, "apps": apps}


def open_publisher(folder):
    """Open, lock and authenticate an initialized publisher workspace."""
    folder = os.path.abspath(folder)
    try:
        dfd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        raise Bad("that isn't a publisher workspace (app-key makes one): " + said_of(e))
    try:
        mode = stat.S_IMODE(os.fstat(dfd).st_mode)
        if mode & 0o077:
            raise Bad("the publisher workspace isn't private; make its folder mode 0700")
        fcntl.flock(dfd, fcntl.LOCK_EX)
        conf_raw = read_at(dfd, "publisher.json", PUBLISHER_JSON_MAX)
        history_raw = read_at(dfd, "history.json", PUBLISHER_HISTORY_MAX)
        conf = json.loads(conf_raw.decode("utf-8"))
        if (not isinstance(conf, dict) or set(conf) != {"format", "key", "public", "fingerprint"}
                or conf.get("format") != 1 or not isinstance(conf.get("key"), str) or not os.path.isabs(conf["key"])
                or not isinstance(conf.get("public"), str) or not isinstance(conf.get("fingerprint"), str)):
            raise ValueError()
        line, fingerprint = APPFILES().parse_key(conf["public"].encode())
        if fingerprint != conf["fingerprint"] or own_pub(conf["key"]) != line:
            raise ValueError()
        history = publisher_history(history_raw)
        return folder, dfd, conf, history_raw, history
    except (OSError, ValueError, KeyError, TypeError, APPFILES().Problem, Bad) as e:
        os.close(dfd)
        if isinstance(e, Bad):
            raise
        raise Bad("that isn't a publisher workspace (app-key makes one): " + str(e)[:100])


def publisher_record(name, app):
    return {"folder": name, "updated": app["release"]["updated"],
            "sha256": hashlib.sha256(app["raw"]).hexdigest(), "revoked": app["release"]["revoked"]}


def read_finished_release(dfd, name, line, wanted=""):
    """A complete immutable release folder, or None when incomplete."""
    try:
        rfd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    except OSError:
        return None
    try:
        names = set(os.listdir(from_start(rfd)))
        core = {"release.json", "release.json.sig", "package.tar.gz"}
        if not core <= names:
            return None
        try:
            data = read_at(rfd, "release.json", MAX_RELEASE)
            sig = read_at(rfd, "release.json.sig", MAX_SIGNATURE)
            package = read_at(rfd, "package.tar.gz", MAX_PACKAGE)
            key = read_at(rfd, "key.pub", APPFILES().MAX_PUB)
            parsed, _ = APPFILES().parse_key(key)
            if parsed != line:
                raise Bad("its key isn't the publisher workspace's key")
            APPFILES().verify(data, sig, line)
            checked = check_app_release(data)
            entry = checked["entry"]
            app_file = entry["id"] + "-" + entry["version"] + ".tvapp"
            if names != core | {"key.pub", app_file}:
                raise Bad("it has files a finished release doesn't")
            if len(package) != entry["size"] or hashlib.sha256(package).hexdigest() != entry["sha256"]:
                raise Bad("its package isn't the one its release names")
            got = read_app_file("/proc/self/fd/%d/%s" % (rfd, app_file))
            if got["raw"] != data or got["signature"] != sig or got["package"] != package:
                raise Bad("its app file isn't made from its release")
            if wanted and entry["id"] != wanted:
                return None
            return dict(checked, key=line, signature=sig, package=package,
                        source=APPFILES().source_id(line), folder=name)
        except (OSError, APPFILES().Problem) as e:
            raise Bad("the finished release " + name + " can't be verified: " + str(e)[:100])
    finally:
        os.close(rfd)


def exact_revocations(rows):
    return {(row["version"], row["reason"]) for row in rows}


def publisher_tip(dfd, line, app_id, history):
    """Verify the recorded tip and adopt only a safe crash-complete successor."""
    record = history["apps"].get(app_id)
    tip = None
    if record:
        tip = read_finished_release(dfd, record["folder"], line, app_id)
        if (tip is None or tip["release"]["updated"] != record["updated"]
                or hashlib.sha256(tip["raw"]).hexdigest() != record["sha256"]
                or exact_revocations(tip["release"]["revoked"]) != exact_revocations(record["revoked"])):
            raise Bad("the publisher's recorded release for " + app_id + " is missing or changed; put it back before publishing")
    names = os.listdir(from_start(dfd))
    if len(names) > PUBLISHER_MAX_ENTRIES:
        raise Bad("the publisher workspace has too many entries")
    candidates = []
    release_name = re.compile(r"^" + re.escape(app_id) + r"-(?:0|[1-9]\d{0,4})\.(?:0|[1-9]\d{0,4})\.(?:0|[1-9]\d{0,4})-[1-9]\d{0,15}\Z")
    for name in names:
        if name.startswith(".") or not release_name.match(name) or (record and name == record["folder"]):
            continue
        app = read_finished_release(dfd, name, line, app_id)
        if app is not None:
            candidates.append(app)
    candidates.sort(key=lambda app: app["release"]["updated"])
    for candidate in candidates:
        if tip:
            old, new = tip["release"]["updated"], candidate["release"]["updated"]
            if new < old:
                continue
            if new == old:
                if candidate["raw"] != tip["raw"]:
                    raise Bad("two finished releases for " + app_id + " have the same time but different contents")
                continue
            if not exact_revocations(tip["release"]["revoked"]) <= exact_revocations(candidate["release"]["revoked"]):
                raise Bad("a finished release after the recorded one drops a withdrawal, so it was refused")
        tip = candidate
    return tip


def replace_publisher_history(dfd, before, history):
    """Atomically advance the one private history file under the workspace lock."""
    data = (json.dumps(history, sort_keys=True, separators=(",", ":")) + "\n").encode()
    if len(data) > PUBLISHER_HISTORY_MAX:
        raise Bad("the publisher's private history would be too big")
    if read_at(dfd, "history.json", PUBLISHER_HISTORY_MAX) != before:
        raise Bad("history.json changed while this run worked, so the finished release was left for the next run to adopt")
    name = ".history-" + secrets.token_hex(8)
    write_at(dfd, name, data)
    made = inode_at(dfd, name)
    committed = False
    try:
        chmod_at(dfd, name, 0o600)
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(name, "history.json", src_dir_fd=dfd, dst_dir_fd=dfd)
        committed = True
        os.fsync(dfd)
        return ""
    except BaseException as error:
        try:
            on_disk = read_at(dfd, "history.json", PUBLISHER_HISTORY_MAX) == data
        except (OSError, Bad):
            on_disk = False
        if committed or on_disk:
            return "The release and its private history are in place, but the folder couldn't be synced (" + said_of(error) + ")."
        try:
            clear_own(dfd, {made})
        except OSError:
            pass
        raise Bad("the release finished, but its private history wasn't advanced (" + said_of(error) + "); the next run will verify and adopt it")


def tvapp_bytes(line, data, sig, package):
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w", format=tarfile.USTAR_FORMAT) as archive:
        for name, body in (("key.pub", (line + "\n").encode()), ("release.json", data),
                           ("release.json.sig", sig), ("package.tar.gz", package)):
            info = tarfile.TarInfo(name)
            info.size, info.mode, info.mtime = len(body), 0o644, 0
            archive.addfile(info, io.BytesIO(body))
    out = buf.getvalue()
    if len(out) > MAX_APP_FILE:
        raise Bad("the app file would be bigger than 25 MB")
    return out


def finish_release(dfd, folder, line, key, release, package):
    """Write a new immutable release; its signature is published last."""
    try:
        os.mkdir(folder, 0o700, dir_fd=dfd)
    except FileExistsError:
        raise Bad("the new release folder already exists, so nothing was overwritten")
    rfd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dfd)
    try:
        entry = release["entry"]
        write_at(rfd, "key.pub", (line + "\n").encode())
        write_at(rfd, "package.tar.gz", package)
        write_at(rfd, ".release.json", release["raw"])
        try:
            result = subprocess.run(["/usr/bin/ssh-keygen", "-Y", "sign", "-f", os.path.abspath(key),
                                     "-n", APPFILES().NAMESPACE, ".release.json"], cwd="/proc/self/fd/%d" % rfd)
        except OSError as e:
            raise Bad("ssh-keygen couldn't sign the release: " + said_of(e))
        if result.returncode != 0:
            raise Bad("ssh-keygen didn't sign the release")
        sig = read_at(rfd, ".release.json.sig", MAX_SIGNATURE)
        try:
            APPFILES().verify(release["raw"], sig, line)
        except APPFILES().Problem as e:
            raise Bad(str(e))
        app_name = entry["id"] + "-" + entry["version"] + ".tvapp"
        write_at(rfd, app_name, tvapp_bytes(line, release["raw"], sig, package))
        # Persist every byte and every non-marker name before the public
        # signature says this folder is a finished release.  A crash before
        # that marker therefore leaves only an incomplete folder, which the
        # next run ignores; if the marker survives, all of its inputs do too.
        for name in ("key.pub", "package.tar.gz", ".release.json", ".release.json.sig", app_name):
            sync_at(rfd, name)
        rename_at(".release.json", "release.json", RENAME_NOREPLACE, src_dir_fd=rfd, dst_dir_fd=rfd)
        os.fsync(rfd)
        rename_at(".release.json.sig", "release.json.sig", RENAME_NOREPLACE, src_dir_fd=rfd, dst_dir_fd=rfd)
        os.fsync(rfd)
        os.fsync(dfd)
    finally:
        os.close(rfd)
    made = read_finished_release(dfd, folder, line, entry["id"])
    if made is None:
        raise Bad("the new release didn't finish")
    return made


def release_document(entry, manifest, updated, updates, revoked):
    package = {"url": "package.tar.gz",
               "sha256": entry["sha256"], "size": entry["size"]}
    doc = {"format": 1, "id": entry["id"], "version": entry["version"], "name": entry["name"],
           "author": entry["author"], "description": entry["description"], "color": entry["color"],
           "kind": entry["kind"], "api": manifest["api"], "permissions": entry["permissions"],
           "updated": updated, "package": package, "updates": updates, "revoked": revoked}
    raw = (json.dumps(doc, sort_keys=True, separators=(",", ":")) + "\n").encode()
    checked = check_app_release(raw)
    return dict(checked, raw=raw)


def do_app_file(app_folder, publisher, updates=None):
    """Pack and sign one new version in its publisher workspace."""
    folder, dfd, conf, history_raw, history = open_publisher(publisher)
    try:
        line, key = conf["public"], conf["key"]
        package, entry, manifest = pack_bytes(app_folder)
        tip = publisher_tip(dfd, line, entry["id"], history)
        if tip and version_key(entry["version"]) <= version_key(tip["entry"]["version"]):
            raise Bad("a new app file's version must be newer than the recorded release")
        try:
            update_folder = APPFILES().update_folder(NET(), updates)
        except APPFILES().Problem as e:
            raise Bad(str(e))
        revoked = list(tip["release"]["revoked"]) if tip else []
        if withdrawn(revoked, entry["version"]):
            raise Bad("that version is withdrawn; publish a newer version")
        updated = max(int(time.time()), (tip["release"]["updated"] + 1) if tip else 1)
        release = release_document(entry, manifest, updated, update_folder, revoked)
        name = entry["id"] + "-" + entry["version"] + "-" + str(updated)
        made = finish_release(dfd, name, line, key, release, package)
        history["apps"][entry["id"]] = publisher_record(name, made)
        warning = replace_publisher_history(dfd, history_raw, history)
    finally:
        os.close(dfd)
    path = os.path.join(folder, name)
    out = {"ok": True, "folder": path, "appFile": os.path.join(path, entry["id"] + "-" + entry["version"] + ".tvapp"),
            "id": entry["id"], "version": entry["version"], "updated": updated,
            "fingerprint": conf["fingerprint"], "upload": ["release.json", "release.json.sig", "package.tar.gz"]}
    if warning:
        out["warning"] = warning
    return out


def do_app_revoke(publisher, app_id, version, reason):
    """Sign a newer note with one cumulative withdrawal added."""
    if not isinstance(app_id, str) or not ID_RE.match(app_id):
        raise Bad("an app's id is like tv.alex.clock")
    if version != "*" and (not isinstance(version, str) or not VERSION_RE.match(version)):
        raise Bad("a version is like 1.2.0, or * for every version")
    if (not isinstance(reason, str) or not 1 <= len(reason) <= 200 or not reason.isprintable()
            or any(unicodedata.category(c) in ("Cc", "Cf", "Co", "Cs") for c in reason)):
        raise Bad("a reason is 1 to 200 visible characters")
    folder, dfd, conf, history_raw, history = open_publisher(publisher)
    try:
        line, key = conf["public"], conf["key"]
        tip = publisher_tip(dfd, line, app_id, history)
        if tip is None:
            raise Bad("that publisher workspace has no release for " + app_id)
        revoked = list(tip["release"]["revoked"])
        if any(row["version"] == version for row in revoked):
            raise Bad(app_id + " " + version + " is withdrawn already")
        revoked.append({"version": version, "reason": reason})
        updated = max(int(time.time()), tip["release"]["updated"] + 1)
        entry = dict(tip["entry"], sha256=hashlib.sha256(tip["package"]).hexdigest(), size=len(tip["package"]))
        manifest = {"api": entry["api"]}
        release = release_document(entry, manifest, updated, tip["release"]["updates"], revoked)
        name = app_id + "-" + entry["version"] + "-" + str(updated)
        made = finish_release(dfd, name, line, key, release, tip["package"])
        history["apps"][app_id] = publisher_record(name, made)
        warning = replace_publisher_history(dfd, history_raw, history)
    finally:
        os.close(dfd)
    path = os.path.join(folder, name)
    out = {"ok": True, "folder": path, "appFile": os.path.join(path, app_id + "-" + entry["version"] + ".tvapp"),
            "id": app_id, "version": entry["version"], "updated": updated, "revoked": revoked,
            "fingerprint": conf["fingerprint"], "upload": ["release.json", "release.json.sig", "package.tar.gz"]}
    if warning:
        out["warning"] = warning
    return out








def own_pub(key):
    """The public half ssh-keygen left beside the key (<key>.pub), as a line
    like source.pub's; None if it isn't there or isn't one (a link there is
    followed: it's the developer's own, never part of the source's folder)"""
    S = APPFILES()
    try:
        fd = os.open(os.path.abspath(key) + ".pub", os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        with os.fdopen(fd, "rb") as f:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                return None
            raw = f.read(S.MAX_PUB + 1)
        return S.parse_key(b" ".join(raw.split()[:2]))[0] if len(raw) <= S.MAX_PUB else None
    except (OSError, ValueError, S.Problem):
        return None














def clear_own(fd, ours):
    """What's the build's own (ours: inodes) moved to a fresh name, checked
    there, then unlinked from a folder held open (under the build's lock on
    its source folder); anything substituted after its check is put back or
    kept, and anything else stays"""
    for n in os.listdir(from_start(fd)):
        try:
            ino = inode_at(fd, n)
            if ino in ours:
                held, _ = quarantine_own(fd, n, ino, ".clear-")
                if held is not None:
                    try:
                        os.unlink(held, dir_fd=fd)
                    except OSError:
                        restore_quarantine(fd, held, n)
        except OSError:
            pass






def lstat_at(dfd, n):
    try:
        return os.lstat(n, dir_fd=dfd)
    except FileNotFoundError:
        return None


def inode_at(dfd, n):
    """What's at a name in a folder held open, as (device, inode), without
    following a link; None if nothing is. Any other error is raised"""
    st = lstat_at(dfd, n)
    return None if st is None else (st.st_dev, st.st_ino)










def read_at(dfd, name, limit):
    """A plain file in a folder held open (never a link), at most limit"""
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Bad(name + " isn't a plain file")
        data = f.read(limit + 1)
    if len(data) > limit:
        raise Bad(name + " is too big")
    return data


def chmod_at(dfd, name, mode):
    """A file's mode, on the file itself (never through a link)"""
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Bad(name + " isn't a plain file")
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


def sync_at(dfd, name):
    """Persist one plain file in a held folder, never through a link."""
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Bad(name + " isn't a plain file")
        os.fsync(fd)
    finally:
        os.close(fd)


def write_at(dfd, name, data):
    """A new file in a folder held open (it must not be there already)"""
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=dfd)
    with os.fdopen(fd, "wb") as f:
        f.write(data)

def load_lib(name):
    """One of the guide's own modules in lib/, by its path (never from sys.path)"""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib", name + ".py")
    loader = SourceFileLoader(name, path)
    spec = importlib.util.spec_from_file_location(name, path, loader=loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def do_server(raw):
    """A server address as the helper will use it (lib/appnet.py's rules):
    scheme, host, port and path prefix, or why it isn't one"""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib", "appnet.py")
    loader = SourceFileLoader("appnet", path)
    spec = importlib.util.spec_from_file_location("appnet", path, loader=loader)
    net = importlib.util.module_from_spec(spec)
    loader.exec_module(net)
    try:
        return {"ok": True, "server": str(net.normalize_base(raw))}
    except net.NetError as e:
        raise Bad(str(e))


def do_pack(folder, out_path):
    data, entry, manifest = pack_bytes(folder)
    with open(out_path, "wb") as f:
        f.write(data)
    return {"ok": True, "package": os.path.abspath(out_path), "manifest": manifest, "catalogEntry": entry}


def pack_bytes(folder):
    """An app folder checked and packed, the same bytes every time: (package
    bytes, its catalog entry, its checked app.json)"""
    tmp = tempfile.mkdtemp(prefix="pack-")
    try:
        files = copy_folder(os.path.abspath(folder), tmp)
        manifest = check_files(tmp, files)
        data = pack_tree(tmp, files)
    finally:
        remove_tree(tmp)
    entry = {k: manifest[k] for k in ("id", "version", "kind", "name", "author", "description", "color", "permissions")}
    if manifest["kind"] == "app":
        entry.update(api=manifest["api"], permissions=listed_asks(manifest["permissions"]))
    entry.update(sha256=hashlib.sha256(data).hexdigest(), size=len(data))
    return data, entry, manifest


def pack_tree(folder, files):
    """An app's files (copied into folder and checked) as its package, the
    same bytes every time, held to what a guide installs: every member
    counted, folders too, as unpack counts them, each path one a package's
    header holds, and no bigger than a guide downloads"""
    names = sorted(files)
    dirs = sorted({"/".join(n.split("/")[:i]) for n in names for i in range(1, len(n.split("/")))})
    if len(dirs) + len(names) > MAX_MEMBERS:
        raise Bad("it has more than " + str(MAX_MEMBERS) + " files and folders (each folder counts), so a guide won't install it: put its files in fewer folders")
    for n in dirs + names:
        try:
            tarfile.TarInfo(n).tobuf(tarfile.USTAR_FORMAT)
        except ValueError:
            raise Bad(n[:80] + ": its path is too long for a package (at most 100 characters, or 155 for its folders and 100 for its name): shorten it")
    buf = io.BytesIO()
    with gzip.GzipFile(filename="", mode="wb", fileobj=buf, mtime=0, compresslevel=9) as gz:
        with tarfile.open(fileobj=gz, mode="w", format=tarfile.USTAR_FORMAT) as tf:
            for d in dirs:
                info = tarfile.TarInfo(d)
                info.type, info.mode, info.mtime = tarfile.DIRTYPE, 0o755, 0
                tf.addfile(info)
            for n in names:
                info = tarfile.TarInfo(n)
                info.size, info.mode, info.mtime = os.path.getsize(os.path.join(folder, n)), 0o644, 0
                with open(os.path.join(folder, n), "rb") as f:
                    tf.addfile(info, f)
    data = buf.getvalue()
    if len(data) > MAX_PACKAGE:
        raise Bad("its package is bigger than a guide downloads (20 MB): make the app smaller")
    return data


def listed_asks(p):
    """An app's checked permissions (check_app_asks's) as its app.json
    would say them, which is how its list's entry says them: what it
    doesn't ask for left out (an api 2 or 3 app can't even name netWrite)
    and two ways to sign in a list, so a guide's check reads them back to
    just these"""
    out = {}
    if p["net"]:
        out["net"] = list(p["net"])
    if p["netWrite"]:
        out["netWrite"] = {h: list(m) for h, m in p["netWrite"].items()}
    if p["server"] is not None:
        out["server"] = dict(p["server"])
    for flag in ("play", "storage"):
        if p[flag]:
            out[flag] = True
    if p["signIn"]:
        ways = p["signIn"].split("+")
        out["signIn"] = ways if len(ways) > 1 else ways[0]
    return out


SAVER_MAX = 500                    # pictures, Omarchy's and your folder's together
SAVER_HEAD = 256 * 1024            # read for a picture's header (a JPEG's size can be further in)
SAVER_HEAD_MORE = 1024 * 1024
SAVER_EXT = (".png", ".jpg", ".jpeg", ".webp")
SAVER_LOGO = "omarchy.png"         # Omarchy's logo wallpaper, in every theme: not for a slideshow


def saver_picture(path):
    """Whether a file can be one of the screen saver's pictures, checked
    through the open file, never through a link: a plain file, at most 40 MB,
    PNG, JPEG or WebP by its first bytes, at most 8192 pixels a side and
    40 MP (as a picture you pick for Home). The checked file's identity
    ("device:inode", which saver-take holds it to), or "" if it can't be"""
    try:
        fd = _fs.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return ""
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or not 0 < st.st_size <= MAX_PICTURE:
            return ""
        head = f.read(SAVER_HEAD)
        info = image_info(head)
        if not info and head.startswith(b"\xff\xd8\xff") and st.st_size > len(head):
            info = image_info(head + f.read(SAVER_HEAD_MORE - len(head)))
    if not info:
        return ""
    w, h = info[1], info[2]
    if not (0 < w <= MAX_PICTURE_SIDE and 0 < h <= MAX_PICTURE_SIDE and w * h <= MAX_PICTURE_PIXELS):
        return ""
    return "%d:%d" % (st.st_dev, st.st_ino)


def saver_walk(folder, depth, room, found, counts, leave_out=()):
    """The pictures in a folder and the folders in it, depth levels down,
    A to Z; links (to files or folders), hidden names and the names in
    leave_out are left out, and no more than room are taken. Each found is
    noted with its identity in counts["ids"]"""
    try:
        entries = sorted(os.scandir(folder), key=lambda e: e.name)
    except OSError:
        return
    for e in entries:
        if len(found) >= room:
            counts["more"] = True
            return
        if e.name.startswith(".") or e.name in leave_out:
            continue
        try:
            if e.is_symlink():
                continue
            if e.is_dir(follow_symlinks=False):
                if depth > 0:
                    saver_walk(e.path, depth - 1, room, found, counts, leave_out)
                continue
        except OSError:
            continue
        if not e.name.lower().endswith(SAVER_EXT):
            continue
        ident = saver_picture(e.path)
        if ident:
            found.append(e.path)
            counts["ids"][e.path] = ident
        else:
            counts["skipped"] += 1


def do_saver_pictures(raw):
    """The screen saver's pictures: {omarchy: true} for Omarchy's backgrounds
    (its themes' backgrounds folders, your own themes', and backgrounds you've
    added; not the logo wallpaper every theme has), {folder: "/full/path"} for your folder and the folders in it, two
    levels down. Each is checked (saver_picture); at most SAVER_MAX in all.
    {ok, omarchy: [...], folder: [...], folderMissing, skipped, more}"""
    try:
        req = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Bad("not a request")
    if not isinstance(req, dict):
        raise Bad("not a request")
    folder = req.get("folder") or ""
    if not isinstance(folder, str) or (folder and (not folder.startswith("/") or "\0" in folder or len(folder) > 4096)):
        raise Bad("a folder is given by its full path")
    counts = {"skipped": 0, "more": False, "ids": {}}
    mine, theirs = [], []
    missing = False
    root = ""
    if folder:
        if os.path.isdir(folder):
            root = os.path.realpath(folder)
            saver_walk(root, 2, SAVER_MAX, mine, counts)
        else:
            missing = True
    if req.get("omarchy") is True:
        home = os.path.expanduser("~")
        omarchy = os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"
        if not omarchy.startswith("/"):
            omarchy = "/usr/share/omarchy"
        places = []
        for themes in (os.path.join(omarchy, "themes"), os.path.join(home, ".config/omarchy/themes")):
            try:
                places += [os.path.join(themes, t, "backgrounds") for t in sorted(os.listdir(themes))]
            except OSError:
                pass
        try:
            added = os.path.join(home, ".config/omarchy/backgrounds")
            places += [os.path.join(added, t) for t in sorted(os.listdir(added))]
        except OSError:
            pass
        for place in places:
            if os.path.isdir(place) and not os.path.islink(place):
                saver_walk(place, 0, SAVER_MAX - len(mine), theirs, counts, (SAVER_LOGO,))
    return {"ok": True, "omarchy": theirs, "folder": mine, "folderRoot": root, "folderMissing": missing,
            "ids": counts["ids"], "skipped": counts["skipped"], "more": counts["more"]}


SAVER_COPY = re.compile(r"^[0-9a-f]{32}\.(?:png|jpg|webp)\Z")
SAVER_KEEP = 12                    # copies kept: a few screens' current and next pictures


def open_below(root, rel):
    """rel, a path inside the folder root, opened through it without following
    a link anywhere below it (each folder on the way, and the file): a read
    descriptor, or OSError"""
    parts = rel.split("/")
    if not parts or any(p in ("", ".", "..") for p in parts):
        raise OSError("not inside the folder")
    fd = _fs.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for p in parts[:-1]:
            nfd = _fs.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
        return _fs.open(parts[-1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
    finally:
        os.close(fd)


def saver_prune(into, keep, spare=""):
    """The guide's copies in its screen saver cache past the newest keep go
    (only its own names, plain files; spare is never taken)"""
    try:
        names = [n for n in os.listdir(into) if SAVER_COPY.match(n) and n != spare]
    except OSError:
        return
    found = []
    for n in names:
        try:
            st = os.lstat(os.path.join(into, n))
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode):
            found.append((st.st_mtime, n))
    found.sort(reverse=True)
    for _, n in found[keep:]:
        with contextlib.suppress(OSError):
            os.unlink(os.path.join(into, n))


def do_saver_take(raw):
    """One of the screen saver's pictures, ready to show: {root, from, into}
    (from: its path inside the folder root it was listed from; into: the
    guide's screen saver cache). Opened through root without following a link
    (open_below), checked through that descriptor as saver-pictures checks
    (a plain file, at most 40 MB, PNG, JPEG or WebP by its first bytes, at most
    8192 a side and 40 MP), held to the identity it was listed with (id:
    "device:inode", so any swap after the listing, of the file, its folder or a
    folder above, opens another file and is refused), and copied from it into
    the cache as <32 hex>.<ext>, 0600: QML shows only the copy. The cache keeps
    the newest few. {clear: true, into} takes every copy away. {ok, path}"""
    try:
        req = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Bad("not a request")
    if not isinstance(req, dict):
        raise Bad("not a request")
    into = req.get("into")
    if not isinstance(into, str) or not into.startswith("/") or os.path.basename(into) != "saver" or "\0" in into:
        raise Bad("not the guide's screen saver cache")
    if req.get("clear") is True:
        if plain_dir(into):
            saver_prune(into, 0)
        return {"ok": True}
    root, rel = req.get("root"), req.get("from")
    if not isinstance(root, str) or not root.startswith("/") or "\0" in root or len(root) > 4096:
        raise Bad("a folder is given by its full path")
    if not isinstance(rel, str) or not rel or rel.startswith("/") or "\0" in rel or len(rel) > 4096:
        raise Bad("a picture is given by its path inside its folder")
    ident = req.get("id")
    if not isinstance(ident, str) or not re.match(r"^[0-9]{1,20}:[0-9]{1,20}\Z", ident):
        raise Bad("a picture is given with the identity it was listed with")
    try:
        fd = open_below(root, rel)
    except OSError:
        raise Bad("that picture isn't there any more, or isn't a plain file")
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if "%d:%d" % (st.st_dev, st.st_ino) != ident:
            raise Bad("that picture changed since it was listed")
        if not stat.S_ISREG(st.st_mode) or not 0 < st.st_size <= MAX_PICTURE:
            raise Bad("that picture isn't a plain file of at most 40 MB")
        data = f.read(MAX_PICTURE + 1)
    if len(data) > MAX_PICTURE:
        raise Bad("that picture is bigger than 40 MB")
    info = image_info(data)
    if not info:
        raise Bad("that isn't a PNG, JPEG or WebP")
    kind, w, h = info
    if not (0 < w <= MAX_PICTURE_SIDE and 0 < h <= MAX_PICTURE_SIDE) or w * h > MAX_PICTURE_PIXELS:
        raise Bad("that picture is bigger than 8192 pixels a side or 40 megapixels")
    try:
        _fs.makedirs(into, mode=0o700, exist_ok=True)
        if not plain_dir(into):
            raise Bad("the cache isn't a folder")
        name = secrets.token_hex(16) + "." + PICTURE_EXT[kind]
        write_new(into, name, data)
    except OSError:
        raise Bad("it couldn't be copied")
    saver_prune(into, SAVER_KEEP - 1, spare=name)   # with the new one, SAVER_KEEP
    return {"ok": True, "path": os.path.join(into, name)}


def do_saver_folder(raw):
    """Your screen saver folder, made if it isn't there (and its folders up to
    it, only inside your home folder); refused if something else has its
    name. {ok, folder}"""
    try:
        req = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Bad("not a request")
    folder = req.get("folder") if isinstance(req, dict) else None
    if not isinstance(folder, str) or not folder.startswith("/") or "\0" in folder or len(folder) > 4096:
        raise Bad("a folder is given by its full path")
    folder = os.path.normpath(folder)
    home = os.path.realpath(os.path.expanduser("~"))
    if os.path.isdir(folder):
        return {"ok": True, "folder": folder}
    if os.path.lexists(folder):
        raise Bad("something that isn't a folder has that name")
    if not os.path.realpath(os.path.dirname(folder)).startswith(home + "/") and os.path.realpath(os.path.dirname(folder)) != home:
        raise Bad("a new folder is made only inside your home folder")
    try:
        _fs.makedirs(folder, mode=0o755, exist_ok=True)
    except OSError:
        raise Bad("the folder couldn't be made")
    return {"ok": True, "folder": folder}



# ---- the channel lock -----------------------------------

LOCK_SCRYPT = {"n": 2 ** 14, "r": 8, "p": 1}   # deliberately slow: about 50 ms and 16 MB a try
LOCK_KEY = 32
LOCK_MISSES = 5            # wrong passcodes in a row before a wait
LOCK_WAIT = 60             # the first wait, in seconds, doubled for each miss after
LOCK_WAIT_MAX = 3600
LOCK_CHANNELS = 5000
LOCK_UNLOCK = ("tv", 60, 240)   # an unlock lasts until the TV is off, or minutes
PASSCODE = re.compile(r"^[0-9]{4,8}\Z")


def lock_file(path):
    """The lock file, by its full path: lock.json"""
    if not isinstance(path, str) or not path.startswith("/") or os.path.basename(path) != "lock.json" or "\0" in path:
        raise Bad("not the guide's lock file")
    return path


@contextlib.contextmanager
def lock_folder(path):
    """The lock file's folder held while it's read, changed and written, so
    two changes never cross"""
    folder = os.path.dirname(path)
    _fs.makedirs(folder, mode=0o700, exist_ok=True)
    fd = _fs.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def lock_entries(v):
    """Locked channels as given: [{url, name}], each checked, one per address,
    at most LOCK_CHANNELS"""
    out, seen = [], set()
    for e in v if isinstance(v, list) else []:
        if not isinstance(e, dict):
            continue
        url, name = e.get("url"), e.get("name")
        if not isinstance(url, str) or not url or len(url) > 4096 or "\0" in url or url in seen:
            continue
        name = name[:200] if isinstance(name, str) and "\0" not in name else ""
        seen.add(url)
        out.append({"url": url, "name": name})
        if len(out) >= LOCK_CHANNELS:
            break
    return out


def lock_load(path):
    """The lock as kept (or as it begins: no passcode, off, nothing locked);
    a hash that isn't a sound one counts as none, so it can't be used to
    make the check run forever"""
    res = do_private_read(path)
    if not res.get("ok"):
        raise Bad("the lock file couldn't be read: " + res.get("error", ""))
    try:
        d = json.loads(res.get("text") or "{}")
    except ValueError:
        raise Bad("the lock file isn't readable")
    if not isinstance(d, dict):
        d = {}
    h = d.get("hash")
    good = (isinstance(h, dict) and isinstance(h.get("salt"), str) and isinstance(h.get("key"), str)
            and h.get("n") == LOCK_SCRYPT["n"] and h.get("r") == LOCK_SCRYPT["r"] and h.get("p") == LOCK_SCRYPT["p"]
            and re.match(r"^[0-9a-f]{32}\Z", h["salt"]) and re.match(r"^[0-9a-f]{64}\Z", h["key"]))
    misses = d.get("misses")
    wait = d.get("waitUntil")
    return {"v": 1, "hash": h if good else None,
            "misses": misses if isinstance(misses, int) and 0 <= misses < 10 ** 6 else 0,
            "waitUntil": wait if isinstance(wait, (int, float)) and wait > 0 else 0,
            "on": d.get("on") is True, "channels": lock_entries(d.get("channels")),
            "unlockFor": d.get("unlockFor") if d.get("unlockFor") in LOCK_UNLOCK else "tv",
            "titles": d.get("titles") is True}


def lock_store(path, d):
    res = do_private_write(path, json.dumps(d, indent=1).encode())
    if not res.get("ok"):
        raise Bad("the lock file couldn't be written")


def lock_hash(code):
    salt = secrets.token_bytes(16)
    key = hashlib.scrypt(code.encode(), salt=salt, n=LOCK_SCRYPT["n"], r=LOCK_SCRYPT["r"], p=LOCK_SCRYPT["p"], dklen=LOCK_KEY)
    return dict(LOCK_SCRYPT, salt=salt.hex(), key=key.hex())


def lock_public(d):
    """What the guide may know: everything but the hash"""
    return {"ok": True, "set": d["hash"] is not None, "on": d["on"], "channels": d["channels"], "unlockFor": d["unlockFor"],
            "titles": d["titles"], "wait": max(0, int(d["waitUntil"] - time.time() + 0.999))}


def lock_try(d, code):
    """A passcode tried: while a wait runs, refused without being checked;
    right, the misses start over; wrong, one more miss, and from the fifth
    in a row a wait (a minute, doubled for each miss after, at most an
    hour). True, or False"""
    now = time.time()
    if d["waitUntil"] > now:
        return False
    h = d["hash"]
    key = hashlib.scrypt(code.encode(), salt=bytes.fromhex(h["salt"]), n=h["n"], r=h["r"], p=h["p"], dklen=LOCK_KEY)
    if hmac.compare_digest(key.hex(), h["key"]):
        d["misses"], d["waitUntil"] = 0, 0
        return True
    d["misses"] += 1
    if d["misses"] >= LOCK_MISSES:
        d["waitUntil"] = now + min(LOCK_WAIT_MAX, LOCK_WAIT * 2 ** min(20, d["misses"] - LOCK_MISSES))
    return False


def lock_refused(d):
    wait = max(0, int(d["waitUntil"] - time.time() + 0.999))
    return {"ok": False, "wrong": True, "wait": wait,
            "error": "too many wrong tries: wait %d s" % wait if wait else "that's not the passcode"}


def do_lock(cmd, raw):
    """The channel lock: lock-read {file} (what the guide may know);
    lock-check {file, code}; lock-passcode {file, code, old} (old needed once
    there's a passcode); lock-save {file, on, channels, unlockFor, titles};
    lock-reset {file} (no passcode, nothing locked, written fresh even over a
    file that can't be read; the guide asks for the computer's password
    first)"""
    try:
        req = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise Bad("not a request")
    if not isinstance(req, dict):
        raise Bad("not a request")
    path = lock_file(req.get("file"))
    for k in ("code", "old"):
        if k in req and (not isinstance(req[k], str) or not PASSCODE.match(req[k])):
            raise Bad("a passcode is 4 to 8 digits")
    with lock_folder(path):
        if cmd == "lock-reset":
            # written fresh, never read first: it's also the way back from a
            # file that can't be read
            d = {"v": 1, "hash": None, "misses": 0, "waitUntil": 0, "on": False, "channels": [], "unlockFor": "tv", "titles": False}
            lock_store(path, d)
            return lock_public(d)
        d = lock_load(path)
        if cmd == "lock-read":
            return lock_public(d)
        if cmd == "lock-check":
            if d["hash"] is None:
                raise Bad("there's no passcode yet")
            if "code" not in req:
                raise Bad("a passcode is 4 to 8 digits")
            right = lock_try(d, req["code"])
            lock_store(path, d)
            return {"ok": True} if right else lock_refused(d)
        if cmd == "lock-passcode":
            if "code" not in req:
                raise Bad("a passcode is 4 to 8 digits")
            if d["hash"] is not None:
                if "old" not in req:
                    raise Bad("the passcode now is needed to change it")
                right = lock_try(d, req["old"])
                if not right:
                    lock_store(path, d)
                    return lock_refused(d)
            d["hash"], d["misses"], d["waitUntil"] = lock_hash(req["code"]), 0, 0
            lock_store(path, d)
            return lock_public(d)
        if cmd == "lock-save":
            for k in ("on", "titles"):
                if k in req:
                    if not isinstance(req[k], bool):
                        raise Bad(k + " is true or false")
                    d[k] = req[k]
            if "unlockFor" in req:
                if req["unlockFor"] not in LOCK_UNLOCK:
                    raise Bad("an unlock lasts tv, 60 or 240")
                d["unlockFor"] = req["unlockFor"]
            if "channels" in req:
                if not isinstance(req["channels"], list):
                    raise Bad("channels are a list")
                d["channels"] = lock_entries(req["channels"])
            if d["on"] and d["hash"] is None:
                raise Bad("set a passcode first")
            lock_store(path, d)
            return lock_public(d)
    raise Bad("not a lock command")


def main(argv):
    usage = "om-pg-apps catalog|inspect|app-inspect|app-update-check|app-update-prepare|app-current|app-key|app-file|app-revoke|install|discard|remove|verify|bundled|migrate|check|try|secret-set|secret-clear|forget|activity|private-read|private-write|theme-save|theme-tidy|theme-sweep|theme-remove|picture-import|picture-prune|saver-pictures|saver-take|saver-folder|lock-read|lock-check|lock-passcode|lock-save|lock-reset|pack ... (see the top of this file)"
    if len(argv) < 2:
        raise Bad(usage)
    cmd, args = argv[1], argv[2:]
    if cmd == "try":
        runner = os.path.join(os.path.dirname(os.path.realpath(__file__)), "om-pg-apprun")
        os.execv("/usr/bin/python3", ["/usr/bin/python3", "-I", runner, "try"] + args)
    want = {"catalog": 4, "inspect": 2, "app-inspect": 3, "app-update-check": 3, "app-update-prepare": 4,
            "app-current": 3, "app-key": 1, "app-revoke": 4, "install": 5, "discard": 2, "remove": 3, "verify": 3, "pack": 2,
            "bundled": 1, "migrate": 3, "check": 1, "secret-set": 2, "secret-clear": 2, "server": 1, "cert": 1, "forget": 4, "activity": 3,
            "private-read": 1, "private-write": 1, "theme-save": 0, "theme-tidy": 0, "theme-sweep": 0, "theme-remove": 0,
            "picture-import": 0, "picture-prune": 0, "saver-pictures": 0, "saver-take": 0, "saver-folder": 0,
            "lock-read": 0, "lock-check": 0, "lock-passcode": 0, "lock-save": 0, "lock-reset": 0}
    if (want.get(cmd) != len(args) and not (cmd == "secret-clear" and 2 <= len(args) <= 33) and not (cmd == "verify" and len(args) == 4)
            and not (cmd == "install" and len(args) == 6) and not (cmd == "app-file" and len(args) in (2, 3))):
        raise Bad(usage)
    if cmd == "catalog":
        try:
            seen = int(float(args[2] or 0))
        except ValueError:
            seen = 0
        return do_catalog(args[0], args[1], seen, args[3])
    if cmd == "inspect":
        return do_inspect(json.loads(args[0]), args[1])
    if cmd == "app-inspect":
        return do_app_inspect(*args)
    if cmd == "app-update-check":
        return do_app_update_check(*args)
    if cmd == "app-update-prepare":
        raw = sys.stdin.buffer.read(64 * 1024 + 1)
        return do_app_update_prepare(raw, *args)
    if cmd == "app-current":
        return do_app_current(*args)
    if cmd == "app-key":
        return do_app_key(args[0])
    if cmd == "app-file":
        return do_app_file(args[0], args[1], args[2] if len(args) == 3 else None)
    if cmd == "app-revoke":
        return do_app_revoke(*args)
    if cmd == "install":
        return do_install(*args)
    if cmd == "discard":
        return do_discard(*args)
    if cmd == "remove":
        return do_remove(args[0], args[1], json.loads(args[2]))
    if cmd == "verify":
        return do_verify(*args)
    if cmd == "bundled":
        return do_bundled(args[0])
    if cmd == "migrate":
        return do_migrate(args[0], args[1], json.loads(args[2]))
    if cmd == "check":
        return do_check(args[0])
    if cmd == "secret-set":
        # what it is and where it goes, checked before anything is read
        secrets_file(args[0])
        if not re.match(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}\Z", args[1]):
            raise Bad("not a secret's name")
        return do_secret_set(args[0], args[1], sys.stdin.read(8192).rstrip("\n"))
    if cmd == "secret-clear":
        return do_secret_clear(*args)
    if cmd == "server":
        return do_server(args[0])
    if cmd == "cert":
        return do_cert(args[0])
    if cmd == "forget":
        return do_forget(args[0], args[1], args[2], json.loads(args[3]))
    if cmd == "activity":
        return do_activity(args[0], args[1], json.loads(args[2]))
    if cmd == "private-read":
        return do_private_read(args[0])
    if cmd in ("lock-read", "lock-check", "lock-passcode", "lock-save", "lock-reset"):
        raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
        if len(raw) > MAX_REQUEST:
            raise Bad("that's too big")
        return do_lock(cmd, raw)
    if cmd in ("theme-save", "theme-tidy", "theme-sweep", "theme-remove", "picture-import", "picture-prune", "saver-pictures", "saver-take", "saver-folder"):
        # the request on stdin (JSON, bounded)
        raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
        if len(raw) > MAX_REQUEST:
            raise Bad("that's too big")
        return {"theme-save": do_theme_save, "theme-tidy": do_theme_tidy, "theme-sweep": do_theme_sweep,
                "theme-remove": do_theme_remove, "picture-import": do_picture_import, "picture-prune": do_picture_prune,
                "saver-pictures": do_saver_pictures, "saver-take": do_saver_take, "saver-folder": do_saver_folder}[cmd](raw)
    if cmd == "private-write":
        # the file's text on stdin: no more than its cap is read
        limit = private_limit(args[0])
        return do_private_write(args[0], sys.stdin.buffer.read(limit + 1))
    return do_pack(*args)


if __name__ == "__main__":
    os.umask(0o077)
    try:
        say(main(sys.argv))
    except Bad as e:
        say(failure(e))
        sys.exit(1)
    except Exception as e:   # whatever it is, one JSON line saying so
        say({"ok": False, "error": "something went wrong: " + str(e)[:160]})
        sys.exit(1)
